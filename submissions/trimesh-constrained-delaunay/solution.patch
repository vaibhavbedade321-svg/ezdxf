@@ -0,0 +1,713 @@
+"""
+triangulation.py
+-----------------
+
+A constrained Delaunay triangulation of polygons with holes, with
+optional quality refinement, which needs nothing outside of the
+required dependencies.
+"""
+
+import math
+from collections import deque
+from fractions import Fraction
+
+import numpy as np
+
+from .typed import NDArray, Number, Sequence, float64, int64
+
+# how much larger than the input the enclosing triangle is made
+_SCALE = 1000.0
+
+# refuse minimum angles which are not known to terminate
+_MAX_ANGLE = 30.0
+
+# give up rather than refine forever, per vertex of the input
+_MAX_ADDED = 500
+
+# a float result further from zero than this many times the size of the
+# terms which made it cannot have the wrong sign, so it can be trusted
+# without falling back to exact arithmetic
+_ORIENT_FILTER = 4.0 * 2.0**-52
+_CIRCLE_FILTER = 16.0 * 2.0**-52
+
+# smallest positive double, used to carry the sign of an exact result
+# which is too small to survive being turned back into a float
+_TINY = 5e-324
+
+
+def _signed(exact) -> float:
+    """
+    Turn an exact result into a float which has the same sign, even
+    when the magnitude is far below what a float can hold.
+    """
+    value = float(exact)
+    if value == 0.0 and exact != 0:
+        return math.copysign(_TINY, float(exact.numerator))
+    return value
+
+
+def _orient(a, b, c) -> float:
+    """
+    Twice the signed area of the triangle `a, b, c`, positive when the
+    three points are wound counter-clockwise. The sign is always right,
+    however close to collinear the points are.
+    """
+    left = (b[0] - a[0]) * (c[1] - a[1])
+    right = (b[1] - a[1]) * (c[0] - a[0])
+    determinant = left - right
+    if abs(determinant) > _ORIENT_FILTER * (abs(left) + abs(right)):
+        return determinant
+    ax, ay = Fraction(a[0]), Fraction(a[1])
+    bx, by = Fraction(b[0]), Fraction(b[1])
+    cx, cy = Fraction(c[0]), Fraction(c[1])
+    return _signed((bx - ax) * (cy - ay) - (by - ay) * (cx - ax))
+
+
+def _in_circle(a, b, c, d) -> float:
+    """
+    Positive when `d` lies inside the circumcircle of the counter-clockwise
+    wound triangle `a, b, c`. The sign is always right, however close to
+    cocircular the four points are.
+    """
+    adx, ady = a[0] - d[0], a[1] - d[1]
+    bdx, bdy = b[0] - d[0], b[1] - d[1]
+    cdx, cdy = c[0] - d[0], c[1] - d[1]
+    bc = bdx * cdy - cdx * bdy
+    ca = cdx * ady - adx * cdy
+    ab = adx * bdy - bdx * ady
+    alift = adx * adx + ady * ady
+    blift = bdx * bdx + bdy * bdy
+    clift = cdx * cdx + cdy * cdy
+    determinant = alift * bc + blift * ca + clift * ab
+    size = (
+        abs(alift) * abs(bc) + abs(blift) * abs(ca) + abs(clift) * abs(ab)
+    )
+    if abs(determinant) > _CIRCLE_FILTER * size:
+        return determinant
+
+    ax, ay = Fraction(a[0]) - Fraction(d[0]), Fraction(a[1]) - Fraction(d[1])
+    bx, by = Fraction(b[0]) - Fraction(d[0]), Fraction(b[1]) - Fraction(d[1])
+    cx, cy = Fraction(c[0]) - Fraction(d[0]), Fraction(c[1]) - Fraction(d[1])
+    return _signed(
+        (ax * ax + ay * ay) * (bx * cy - cx * by)
+        + (bx * bx + by * by) * (cx * ay - ax * cy)
+        + (cx * cx + cy * cy) * (ax * by - bx * ay)
+    )
+
+
+def _circumcenter(a, b, c):
+    """
+    The center of the circle through all three points, or None
+    when they are collinear.
+    """
+    bx, by = b[0] - a[0], b[1] - a[1]
+    cx, cy = c[0] - a[0], c[1] - a[1]
+    d = 2.0 * (bx * cy - by * cx)
+    if d == 0.0:
+        return None
+    bs = bx * bx + by * by
+    cs = cx * cx + cy * cy
+    return (a[0] + (cy * bs - by * cs) / d, a[1] + (bx * cs - cx * bs) / d)
+
+
+def _edge(a: int, b: int) -> tuple:
+    """An edge key which doesn't care about direction."""
+    return (a, b) if a < b else (b, a)
+
+
+class _Mesh:
+    """
+    A triangle mesh stored as a map of directed edges, i.e. the
+    triangle on the other side of the edge `(a, b)` is the triangle
+    which holds the directed edge `(b, a)`.
+    """
+
+    def __init__(self, points: list):
+        self.points = points
+        # index of triangle to counter-clockwise wound vertices
+        self.triangles = {}
+        # directed edge to the index of the triangle holding it
+        self.edges = {}
+        # index of triangle to whether it is inside the polygon
+        self.inside = {}
+        # vertices of the enclosing triangle
+        self.outer = set()
+        self._next = 0
+        self._hint = None
+
+    def add(self, a: int, b: int, c: int, inside: bool = False) -> int:
+        index = self._next
+        self._next += 1
+        self.triangles[index] = (a, b, c)
+        self.inside[index] = inside
+        self.edges[(a, b)] = index
+        self.edges[(b, c)] = index
+        self.edges[(c, a)] = index
+        self._hint = index
+        return index
+
+    def pop(self, index: int) -> None:
+        a, b, c = self.triangles.pop(index)
+        del self.inside[index]
+        del self.edges[(a, b)]
+        del self.edges[(b, c)]
+        del self.edges[(c, a)]
+
+    def orient(self, a: int, b: int, c: int) -> float:
+        return _orient(self.points[a], self.points[b], self.points[c])
+
+    def in_circle(self, a: int, b: int, c: int, d: int) -> float:
+        return _in_circle(
+            self.points[a], self.points[b], self.points[c], self.points[d]
+        )
+
+    def apex(self, a: int, b: int):
+        """
+        The vertex facing the directed edge `(a, b)`, or None when
+        the edge is on the outside of the mesh.
+        """
+        index = self.edges.get((a, b))
+        if index is None:
+            return None
+        triangle = self.triangles[index]
+        return triangle[(triangle.index(a) + 2) % 3]
+
+    def between(self, a: int, b: int, c: int) -> bool:
+        """
+        Check if vertex `c` lies on the inside of the segment `a, b`.
+        """
+        if self.orient(a, b, c) != 0.0:
+            return False
+        pa, pb, pc = self.points[a], self.points[b], self.points[c]
+        dx, dy = pb[0] - pa[0], pb[1] - pa[1]
+        along = (pc[0] - pa[0]) * dx + (pc[1] - pa[1]) * dy
+        return 0.0 < along < (dx * dx + dy * dy)
+
+    def crossing(self, a: int, b: int, c: int, d: int) -> bool:
+        """
+        Check if the segments `a, b` and `c, d` cross each other
+        somewhere other than at their end points.
+        """
+        if len({a, b, c, d}) != 4:
+            return False
+        # compared as signs rather than products, which would flush to
+        # zero when the exact predicates return very small magnitudes
+        first = math.copysign(1.0, self.orient(a, b, c)) != math.copysign(
+            1.0, self.orient(a, b, d)
+        )
+        second = math.copysign(1.0, self.orient(c, d, a)) != math.copysign(
+            1.0, self.orient(c, d, b)
+        )
+        return first and second
+
+    def locate(self, point):
+        """
+        Index of a triangle containing the passed point, found by
+        stepping from triangle to triangle towards it.
+        """
+        if len(self.triangles) == 0:
+            return None
+        if self._hint in self.triangles:
+            index = self._hint
+        else:
+            index = next(iter(self.triangles))
+        for _ in range(len(self.triangles) + 3):
+            step = None
+            a, b, c = self.triangles[index]
+            for u, v in ((a, b), (b, c), (c, a)):
+                if _orient(self.points[u], self.points[v], point) < 0.0:
+                    across = self.edges.get((v, u))
+                    if across is not None:
+                        step = across
+                        break
+            if step is None:
+                self._hint = index
+                return index
+            index = step
+        # walking can cycle on degenerate input so fall back to a scan
+        for index, (a, b, c) in self.triangles.items():
+            if (
+                _orient(self.points[a], self.points[b], point) >= 0.0
+                and _orient(self.points[b], self.points[c], point) >= 0.0
+                and _orient(self.points[c], self.points[a], point) >= 0.0
+            ):
+                return index
+        return None
+
+    def border(self, cavity: set) -> list:
+        """
+        The directed edges enclosing a set of triangles, each with the
+        inside flag of the triangle it came from. Splitting a boundary
+        segment gives a cavity which spans both sides of it, so the
+        flag has to be carried per edge rather than for the whole hole.
+        """
+        border = []
+        for index in cavity:
+            a, b, c = self.triangles[index]
+            for u, v in ((a, b), (b, c), (c, a)):
+                if self.edges.get((v, u)) not in cavity:
+                    border.append((u, v, self.inside[index]))
+        return border
+
+    def insert(self, vertex: int, fixed: frozenset = frozenset()) -> None:
+        """
+        Add a vertex using the Bowyer-Watson approach: drop every
+        triangle whose circumcircle holds the vertex and fill the hole
+        that leaves behind. Fixed edges are never crossed, which keeps
+        the cavity on one side of the polygon boundary.
+        """
+        seed = self.locate(self.points[vertex])
+        if seed is None:
+            return
+        cavity = {seed}
+        queue = [seed]
+        while queue:
+            a, b, c = self.triangles[queue.pop()]
+            for u, v in ((a, b), (b, c), (c, a)):
+                index = self.edges.get((v, u))
+                if index is None or index in cavity or _edge(u, v) in fixed:
+                    continue
+                x, y, z = self.triangles[index]
+                if self.in_circle(x, y, z, vertex) > 0.0:
+                    cavity.add(index)
+                    queue.append(index)
+
+        # a vertex sitting exactly on the edge of the cavity would
+        # otherwise be sealed in with a zero area triangle
+        while True:
+            border = self.border(cavity)
+            grow = {
+                self.edges[(v, u)]
+                for u, v, _ in border
+                if (v, u) in self.edges
+                and _edge(u, v) not in fixed
+                and self.between(u, v, vertex)
+            }
+            grow.difference_update(cavity)
+            if len(grow) == 0:
+                break
+            cavity.update(grow)
+
+        for index in cavity:
+            self.pop(index)
+        for u, v, inside in border:
+            self.add(u, v, vertex, inside)
+
+    def walk(self, start: int, end: int):
+        """
+        The edges crossed by the segment `start, end` and the vertex
+        the walk stopped on, which is `end` unless another vertex sits
+        on the segment.
+        """
+        crossed = []
+        for triangle in self.triangles.values():
+            if start not in triangle:
+                continue
+            offset = triangle.index(start)
+            right = triangle[(offset + 1) % 3]
+            left = triangle[(offset + 2) % 3]
+            if right == end or left == end:
+                return [], end
+            for vertex in (right, left):
+                if self.between(start, end, vertex):
+                    return [], vertex
+            if self.orient(start, end, right) < 0.0 < self.orient(start, end, left):
+                crossed.append((right, left))
+                break
+        if len(crossed) == 0:
+            return [], end
+
+        # step from triangle to triangle towards the end vertex, keeping
+        # the first vertex of every crossed edge on the right hand side
+        while True:
+            right, left = crossed[-1]
+            if (left, right) not in self.edges:
+                break
+            ahead = self.apex(left, right)
+            if ahead == end:
+                break
+            if self.between(start, end, ahead):
+                return crossed, ahead
+            if self.orient(start, end, ahead) < 0.0:
+                crossed.append((ahead, left))
+            else:
+                crossed.append((right, ahead))
+        return crossed, end
+
+    def force(self, start: int, end: int, crossed: list) -> None:
+        """
+        Flip the crossed edges until the segment `start, end` is an
+        edge of the mesh.
+        """
+        queue = deque(crossed)
+        stall = 0
+        while len(queue) > 0 and stall <= len(queue):
+            right, left = queue.popleft()
+            if (right, left) not in self.edges or (left, right) not in self.edges:
+                continue
+            near = self.apex(right, left)
+            far = self.apex(left, right)
+            # only a strictly convex quad can be flipped
+            if (
+                self.orient(near, right, far) <= 0.0
+                or self.orient(near, far, left) <= 0.0
+            ):
+                queue.append((right, left))
+                stall += 1
+                continue
+            stall = 0
+            self.flip(right, left, near, far)
+            if self.crossing(start, end, near, far):
+                if self.orient(start, end, near) < 0.0:
+                    queue.append((near, far))
+                else:
+                    queue.append((far, near))
+
+    def flip(self, a: int, b: int, near: int, far: int) -> None:
+        """
+        Replace the edge `a, b` with the edge `near, far`.
+        """
+        first = self.edges[(a, b)]
+        second = self.edges[(b, a)]
+        inside = self.inside[first]
+        self.pop(first)
+        self.pop(second)
+        self.add(near, a, far, inside)
+        self.add(near, far, b, inside)
+
+    def constrain(self, start: int, end: int) -> None:
+        """
+        Make sure the segment `start, end` is an edge of the mesh.
+        """
+        while start != end:
+            if (start, end) in self.edges or (end, start) in self.edges:
+                return
+            crossed, reached = self.walk(start, end)
+            if len(crossed) == 0 and reached == end:
+                return
+            self.force(start, reached, crossed)
+            start = reached
+
+    def delaunay(self, fixed: set) -> None:
+        """
+        Flip every edge which isn't locally Delaunay, leaving the
+        fixed edges and the enclosing triangle alone.
+        """
+        stack = [_edge(a, b) for a, b in self.edges if a < b]
+        queued = set(stack)
+        while len(stack) > 0:
+            edge = stack.pop()
+            queued.discard(edge)
+            a, b = edge
+            if edge in fixed or (a, b) not in self.edges:
+                continue
+            near = self.apex(a, b)
+            far = self.apex(b, a)
+            if near is None or far is None:
+                continue
+            # vertices of the enclosing triangle are dropped later on
+            if not self.outer.isdisjoint((a, b, near, far)):
+                continue
+            if self.in_circle(a, b, near, far) <= 0.0:
+                continue
+            if (
+                self.orient(near, a, far) <= 0.0
+                or self.orient(near, far, b) <= 0.0
+            ):
+                continue
+            self.flip(a, b, near, far)
+            for u, v in ((a, far), (far, b), (b, near), (near, a)):
+                other = _edge(u, v)
+                if other not in queued:
+                    queued.add(other)
+                    stack.append(other)
+
+    def classify(self, boundary: set) -> None:
+        """
+        Work out which triangles are inside the polygon by walking in
+        from the enclosing triangle, flipping a flag every time a
+        boundary edge is stepped over.
+        """
+        start = [
+            index
+            for index, triangle in self.triangles.items()
+            if not self.outer.isdisjoint(triangle)
+        ]
+        for index in self.triangles:
+            self.inside[index] = False
+        seen = set(start)
+        queue = deque(start)
+        while len(queue) > 0:
+            index = queue.popleft()
+            a, b, c = self.triangles[index]
+            for u, v in ((a, b), (b, c), (c, a)):
+                neighbor = self.edges.get((v, u))
+                if neighbor is None or neighbor in seen:
+                    continue
+                seen.add(neighbor)
+                self.inside[neighbor] = self.inside[index] != (_edge(u, v) in boundary)
+                queue.append(neighbor)
+
+    def faces(self) -> list:
+        """
+        The triangles which are inside the polygon and have real area.
+        """
+        return [
+            triangle
+            for index, triangle in self.triangles.items()
+            if self.inside[index]
+            and self.outer.isdisjoint(triangle)
+            and self.orient(*triangle) > 0.0
+        ]
+
+    def facing(self, segment: tuple) -> set:
+        """
+        The vertices facing a segment, which are the only ones able to
+        encroach on it once the mesh is Delaunay.
+        """
+        found = set()
+        for a, b in (segment, segment[::-1]):
+            vertex = self.apex(a, b)
+            if vertex is not None and vertex not in self.outer:
+                found.add(vertex)
+        return found
+
+    def encroached(self, segment: tuple, point) -> bool:
+        """
+        Check if a point falls inside the circle which has the segment
+        as its diameter.
+        """
+        a = self.points[segment[0]]
+        b = self.points[segment[1]]
+        return (a[0] - point[0]) * (b[0] - point[0]) + (a[1] - point[1]) * (
+            b[1] - point[1]
+        ) < 0.0
+
+    def split(self, segment: tuple, fixed: set) -> None:
+        """
+        Cut a fixed segment in half, replacing it with its two halves
+        so the shape of the boundary is preserved exactly.
+        """
+        a = self.points[segment[0]]
+        b = self.points[segment[1]]
+        middle = len(self.points)
+        self.points.append(((a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0))
+        fixed.discard(segment)
+        fixed.add(_edge(segment[0], middle))
+        fixed.add(_edge(middle, segment[1]))
+        self.insert(middle, frozenset(fixed))
+
+    def poor(self, ratio, max_area):
+        """
+        The triangle inside the polygon which misses the quality
+        target by the most, or None when they all meet it.
+        """
+        worst = None
+        score = 1.0
+        for index, triangle in self.triangles.items():
+            if not self.inside[index] or not self.outer.isdisjoint(triangle):
+                continue
+            a, b, c = (self.points[vertex] for vertex in triangle)
+            area = _orient(a, b, c) / 2.0
+            if area <= 0.0:
+                continue
+            sides = (
+                math.hypot(b[0] - a[0], b[1] - a[1]),
+                math.hypot(c[0] - b[0], c[1] - b[1]),
+                math.hypot(a[0] - c[0], a[1] - c[1]),
+            )
+            current = 0.0
+            if max_area is not None:
+                current = area / max_area
+            if ratio is not None:
+                # circumradius over the shortest side
+                shape = sides[0] * sides[1] * sides[2] / (4.0 * area * min(sides))
+                current = max(current, shape / ratio)
+            if current > score:
+                worst = triangle
+                score = current
+        return worst
+
+    def encroaching(self, fixed: set):
+        """
+        A fixed segment which already has a vertex inside its
+        diametral circle, or None when there is none.
+        """
+        for segment in sorted(fixed):
+            for vertex in self.facing(segment):
+                if self.encroached(segment, self.points[vertex]):
+                    return segment
+        return None
+
+    def refine(self, fixed: set, min_angle, max_area, budget: int) -> None:
+        """
+        Add vertices until every triangle inside the polygon meets the
+        quality targets, splitting boundary segments rather than ever
+        placing a vertex across one.
+        """
+        ratio = None
+        if min_angle is not None:
+            ratio = 1.0 / (2.0 * math.sin(math.radians(min_angle)))
+
+        added = 0
+        while added < budget:
+            # an encroached segment has to be split before anything else
+            segment = self.encroaching(fixed)
+            if segment is not None:
+                self.split(segment, fixed)
+                added += 1
+                continue
+
+            triangle = self.poor(ratio, max_area)
+            if triangle is None:
+                return
+            center = _circumcenter(*(self.points[vertex] for vertex in triangle))
+            if center is None:
+                return
+
+            # a circumcenter which would land outside the polygon always
+            # encroaches a boundary segment, so split those instead
+            blocked = [s for s in sorted(fixed) if self.encroached(s, center)]
+            if len(blocked) > 0:
+                for segment in blocked:
+                    if segment in fixed:
+                        self.split(segment, fixed)
+                        added += 1
+                continue
+
+            seed = self.locate(center)
+            if seed is None or not self.inside[seed]:
+                return
+            self.points.append(center)
+            self.insert(len(self.points) - 1, frozenset(fixed))
+            added += 1
+
+        raise ValueError("refinement did not converge, try a larger quality target")
+
+
+def _rings_to_points(rings: Sequence) -> tuple:
+    """
+    Flatten closed rings into a single list of unique points and the
+    index pairs of every ring segment.
+
+    Parameters
+    ----------
+    rings
+      Sequence of (n, 2) float, the first of which is the exterior.
+
+    Returns
+    -------
+    points
+      List of (x, y) tuples, every ring vertex exactly once.
+    segments
+      Set of index pairs, one per ring segment.
+    """
+    # sorting the points gives them an order which depends on the polygon
+    # and not on where a ring happens to start or which way it is wound,
+    # so the triangulation which follows is the same for either
+    unique = set()
+    for ring in rings:
+        for point in np.asanyarray(ring, dtype=float64).reshape((-1, 2)):
+            unique.add((float(point[0]), float(point[1])))
+    points = sorted(unique)
+    lookup = {key: index for index, key in enumerate(points)}
+    segments = set()
+
+    for ring in rings:
+        ring = np.asanyarray(ring, dtype=float64).reshape((-1, 2))
+        indexes = []
+        for point in ring:
+            index = lookup[(float(point[0]), float(point[1]))]
+            if len(indexes) == 0 or indexes[-1] != index:
+                indexes.append(index)
+        # rings arrive closed so drop the repeated final vertex
+        if len(indexes) > 1 and indexes[0] == indexes[-1]:
+            indexes.pop()
+        if len(indexes) < 3:
+            continue
+        for offset, index in enumerate(indexes):
+            segments.add(_edge(index, indexes[(offset + 1) % len(indexes)]))
+
+    return points, segments
+
+
+def constrained_delaunay(
+    rings: Sequence,
+    min_angle: Number | None = None,
+    max_area: Number | None = None,
+) -> tuple[NDArray[float64], NDArray[int64]]:
+    """
+    Triangulate a polygon with holes.
+
+    Every ring segment is covered by edges of the result and every edge
+    which isn't part of a ring segment is locally Delaunay, which keeps
+    the triangles as well shaped as the vertices allow. Passing a
+    quality target adds vertices until that target is met.
+
+    Parameters
+    ----------
+    rings
+      Sequence of (n, 2) float closed rings, the first of which is the
+      exterior and the rest of which are holes.
+    min_angle
+      If passed, no triangle will have an angle smaller than this many
+      degrees.
+    max_area
+      If passed, no triangle will be larger than this.
+
+    Returns
+    -------
+    vertices
+      (m, 2) float64 points.
+    faces
+      (t, 3) int64 indexes of counter-clockwise wound triangles.
+    """
+    if min_angle is not None and not 0.0 < min_angle <= _MAX_ANGLE:
+        raise ValueError(f"`min_angle` must be between 0 and {_MAX_ANGLE} degrees")
+    if max_area is not None and max_area <= 0.0:
+        raise ValueError("`max_area` must be greater than zero")
+
+    points, segments = _rings_to_points(rings)
+    count = len(points)
+    if count < 3:
+        return np.zeros((0, 2), dtype=float64), np.zeros((0, 3), dtype=int64)
+
+    array = np.array(points, dtype=float64)
+    middle = (array.min(axis=0) + array.max(axis=0)) / 2.0
+    radius = max(float(np.abs(array - middle).max()), 1.0) * _SCALE
+
+    # an enclosing triangle which is dropped once the mesh is done
+    mesh = _Mesh(list(points))
+    for angle in (90.0, 210.0, 330.0):
+        radians = math.radians(angle)
+        mesh.outer.add(len(mesh.points))
+        mesh.points.append(
+            (
+                float(middle[0] + radius * 2.0 * math.cos(radians)),
+                float(middle[1] + radius * 2.0 * math.sin(radians)),
+            )
+        )
+    mesh.add(count, count + 1, count + 2)
+
+    for vertex in range(count):
+        mesh.insert(vertex)
+    for a, b in sorted(segments):
+        mesh.constrain(a, b)
+    mesh.delaunay(segments)
+    mesh.classify(segments)
+
+    if min_angle is not None or max_area is not None:
+        mesh.refine(segments, min_angle, max_area, count * _MAX_ADDED)
+        mesh.delaunay(segments)
+
+    faces = mesh.faces()
+    if len(faces) == 0:
+        return array, np.zeros((0, 3), dtype=int64)
+
+    # drop the enclosing triangle and anything which ended up unused
+    used = sorted({vertex for triangle in faces for vertex in triangle})
+    remap = {vertex: offset for offset, vertex in enumerate(used)}
+    return (
+        np.array([mesh.points[vertex] for vertex in used], dtype=float64),
+        np.array([[remap[v] for v in face] for face in faces], dtype=int64),
+    )
