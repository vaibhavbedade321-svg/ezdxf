+"""
+triangulation.py
+-----------------
+
+A constrained Delaunay triangulation of polygons with holes
+which needs nothing outside of the required dependencies.
+"""
+
+from collections import deque
+
+import numpy as np
+
+from .typed import NDArray, Sequence, float64, int64
+
+# relative tolerance used by the geometric predicates
+_TOL = 1e-12
+
+# how much larger than the input the enclosing triangle is made
+_SCALE = 1000.0
+
+# stop flipping if this many operations didn't finish the job
+_LIMIT = 1000000
+
+
+def _orient(a, b, c) -> float:
+    """
+    Twice the signed area of the triangle `a, b, c`, positive
+    when the three points are wound counter-clockwise.
+    """
+    return (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
+
+
+def _in_circle(a, b, c, d) -> float:
+    """
+    Positive when `d` lies inside the circumcircle of the
+    counter-clockwise wound triangle `a, b, c`.
+    """
+    adx, ady = a[0] - d[0], a[1] - d[1]
+    bdx, bdy = b[0] - d[0], b[1] - d[1]
+    cdx, cdy = c[0] - d[0], c[1] - d[1]
+    return (
+        (adx * adx + ady * ady) * (bdx * cdy - cdx * bdy)
+        - (bdx * bdx + bdy * bdy) * (adx * cdy - cdx * ady)
+        + (cdx * cdx + cdy * cdy) * (adx * bdy - bdx * ady)
+    )
+
+
+class _Mesh:
+    """
+    A triangle mesh stored as a map of directed edges, i.e. the
+    triangle on the other side of the edge `(a, b)` is the triangle
+    which holds the directed edge `(b, a)`.
+    """
+
+    def __init__(self, points: list, scale: float):
+        self.points = points
+        # index of triangle to counter-clockwise wound vertices
+        self.triangles = {}
+        # directed edge to the index of the triangle holding it
+        self.edges = {}
+        self._next = 0
+        self._area = _TOL * scale**2
+        self._circle = _TOL * scale**4
+
+    def add(self, a: int, b: int, c: int) -> int:
+        index = self._next
+        self._next += 1
+        self.triangles[index] = (a, b, c)
+        self.edges[(a, b)] = index
+        self.edges[(b, c)] = index
+        self.edges[(c, a)] = index
+        return index
+
+    def pop(self, index: int) -> None:
+        a, b, c = self.triangles.pop(index)
+        del self.edges[(a, b)]
+        del self.edges[(b, c)]
+        del self.edges[(c, a)]
+
+    def orient(self, a: int, b: int, c: int) -> float:
+        return _orient(self.points[a], self.points[b], self.points[c])
+
+    def in_circle(self, a: int, b: int, c: int, d: int) -> float:
+        return _in_circle(
+            self.points[a], self.points[b], self.points[c], self.points[d]
+        )
+
+    def apex(self, a: int, b: int):
+        """
+        The vertex facing the directed edge `(a, b)`, or None when
+        the edge is on the outside of the mesh.
+        """
+        index = self.edges.get((a, b))
+        if index is None:
+            return None
+        triangle = self.triangles[index]
+        return triangle[(triangle.index(a) + 2) % 3]
+
+    def between(self, a: int, b: int, c: int) -> bool:
+        """
+        Check if vertex `c` lies on the inside of the segment `a, b`.
+        """
+        if abs(self.orient(a, b, c)) > self._area:
+            return False
+        pa, pb, pc = self.points[a], self.points[b], self.points[c]
+        dx, dy = pb[0] - pa[0], pb[1] - pa[1]
+        along = (pc[0] - pa[0]) * dx + (pc[1] - pa[1]) * dy
+        return 0.0 < along < (dx * dx + dy * dy)
+
+    def crossing(self, a: int, b: int, c: int, d: int) -> bool:
+        """
+        Check if the segments `a, b` and `c, d` cross each other
+        somewhere other than at their end points.
+        """
+        if len({a, b, c, d}) != 4:
+            return False
+        return (
+            self.orient(a, b, c) * self.orient(a, b, d) < 0.0
+            and self.orient(c, d, a) * self.orient(c, d, b) < 0.0
+        )
+
+    def locate(self, vertex: int):
+        """
+        Index of a triangle which contains the passed vertex.
+        """
+        for index, (a, b, c) in self.triangles.items():
+            if (
+                self.orient(a, b, vertex) >= -self._area
+                and self.orient(b, c, vertex) >= -self._area
+                and self.orient(c, a, vertex) >= -self._area
+            ):
+                return index
+        return None
+
+    def border(self, cavity: set) -> list:
+        """
+        The directed edges enclosing a set of triangles.
+        """
+        border = []
+        for index in cavity:
+            a, b, c = self.triangles[index]
+            for u, v in ((a, b), (b, c), (c, a)):
+                if self.edges.get((v, u)) not in cavity:
+                    border.append((u, v))
+        return border
+
+    def insert(self, vertex: int) -> None:
+        """
+        Add a vertex using the Bowyer-Watson approach: drop every
+        triangle whose circumcircle holds the vertex and fill the
+        hole that leaves behind.
+        """
+        seed = self.locate(vertex)
+        if seed is None:
+            return
+        cavity = {seed}
+        queue = [seed]
+        while queue:
+            a, b, c = self.triangles[queue.pop()]
+            for u, v in ((a, b), (b, c), (c, a)):
+                index = self.edges.get((v, u))
+                if index is None or index in cavity:
+                    continue
+                x, y, z = self.triangles[index]
+                if self.in_circle(x, y, z, vertex) > self._circle:
+                    cavity.add(index)
+                    queue.append(index)
+
+        # a vertex sitting exactly on the edge of the cavity would
+        # otherwise be sealed in with a zero area triangle
+        while True:
+            border = self.border(cavity)
+            grow = {
+                self.edges[(v, u)]
+                for u, v in border
+                if (v, u) in self.edges and self.between(u, v, vertex)
+            }
+            grow.difference_update(cavity)
+            if len(grow) == 0:
+                break
+            cavity.update(grow)
+
+        for index in cavity:
+            self.pop(index)
+        for u, v in border:
+            self.add(u, v, vertex)
+
+    def walk(self, start: int, end: int):
+        """
+        The edges crossed by the segment `start, end` and the vertex
+        the walk stopped on, which is `end` unless another vertex sits
+        on the segment.
+        """
+        crossed = []
+        for index, triangle in self.triangles.items():
+            if start not in triangle:
+                continue
+            offset = triangle.index(start)
+            right = triangle[(offset + 1) % 3]
+            left = triangle[(offset + 2) % 3]
+            if right == end or left == end:
+                return [], end
+            for vertex in (right, left):
+                if self.between(start, end, vertex):
+                    return [], vertex
+            if self.orient(start, end, right) < 0.0 < self.orient(start, end, left):
+                crossed.append((right, left))
+                break
+        if len(crossed) == 0:
+            return [], end
+
+        # step from triangle to triangle towards the end vertex, keeping
+        # the first vertex of every crossed edge on the right hand side
+        while True:
+            right, left = crossed[-1]
+            if (left, right) not in self.edges:
+                break
+            ahead = self.apex(left, right)
+            if ahead == end:
+                break
+            if self.between(start, end, ahead):
+                return crossed, ahead
+            if self.orient(start, end, ahead) < 0.0:
+                crossed.append((ahead, left))
+            else:
+                crossed.append((right, ahead))
+        return crossed, end
+
+    def force(self, start: int, end: int, crossed: list) -> None:
+        """
+        Flip the crossed edges until the segment `start, end` is an
+        edge of the mesh.
+        """
+        queue = deque(crossed)
+        stall = 0
+        while len(queue) > 0 and stall <= len(queue) and self._next < _LIMIT:
+            right, left = queue.popleft()
+            if (right, left) not in self.edges or (left, right) not in self.edges:
+                continue
+            near = self.apex(right, left)
+            far = self.apex(left, right)
+            # only a strictly convex quad can be flipped
+            if (
+                self.orient(near, right, far) <= self._area
+                or self.orient(near, far, left) <= self._area
+            ):
+                queue.append((right, left))
+                stall += 1
+                continue
+            stall = 0
+            self.pop(self.edges[(right, left)])
+            self.pop(self.edges[(left, right)])
+            self.add(near, right, far)
+            self.add(near, far, left)
+            if self.crossing(start, end, near, far):
+                if self.orient(start, end, near) < 0.0:
+                    queue.append((near, far))
+                else:
+                    queue.append((far, near))
+
+    def constrain(self, start: int, end: int) -> None:
+        """
+        Make sure the segment `start, end` is an edge of the mesh.
+        """
+        while start != end:
+            if (start, end) in self.edges or (end, start) in self.edges:
+                return
+            crossed, reached = self.walk(start, end)
+            if len(crossed) == 0 and reached == end:
+                return
+            self.force(start, reached, crossed)
+            start = reached
+
+    def delaunay(self, fixed: set, count: int) -> None:
+        """
+        Flip every edge which isn't locally Delaunay, leaving the
+        fixed edges and the enclosing triangle alone.
+        """
+        stack = [(a, b) for a, b in self.edges if a < b]
+        queued = set(stack)
+        while len(stack) > 0 and self._next < _LIMIT:
+            edge = stack.pop()
+            queued.discard(edge)
+            a, b = edge
+            if edge in fixed or (a, b) not in self.edges:
+                continue
+            near = self.apex(a, b)
+            far = self.apex(b, a)
+            if near is None or far is None:
+                continue
+            # vertices of the enclosing triangle are dropped later on
+            if max(a, b, near, far) >= count:
+                continue
+            if self.in_circle(a, b, near, far) <= self._circle:
+                continue
+            if (
+                self.orient(near, a, far) <= self._area
+                or self.orient(near, far, b) <= self._area
+            ):
+                continue
+            self.pop(self.edges[(a, b)])
+            self.pop(self.edges[(b, a)])
+            self.add(near, a, far)
+            self.add(near, far, b)
+            for u, v in ((a, far), (far, b), (b, near), (near, a)):
+                other = (u, v) if u < v else (v, u)
+                if other not in queued:
+                    queued.add(other)
+                    stack.append(other)
+
+    def enclosed(self, boundary: set, count: int) -> list:
+        """
+        The triangles inside the polygon, found by walking inwards from
+        the enclosing triangle and flipping a flag on every boundary
+        edge that is stepped over.
+        """
+        inside = {index: False for index, tri in self.triangles.items() if max(tri) >= count}
+        queue = deque(inside)
+        while len(queue) > 0:
+            index = queue.popleft()
+            a, b, c = self.triangles[index]
+            for u, v in ((a, b), (b, c), (c, a)):
+                neighbor = self.edges.get((v, u))
+                if neighbor is None or neighbor in inside:
+                    continue
+                edge = (u, v) if u < v else (v, u)
+                inside[neighbor] = inside[index] != (edge in boundary)
+                queue.append(neighbor)
+        return [
+            triangle
+            for index, triangle in self.triangles.items()
+            if inside.get(index, False)
+        ]
+
+
+def _rings_to_points(rings: Sequence) -> tuple:
+    """
+    Flatten closed rings into a single array of unique points and
+    the index of every ring segment.
+
+    Parameters
+    ----------
+    rings
+      Sequence of (n, 2) float, the first is the exterior.
+
+    Returns
+    -------
+    points
+      (m, 2) float64, every ring vertex exactly once.
+    segments
+      Set of index pairs, one per ring segment.
+    """
+    points = []
+    lookup = {}
+    segments = set()
+
+    for ring in rings:
+        ring = np.asanyarray(ring, dtype=float64).reshape((-1, 2))
+        indexes = []
+        for point in ring:
+            key = (float(point[0]), float(point[1]))
+            index = lookup.get(key)
+            if index is None:
+                index = len(points)
+                lookup[key] = index
+                points.append(key)
+            if len(indexes) == 0 or indexes[-1] != index:
+                indexes.append(index)
+        # rings arrive closed so drop the repeated final vertex
+        if len(indexes) > 1 and indexes[0] == indexes[-1]:
+            indexes.pop()
+        if len(indexes) < 3:
+            continue
+        for offset, index in enumerate(indexes):
+            other = indexes[(offset + 1) % len(indexes)]
+            segments.add((index, other) if index < other else (other, index))
+
+    return points, segments
+
+
+def constrained_delaunay(
+    rings: Sequence,
+) -> tuple[NDArray[float64], NDArray[int64]]:
+    """
+    Triangulate a polygon with holes without adding any new vertices.
+
+    Every ring segment is an edge of the result and every edge which
+    isn't a ring segment is locally Delaunay, which keeps the triangles
+    as well shaped as possible for the given vertices.
+
+    Parameters
+    ----------
+    rings
+      Sequence of (n, 2) float closed rings, the first of which is
+      the exterior and the rest of which are holes.
+
+    Returns
+    -------
+    vertices
+      (m, 2) float64 points, the unique vertices of the passed rings.
+    faces
+      (t, 3) int64 indexes of counter-clockwise wound triangles.
+    """
+    points, segments = _rings_to_points(rings)
+    count = len(points)
+    if count < 3:
+        return np.zeros((0, 2), dtype=float64), np.zeros((0, 3), dtype=int64)
+
+    array = np.array(points, dtype=float64)
+    center = (array.min(axis=0) + array.max(axis=0)) / 2.0
+    radius = max(float(np.abs(array - center).max()), 1.0) * _SCALE
+    scale = max(float(np.abs(array).max()), 1.0)
+
+    # an enclosing triangle which is dropped once the mesh is done
+    mesh = _Mesh(list(points), scale)
+    for angle in (90.0, 210.0, 330.0):
+        radians = np.radians(angle)
+        mesh.points.append(
+            (
+                float(center[0] + radius * 2.0 * np.cos(radians)),
+                float(center[1] + radius * 2.0 * np.sin(radians)),
+            )
+        )
+    mesh.add(count, count + 1, count + 2)
+
+    for vertex in range(count):
+        mesh.insert(vertex)
+    for a, b in segments:
+        mesh.constrain(a, b)
+    mesh.delaunay(segments, count)
+
+    faces = [
+        triangle
+        for triangle in mesh.enclosed(segments, count)
+        if max(triangle) < count and mesh.orient(*triangle) > mesh._area
+    ]
+    if len(faces) == 0:
+        return array, np.zeros((0, 3), dtype=int64)
+
+    return array, np.array(faces, dtype=int64)
