+    def test_near_collinear(self):
+        # a boundary which is very nearly, but not quite, a straight line
+        coords = [(0.0, 0.0)]
+        for i in range(1, 8):
+            y = float(np.nextafter(0.0, np.inf)) * (i % 3)
+            coords.append((float(i), y))
+        coords.append((7.0, 1.0))
+        coords.append((0.0, 1.0))
+        polygon = g.Polygon(coords)
+        assert polygon.is_valid
+        self.check(polygon)
