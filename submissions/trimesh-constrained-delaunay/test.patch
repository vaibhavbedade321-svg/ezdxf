+#!/usr/bin/env bash
+# Test runner for the triangulation engine work.
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+#   base  existing tests covering polygon triangulation and everything
+#         downstream of it, which must pass before and after the change.
+#   new   tests for the built-in triangulation engine.
+set -uo pipefail
+
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+if [ -z "$OUTPUT_PATH" ]; then
+  OUTPUT_PATH="$(mktemp -d)/results.xml"
+fi
+
+case "$MODE" in
+  base)
+    # every existing test which touches `triangulate_polygon` or consumes
+    # the faces it returns
+    TARGETS=(
+      tests/test_creation.py
+      tests/test_extrude.py
+      tests/test_polygons.py
+      tests/test_triangles.py
+      tests/test_paths.py
+      tests/test_section.py
+    )
+    ;;
+  new)
+    TARGETS=(tests/test_delaunay_fe0bc1.py)
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+python -m pytest "${TARGETS[@]}" -v -p no:randomly --junitxml="$OUTPUT_PATH"
+exit $?
