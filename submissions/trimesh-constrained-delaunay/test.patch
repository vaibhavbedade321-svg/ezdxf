+    def test_independent_of_ring_order(self):
+        # the polygon decides the triangulation, not the order its rings
+        # happen to be written in
+        cases = [
+            ([(0, 0), (1, 0), (1, 1), (0, 1)], None),
+            ([(0, 0), (3, 0), (3, 1), (1, 1), (1, 3), (0, 3)], None),
+            (
+                [(0, 0), (9, 0), (9, 9), (0, 9)],
+                [[(3, 3), (3, 6), (6, 6), (6, 3)]],
+            ),
+        ]
+        for count in [5, 8, 12]:
+            angles = np.linspace(0.0, np.pi * 2, count, endpoint=False)
+            cases.append(
+                (list(map(tuple, np.column_stack([np.cos(angles), np.sin(angles)]))), None)
+            )
+
+        for coords, holes in cases:
+            seen = set()
+            for start in range(len(coords)):
+                rolled = coords[start:] + coords[:start]
+                for ring in (rolled, rolled[::-1]):
+                    polygon = g.Polygon(ring, holes)
+                    seen.add(triangle_set(*self.check(polygon)))
+            assert len(seen) == 1, "ring order changed the triangulation"
+
+    def test_near_degenerate(self):
