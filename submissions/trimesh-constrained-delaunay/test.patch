+"""
+Tests for the built-in constrained Delaunay triangulation engine.
+"""
+
+import subprocess
+import sys
+import unittest
+from fractions import Fraction
+
+import numpy as np
+
+try:
+    from . import generic as g
+except BaseException:
+    import generic as g
+
+
+def rings(polygon):
+    """Exterior ring first, then every interior ring."""
+    out = [np.array(polygon.exterior.coords, dtype=np.float64)]
+    out.extend(np.array(i.coords, dtype=np.float64) for i in polygon.interiors)
+    return out
+
+
+def signed_area(triangles):
+    """Twice the signed area of every (n, 3, 2) triangle."""
+    ab = triangles[:, 1] - triangles[:, 0]
+    ac = triangles[:, 2] - triangles[:, 0]
+    return (ab[:, 0] * ac[:, 1] - ab[:, 1] * ac[:, 0]) / 2.0
+
+
+def in_circle(a, b, c, d):
+    """
+    Positive when `d` is inside the circumcircle of counter-clockwise
+    `a, b, c`, evaluated exactly so a knife-edge case cannot be decided
+    by rounding.
+    """
+    ax, ay = Fraction(a[0]) - Fraction(d[0]), Fraction(a[1]) - Fraction(d[1])
+    bx, by = Fraction(b[0]) - Fraction(d[0]), Fraction(b[1]) - Fraction(d[1])
+    cx, cy = Fraction(c[0]) - Fraction(d[0]), Fraction(c[1]) - Fraction(d[1])
+    return (
+        (ax * ax + ay * ay) * (bx * cy - cx * by)
+        + (bx * bx + by * by) * (cx * ay - ax * cy)
+        + (cx * cx + cy * cy) * (ax * by - bx * ay)
+    )
+
+
+def triangle_set(vertices, faces):
+    """The triangulation as a set, independent of any ordering."""
+    return frozenset(
+        frozenset((float(p[0]), float(p[1])) for p in vertices[face])
+        for face in faces
+    )
+
+
+def ulp_ring(count, radius, stride):
+    """
+    A ring whose vertices sit within a single ULP of a circle, so the
+    four point circle tests come down to the very last bit.
+    """
+    points = []
+    for i in range(count):
+        angle = 2.0 * np.pi * i / count
+        x, y = radius * np.cos(angle), radius * np.sin(angle)
+        nudge = ((i * stride) % 3) - 1
+        for _ in range(abs(nudge)):
+            x = np.nextafter(x, np.inf if nudge > 0 else -np.inf)
+        points.append((float(x), float(y)))
+    return points
+
+
+def key_of(point):
+    return (round(float(point[0]), 9), round(float(point[1]), 9))
+
+
+# Setup for a process where none of the optional packages can be imported or
+# even detected, so the engine has to stand on the required dependencies.
+# Importing is blocked at `__import__`, while the `sys.modules` entries are
+# what make `importlib.util.find_spec` report the packages as missing.
+ISOLATED = '''
+import builtins
+import sys
+
+BLOCKED = ("mapbox_earcut", "manifold3d", "triangle", "scipy")
+
+_real_import = builtins.__import__
+
+
+def _blocked_import(name, *args, **kwargs):
+    if name.split(".")[0] in BLOCKED:
+        raise ModuleNotFoundError("No module named " + repr(name), name=name)
+    return _real_import(name, *args, **kwargs)
+
+
+builtins.__import__ = _blocked_import
+
+for name in BLOCKED:
+    sys.modules[name] = None
+
+import numpy as np
+from shapely.geometry import Polygon
+
+import trimesh
+
+for name in ("mapbox_earcut", "manifold3d", "triangle", "scipy"):
+    try:
+        __import__(name)
+        raise AssertionError(name + " was importable")
+    except ImportError:
+        pass
+
+polygon = Polygon(
+    [(0, 0), (4, 0), (4, 4), (0, 4)], [[(1, 1), (1, 2), (2, 2), (2, 1)]]
+)
+
+
+def check(result):
+    vertices, faces = result
+    triangles = np.asarray(vertices)[np.asarray(faces)]
+    ab = triangles[:, 1] - triangles[:, 0]
+    ac = triangles[:, 2] - triangles[:, 0]
+    area = ((ab[:, 0] * ac[:, 1] - ab[:, 1] * ac[:, 0]) / 2.0).sum()
+    assert abs(area - polygon.area) < 1e-9, area
+    print("OK", len(faces))
+
+'''
+
+
+class DelaunayTest(g.unittest.TestCase):
+    def triangulate(self, polygon):
+        return g.trimesh.creation.triangulate_polygon(polygon, engine="delaunay")
+
+    def check(self, polygon, expect_faces=True):
+        """
+        Run every invariant the triangulation has to hold and return
+        the vertices and faces so a caller can check more.
+        """
+        vertices, faces = self.triangulate(polygon)
+        vertices = np.asarray(vertices, dtype=np.float64)
+        faces = np.asarray(faces, dtype=np.int64)
+
+        if not expect_faces:
+            assert len(faces) == 0
+            return vertices, faces
+
+        assert len(faces) > 0
+        assert faces.shape[1] == 3
+        assert faces.min() >= 0
+        assert faces.max() < len(vertices)
+
+        triangles = vertices[faces]
+        area = signed_area(triangles)
+
+        # every face is wound counter-clockwise and has real area
+        assert area.min() > 0.0
+        # the faces exactly cover the polygon
+        assert g.np.isclose(area.sum(), polygon.area, rtol=1e-9, atol=1e-9)
+
+        # the vertices are exactly the ring vertices, nothing added or dropped
+        want = set()
+        for ring in rings(polygon):
+            want.update(key_of(p) for p in ring)
+        got = [key_of(p) for p in vertices]
+        assert len(got) == len(set(got))
+        assert set(got) == want
+        # and every one of them is used by at least one face
+        assert len(set(faces.ravel().tolist())) == len(want)
+
+        # a triangulation which adds no vertices always has this many faces
+        holes = len(polygon.interiors)
+        assert len(faces) == len(want) + 2 * holes - 2
+
+        # no edge may be shared by more than two faces
+        index = {key: i for i, key in enumerate(got)}
+        used = {}
+        for a, b, c in faces:
+            for u, v in ((a, b), (b, c), (c, a)):
+                edge = (min(u, v), max(u, v))
+                used[edge] = used.get(edge, 0) + 1
+        assert max(used.values()) <= 2
+
+        # every ring segment survives as an edge of the triangulation
+        fixed = set()
+        for ring in rings(polygon):
+            walk = [index[key_of(p)] for p in ring]
+            for u, v in zip(walk[:-1], walk[1:]):
+                if u == v:
+                    continue
+                edge = (min(u, v), max(u, v))
+                fixed.add(edge)
+                assert edge in used, "ring segment is missing"
+        # ring segments are on the boundary of the covered area or between
+        # the inside and a hole, so they are used exactly once
+        for edge in fixed:
+            assert used[edge] == 1
+
+        # every edge which isn't a ring segment has to be locally Delaunay
+        apex = {}
+        for a, b, c in faces:
+            for u, v, o in ((a, b, c), (b, c, a), (c, a, b)):
+                apex[(u, v)] = o
+        for (u, v), near in apex.items():
+            far = apex.get((v, u))
+            if far is None or (min(u, v), max(u, v)) in fixed:
+                continue
+            value = in_circle(vertices[u], vertices[v], vertices[near], vertices[far])
+            assert value <= 0, "edge is not locally Delaunay"
+
+        return vertices, faces
+
+    def test_convex(self):
+        for polygon in [
+            g.Polygon([(0, 0), (1, 0), (1, 1), (0, 1)]),
+            g.Polygon([(0, 0), (4, 0), (5, 3)]),
+            g.Polygon([(0, 0), (10, 0), (10, 0.01), (0, 0.01)]),
+            g.Polygon([(0, 0), (1e6, 0), (1e6, 1e6), (0, 1e6)]),
+            g.Polygon([(0, 0), (1e-4, 0), (1e-4, 1e-4), (0, 1e-4)]),
+        ]:
+            self.check(polygon)
+
+    def test_regular_polygons(self):
+        # every vertex of a regular polygon sits on one circle, which is the
+        # worst case for the circumcircle test
+        for count in [3, 4, 5, 8, 17, 64]:
+            angles = np.linspace(0.0, np.pi * 2, count, endpoint=False)
+            polygon = g.Polygon(np.column_stack([np.cos(angles), np.sin(angles)]))
+            _, faces = self.check(polygon)
+            assert len(faces) == count - 2
+
+    def test_concave(self):
+        star = []
+        for i, angle in enumerate(np.linspace(0.0, np.pi * 2, 20, endpoint=False)):
+            radius = 5.0 if i % 2 == 0 else 2.0
+            star.append((np.cos(angle) * radius, np.sin(angle) * radius))
+
+        teeth = [(0, 0), (6, 0), (6, 5)]
+        for i in range(5, -1, -1):
+            teeth += [(i + 0.75, 5), (i + 0.75, 1), (i + 0.25, 1), (i + 0.25, 5)]
+        teeth += [(0, 5)]
+
+        for polygon in [
+            g.Polygon([(0, 0), (3, 0), (3, 1), (1, 1), (1, 3), (0, 3)]),
+            g.Polygon(star),
+            g.Polygon(teeth),
+        ]:
+            assert polygon.is_valid
+            self.check(polygon)
+
+    def test_holes(self):
+        square = [(0, 0), (9, 0), (9, 9), (0, 9)]
+        grid = [
+            [
+                (1 + 3 * i, 1 + 3 * j),
+                (2 + 3 * i, 1 + 3 * j),
+                (2 + 3 * i, 2 + 3 * j),
+                (1 + 3 * i, 2 + 3 * j),
+            ]
+            for i in range(3)
+            for j in range(3)
+        ]
+        for holes in [grid[:1], grid[:4], grid]:
+            polygon = g.Polygon(square, holes)
+            assert polygon.is_valid
+            vertices, faces = self.check(polygon)
+
+            # nothing may be triangulated inside a hole
+            centroids = vertices[faces].mean(axis=1)
+            for hole in holes:
+                inside = g.Polygon(hole)
+                assert not any(inside.contains(g.Point(c)) for c in centroids)
+
+    def test_annulus(self):
+        polygon = g.Point(5, 5).buffer(5.0).difference(g.Point(5, 5).buffer(2.0))
+        assert len(polygon.interiors) == 1
+        self.check(polygon)
+
+    def test_thin_hole(self):
+        polygon = g.Polygon(
+            [(0, 0), (20, 0), (20, 20), (0, 20)],
+            [
+                [(2, 2), (2, 18), (2.1, 18), (2.1, 2)],
+                [(5, 5), (5, 15), (5.05, 15), (5.05, 5)],
+            ],
+        )
+        assert polygon.is_valid
+        self.check(polygon)
+
+    def test_collinear(self):
+        # extra vertices in the middle of a straight edge still have to be used
+        polygon = g.Polygon([(0, 0), (1, 0), (2, 0), (2, 2), (1, 2), (0, 2)])
+        _, faces = self.check(polygon)
+        assert len(faces) == 4
+
+    def test_winding_independent(self):
+        # shapely keeps the ring order it was given, and both have to work
+        forward = [(0, 0), (4, 0), (4, 4), (0, 4)]
+        holes = [[(1, 1), (1, 2), (2, 2), (2, 1)]]
+        first = self.check(g.Polygon(forward, holes))[1]
+        second = self.check(g.Polygon(forward[::-1], [holes[0][::-1]]))[1]
+        assert len(first) == len(second)
+
+    def test_duplicate_points(self):
+        # a repeated vertex is not a new vertex
+        polygon = g.Polygon([(0, 0), (1, 0), (1, 0), (1, 1), (0, 1), (0, 1)])
+        vertices, faces = self.check(polygon)
+        assert len(vertices) == 4
+        assert len(faces) == 2
+
+    def test_degenerate(self):
+        # nothing with any area to trianglulate
+        for coords in [
+            [(0, 0), (1, 0), (2, 0), (3, 0)],
+            [(0, 0), (1, 1), (2, 2)],
+        ]:
+            _, faces = g.trimesh.creation.triangulate_polygon(
+                g.Polygon(coords), engine="delaunay"
+            )
+            assert len(np.asarray(faces)) == 0
+
+    def test_real_geometry(self):
+        for name in ["125_cycloidal.DXF", "wrench.dxf", "sliding-base.dxf"]:
+            path = g.get_mesh(g.os.path.join("2D", name))
+            for polygon in path.polygons_full[:2]:
+                if not polygon.is_valid:
+                    continue
+                self.check(polygon)
+
+    def test_strip(self):
+        # a long strip is where ear clipping leaves a fan of slivers, so it is
+        # the shape most likely to expose a triangulation which is valid but
+        # not Delaunay
+        coords = [(0, 0), (4, 0), (8, 0), (12, 0), (12, 1), (8, 1), (4, 1), (0, 1)]
+        self.check(g.Polygon(coords))
+
+    def test_extrude(self):
+        polygon = g.Polygon(
+            [(0, 0), (4, 0), (4, 4), (0, 4)], [[(1, 1), (1, 2), (2, 2), (2, 1)]]
+        )
+        mesh = g.trimesh.creation.extrude_polygon(polygon, height=2.0, engine="delaunay")
+        assert mesh.is_watertight
+        assert mesh.is_volume
+        assert g.np.isclose(mesh.volume, polygon.area * 2.0)
+
+    def refined(self, polygon, **kwargs):
+        """
+        Triangulate with a quality target and check everything which
+        still has to hold once vertices are allowed to be added.
+        """
+        vertices, faces = g.trimesh.creation.triangulate_polygon(
+            polygon, engine="delaunay", **kwargs
+        )
+        vertices = np.asarray(vertices, dtype=np.float64)
+        faces = np.asarray(faces, dtype=np.int64)
+        triangles = vertices[faces]
+        area = signed_area(triangles)
+
+        # still wound the same way and still an exact cover
+        assert area.min() > 0.0
+        assert g.np.isclose(area.sum(), polygon.area, rtol=1e-9, atol=1e-9)
+
+        # the original ring vertices all survive refinement
+        want = set()
+        for ring in rings(polygon):
+            want.update(key_of(p) for p in ring)
+        got = {key_of(p) for p in vertices}
+        assert want.issubset(got)
+
+        # no face may poke outside the polygon
+        grown = polygon.buffer(1e-9)
+        for centroid in triangles.mean(axis=1):
+            assert grown.contains(g.Point(centroid))
+
+        return vertices, faces, triangles
+
+    def smallest_angle(self, triangles):
+        out = []
+        for tri in triangles:
+            for i in range(3):
+                a, b, c = tri[i], tri[(i + 1) % 3], tri[(i + 2) % 3]
+                u, v = b - a, c - a
+                cos = np.dot(u, v) / (np.linalg.norm(u) * np.linalg.norm(v))
+                out.append(np.degrees(np.arccos(np.clip(cos, -1.0, 1.0))))
+        return min(out)
+
+    def test_min_angle(self):
+        polygons = [
+            g.Polygon([(0, 0), (12, 0), (12, 1), (0, 1)]),
+            g.Polygon([(0, 0), (3, 0), (3, 1), (1, 1), (1, 3), (0, 3)]),
+            g.Polygon(
+                [(0, 0), (9, 0), (9, 9), (0, 9)], [[(3, 3), (3, 6), (6, 6), (6, 3)]]
+            ),
+        ]
+        for polygon in polygons:
+            for min_angle in [15.0, 20.0, 25.0]:
+                _, _, triangles = self.refined(polygon, min_angle=min_angle)
+                assert self.smallest_angle(triangles) >= min_angle - 1e-6
+
+    def test_min_angle_adds_vertices(self):
+        # a long thin strip cannot meet a quality target with the
+        # vertices it starts with
+        polygon = g.Polygon([(0, 0), (12, 0), (12, 1), (0, 1)])
+        plain, _ = self.triangulate(polygon)
+        vertices, _, triangles = self.refined(polygon, min_angle=25.0)
+        assert len(vertices) > len(plain)
+        assert self.smallest_angle(triangles) >= 25.0 - 1e-6
+
+    def test_max_area(self):
+        polygons = [
+            g.Polygon([(0, 0), (4, 0), (4, 4), (0, 4)]),
+            g.Polygon([(0, 0), (3, 0), (3, 1), (1, 1), (1, 3), (0, 3)]),
+            g.Polygon(
+                [(0, 0), (9, 0), (9, 9), (0, 9)], [[(3, 3), (3, 6), (6, 6), (6, 3)]]
+            ),
+        ]
+        for polygon in polygons:
+            for max_area in [1.0, 0.25]:
+                _, faces, triangles = self.refined(polygon, max_area=max_area)
+                assert signed_area(triangles).max() <= max_area + 1e-9
+                assert len(faces) >= polygon.area / max_area
+
+    def test_both_targets(self):
+        polygon = g.Polygon([(0, 0), (6, 0), (6, 4), (0, 4)])
+        _, _, triangles = self.refined(polygon, min_angle=20.0, max_area=0.5)
+        assert self.smallest_angle(triangles) >= 20.0 - 1e-6
+        assert signed_area(triangles).max() <= 0.5 + 1e-9
+
+    def test_quality_is_optional(self):
+        # without a target nothing is added
+        polygon = g.Polygon([(0, 0), (12, 0), (12, 1), (0, 1)])
+        vertices, _ = self.triangulate(polygon)
+        assert len(vertices) == 4
+
+    def test_bad_quality_arguments(self):
+        polygon = g.Polygon([(0, 0), (4, 0), (4, 4), (0, 4)])
+        # a target inside the supported range is accepted
+        self.refined(polygon, min_angle=20.0, max_area=1.0)
+
+        for kwargs in [
+            {"min_angle": 0.0},
+            {"min_angle": -5.0},
+            {"min_angle": 45.0},
+            {"max_area": 0.0},
+            {"max_area": -1.0},
+        ]:
+            with self.assertRaises(ValueError):
+                g.trimesh.creation.triangulate_polygon(
+                    polygon, engine="delaunay", **kwargs
+                )
+
+        # neither target can be honoured without adding vertices
+        for kwargs in [{"min_angle": 25.0}, {"max_area": 1.0}]:
+            with self.assertRaises(ValueError):
+                g.trimesh.creation.triangulate_polygon(
+                    polygon, engine="delaunay", force_vertices=True, **kwargs
+                )
+
+    def test_quality_needs_the_engine(self):
+        # the other engines have no way to honour a quality target
+        polygon = g.Polygon([(0, 0), (4, 0), (4, 4), (0, 4)])
+        for engine in ["earcut", "manifold", "triangle"]:
+            for kwargs in [
+                {"min_angle": 20.0},
+                {"max_area": 1.0},
+                {"min_angle": 20.0, "max_area": 1.0},
+            ]:
+                with self.assertRaises(ValueError):
+                    g.trimesh.creation.triangulate_polygon(
+                        polygon, engine=engine, **kwargs
+                    )
+
+    def test_refined_boundary_is_preserved(self):
+        # refinement may split a ring segment but never move the boundary
+        polygon = g.Polygon([(0, 0), (12, 0), (12, 1), (0, 1)])
+        vertices, faces, _ = self.refined(polygon, min_angle=25.0)
+
+        boundary = {}
+        for a, b, c in faces:
+            for u, v in ((a, b), (b, c), (c, a)):
+                edge = (min(u, v), max(u, v))
+                boundary[edge] = boundary.get(edge, 0) + 1
+        outline = [e for e, count in boundary.items() if count == 1]
+
+        # every edge used once lies along the outline of the polygon
+        for u, v in outline:
+            middle = g.Point((vertices[u] + vertices[v]) / 2.0)
+            assert polygon.exterior.distance(middle) < 1e-9
+
+    def test_independent_of_ring_order(self):
+        # the polygon decides the triangulation, not the order its rings
+        # happen to be written in
+        cases = [
+            ([(0, 0), (1, 0), (1, 1), (0, 1)], None),
+            ([(0, 0), (3, 0), (3, 1), (1, 1), (1, 3), (0, 3)], None),
+            (
+                [(0, 0), (9, 0), (9, 9), (0, 9)],
+                [[(3, 3), (3, 6), (6, 6), (6, 3)]],
+            ),
+        ]
+        for count in [5, 8, 12]:
+            angles = np.linspace(0.0, np.pi * 2, count, endpoint=False)
+            cases.append(
+                (list(map(tuple, np.column_stack([np.cos(angles), np.sin(angles)]))), None)
+            )
+
+        for coords, holes in cases:
+            seen = set()
+            for start in range(len(coords)):
+                rolled = coords[start:] + coords[:start]
+                for ring in (rolled, rolled[::-1]):
+                    polygon = g.Polygon(ring, holes)
+                    seen.add(triangle_set(*self.check(polygon)))
+            assert len(seen) == 1, "ring order changed the triangulation"
+
+    def test_near_degenerate(self):
+        # vertices a single ULP off a shared circle, where a rounded
+        # circle test picks the wrong side
+        for count, radius, stride in [
+            (12, 1.0, 1),
+            (16, 1.0, 2),
+            (24, 1000.0, 2),
+            (40, 1e6, 5),
+        ]:
+            polygon = g.Polygon(ulp_ring(count, radius, stride))
+            assert polygon.is_valid
+            _, faces = self.check(polygon)
+            assert len(faces) == count - 2
+
+    def test_near_collinear(self):
+        # a boundary which is very nearly, but not quite, a straight line
+        coords = [(0.0, 0.0)]
+        for i in range(1, 8):
+            y = float(np.nextafter(0.0, np.inf)) * (i % 3)
+            coords.append((float(i), y))
+        coords.append((7.0, 1.0))
+        coords.append((0.0, 1.0))
+        polygon = g.Polygon(coords)
+        assert polygon.is_valid
+        self.check(polygon)
+
+    def isolated(self, body):
+        """
+        Run a snippet against a process which has no optional packages.
+        """
+        result = subprocess.run(
+            [sys.executable, "-c", ISOLATED + body],
+            capture_output=True,
+            text=True,
+            cwd=g.os.path.dirname(g.os.path.dirname(g.trimesh.__file__)),
+        )
+        assert result.returncode == 0, result.stderr
+        assert "OK" in result.stdout
+
+    def test_no_optional_dependencies(self):
+        # the engine has to run on the required dependencies alone
+        self.isolated(
+            "check(trimesh.creation.triangulate_polygon(polygon,"
+            " engine='delaunay'))"
+        )
+
+    def test_chosen_when_nothing_else_is_installed(self):
+        # with no optional package present the built-in engine is the one
+        # `triangulate_polygon` settles on, rather than raising
+        self.isolated("check(trimesh.creation.triangulate_polygon(polygon))")
+
