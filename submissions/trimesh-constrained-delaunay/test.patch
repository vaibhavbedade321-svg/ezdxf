+    def test_refined_boundary_is_preserved(self):
+        # refinement may split a ring segment but never move the boundary
+        polygon = g.Polygon([(0, 0), (12, 0), (12, 1), (0, 1)])
+        vertices, faces, _ = self.refined(polygon, min_angle=25.0)
+
+        boundary = {}
+        for a, b, c in faces:
+            for u, v in ((a, b), (b, c), (c, a)):
+                edge = (min(u, v), max(u, v))
+                boundary[edge] = boundary.get(edge, 0) + 1
+        outline = [e for e, count in boundary.items() if count == 1]
+
+        # every edge used once lies along the outline of the polygon
+        for u, v in outline:
+            middle = g.Point((vertices[u] + vertices[v]) / 2.0)
+            assert polygon.exterior.distance(middle) < 1e-9
+
+    def test_concave_polygons(self):
+        # plain concave polygons with fractional coordinates, the everyday
+        # case where a reflex corner puts one vertex inside the hull of
+        # the others
+        for coords in CONCAVE:
+            for scale in [1.0, 7.5]:
+                polygon = g.Polygon([(x * scale, y * scale) for x, y in coords])
+                assert polygon.is_valid and polygon.is_simple
+                _, faces = self.check(polygon)
+                assert len(faces) == len(coords) - 2
+
+    def test_refinement_far_from_origin(self):
+        # the same shape refined at the origin and a long way from it: the
+        # gap between neighbouring floats grows with the coordinates, so a
+        # vertex added half way along an edge must still land somewhere new
+        shapes = [
+            [(0, 0), (3, 0), (3, 1), (2, 1), (2, 3), (1, 3), (1, 1), (0, 1)],
+            [(0, 0), (3, 0), (3, 1), (1, 1), (1, 3), (0, 3)],
+            [(0, 0), (2, 0), (2, 2), (0, 2)],
+        ]
+        targets = [
+            {"min_angle": 10.0},
+            {"min_angle": 20.0},
+            {"max_area": 0.5},
+            {"min_angle": 15.0, "max_area": 0.5},
+        ]
+        for coords in shapes:
+            # every corner is a right angle or wider, so these targets are
+            # reachable without moving the boundary
+            for offset in [0.0, 1e3, 1e6, 1e7]:
+                polygon = g.Polygon([(x + offset, y + offset) for x, y in coords])
+                for kwargs in targets:
+                    _, faces, triangles = self.refined(polygon, **kwargs)
+                    if "min_angle" in kwargs:
+                        assert (
+                            self.smallest_angle(triangles)
+                            >= kwargs["min_angle"] - 1e-6
+                        )
+                    if "max_area" in kwargs:
+                        assert (
+                            signed_area(triangles).max()
+                            <= kwargs["max_area"] + 1e-7
+                        )
+
