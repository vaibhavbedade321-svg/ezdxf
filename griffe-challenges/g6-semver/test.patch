+def test_change_severity_maps_kind_to_level() -> None:
+    expected = {
+        griffe.ChangeKind.BREAKING: griffe.Bump.MAJOR,
+        griffe.ChangeKind.REMOVED: griffe.Bump.MAJOR,
+        griffe.ChangeKind.ADDED: griffe.Bump.MINOR,
+        griffe.ChangeKind.EXPANDED: griffe.Bump.MINOR,
+        griffe.ChangeKind.DEPRECATED: griffe.Bump.MINOR,
+    }
+    reports = [
+        _bump(
+            'def tool(a, b):\n    """Doc."""\n\n__all__ = ["tool"]\n',
+            'def tool(a):\n    """Doc."""\n\ndef helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n',
+        ),
+        _bump(
+            'def a():\n    """Doc."""\n\ndef b():\n    """Doc."""\n\n__all__ = ["a", "b"]\n',
+            'def a():\n    """Doc."""\n\ndef b():\n    """Doc."""\n\n__all__ = ["a"]\n',
+        ),
+        _bump(
+            'def tool(a):\n    """Doc."""\n\n__all__ = ["tool"]\n',
+            'def tool(a, b=1):\n    """Doc."""\n\n__all__ = ["tool"]\n',
+        ),
+        _bump(
+            'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n',
+            'from typing_extensions import deprecated\n\n'
+            '@deprecated("use other")\ndef tool():\n    """Doc."""\n\n__all__ = ["tool"]\n',
+        ),
+    ]
+    seen = set()
+    for report in reports:
+        for change in report.changes:
+            assert change.severity is expected[change.kind]
+            seen.add(change.kind)
+    assert seen == set(expected)
+
