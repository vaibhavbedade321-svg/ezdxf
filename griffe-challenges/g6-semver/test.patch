+def test_bump_between_loads_and_compares(tmp_path) -> None:
+    old_path = _write_version(
+        tmp_path, "old", 'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n',
+    )
+    new_path = _write_version(
+        tmp_path,
+        "new",
+        'def tool():\n    """Doc."""\n\ndef helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n',
+    )
+    report = griffe.bump_between("semverpkg", old_path, new_path)
+    assert report.bump is griffe.Bump.MINOR
+    assert report.additions == ["helper"]
+
+
+def test_recommend_bump_on_loader_built_models(tmp_path) -> None:
+    old_path = _write_version(tmp_path, "old", 'def tool(a):\n    """Doc."""\n\n__all__ = ["tool"]\n')
+    new_path = _write_version(
+        tmp_path,
+        "new",
+        'def tool(a):\n    """Doc."""\n\ndef extra():\n    """Doc."""\n\n__all__ = ["tool", "extra"]\n',
+    )
+    old_model = griffe.load("semverpkg", search_paths=[old_path])
+    new_model = griffe.load("semverpkg", search_paths=[new_path])
+    report = griffe.recommend_bump(old_model, new_model)
+    assert report.bump is griffe.Bump.MINOR
+    assert "extra" in report.additions
+
+
+def test_bump_between_honors_ignore(tmp_path) -> None:
+    old_path = _write_version(tmp_path, "old", 'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n')
+    new_path = _write_version(
+        tmp_path,
+        "new",
+        'def tool():\n    """Doc."""\n\ndef helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n',
+    )
+    assert griffe.bump_between("semverpkg", old_path, new_path).bump is griffe.Bump.MINOR
+    ignored = griffe.bump_between("semverpkg", old_path, new_path, ignore=["helper"])
+    assert ignored.bump is griffe.Bump.PATCH
+    assert "helper" not in ignored.additions
+
+
+def test_bump_between_forwards_load_options(tmp_path) -> None:
+    class _Recorder(griffe.Extension):
+        def __init__(self) -> None:
+            self.seen = []
+
+        def on_package(self, *, pkg, **kwargs) -> None:
+            self.seen.append(str(pkg.filepath))
+
+    code = 'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    old_path = _write_version(tmp_path, "old", code)
+    new_path = _write_version(tmp_path, "new", code)
+    recorder = _Recorder()
+    report = griffe.bump_between(
+        "semverpkg", old_path, new_path, extensions=griffe.load_extensions(recorder),
+    )
+    assert report.bump is griffe.Bump.PATCH
+    assert len(recorder.seen) == 2
+    assert any(path.startswith(old_path) for path in recorder.seen)
+    assert any(path.startswith(new_path) for path in recorder.seen)
+
