+def test_public_re_export_of_a_missing_dependency_still_reports(tmp_path) -> None:
+    # The dependency is not on the search path, so the alias never resolves.
+    # Its exported name is still part of the surface, and losing it breaks.
+    for version, body in (
+        ("old", 'from dependency import Widget\n\n__all__ = ["Widget"]\n'),
+        ("new", 'def keep():\n    """D."""\n\n__all__ = ["keep"]\n'),
+    ):
+        package = tmp_path / version / "extpkg"
+        package.mkdir(parents=True)
+        (package / "__init__.py").write_text(body, encoding="utf8")
+    report = griffe.bump_between("extpkg", str(tmp_path / "old"), str(tmp_path / "new"))
+    assert report.bump is griffe.Bump.MAJOR
+    assert "Widget" in {change.path for change in report.changes}
+
+
+def test_member_inherited_from_a_private_base_is_part_of_the_surface() -> None:
+    # `_Base` is not public, but `Public` exposes what it inherits, so adding
+    # a method to the base adds it to the public surface.
+    old = (
+        'class _Base:\n    """D."""\n\n'
+        'class Public(_Base):\n    """D."""\n\n__all__ = ["Public"]\n'
+    )
+    new = (
+        'class _Base:\n    """D."""\n\n    def extra(self):\n        """D."""\n\n'
+        'class Public(_Base):\n    """D."""\n\n__all__ = ["Public"]\n'
+    )
+    report = _bump(old, new)
+    assert report.bump is griffe.Bump.MINOR
+    assert report.additions == ["Public.extra"]
+
+
+def _write_vpkg(root, name: str, code: str) -> str:
+    package = root / name / "vpkg"
+    package.mkdir(parents=True)
+    (package / "__init__.py").write_text(dedent(code), encoding="utf8")
+    return str(root / name)
+
+
+def test_bump_between_ignores_a_same_named_package_in_the_working_directory(
+    tmp_path,
+    monkeypatch,
+) -> None:
+    # The two roots define the comparison; a `vpkg` sitting in the process's
+    # working directory must not be loaded in place of either of them.
+    both = 'def keep(a, b):\n    """D."""\n\n__all__ = ["keep"]\n'
+    old_root = _write_vpkg(tmp_path, "old", both)
+    new_root = _write_vpkg(tmp_path, "new", 'def keep(a):\n    """D."""\n\n__all__ = ["keep"]\n')
+    _write_vpkg(tmp_path, "cwd", both)
+    monkeypatch.chdir(tmp_path / "cwd")
+
+    report = griffe.bump_between("vpkg", old_root, new_root)
+    assert report.bump is griffe.Bump.MAJOR
+    assert [change.path for change in report.changes] == ["keep"]
+
+
+def _write_dotted(root, name: str, body: str) -> str:
+    package = root / name / "acme" / "library"
+    package.mkdir(parents=True)
+    (package / "__init__.py").write_text(dedent(body), encoding="utf8")
+    (root / name / "acme" / "__init__.py").write_text("", encoding="utf8")
+    return str(root / name)
+
+
+def test_dotted_package_paths_are_relative_to_the_whole_package_name(tmp_path) -> None:
+    # Loaded as `acme.library`, so the exported path of the dropped re-export
+    # is `Widget`, not `library.Widget`, and `ignore` matches it as one segment.
+    old_root = _write_dotted(
+        tmp_path,
+        "old",
+        'from dependency import Widget\n\ndef keep():\n    """D."""\n\n__all__ = ["Widget", "keep"]\n',
+    )
+    new_root = _write_dotted(tmp_path, "new", 'def keep():\n    """D."""\n\n__all__ = ["keep"]\n')
+
+    report = griffe.bump_between("acme.library", old_root, new_root)
+    assert report.bump is griffe.Bump.MAJOR
+    assert [change.path for change in report.changes] == ["Widget"]
+
+    ignored = griffe.bump_between("acme.library", old_root, new_root, ignore=("Widget",))
+    assert ignored.bump is griffe.Bump.PATCH
+    assert not ignored.changes
+
+
+_ALIASED = 'def f():\n    """D."""\n'
+
+
+def _alias_versions(old_names: str, new_names: str) -> tuple[dict, dict]:
+    return (
+        {"__init__.py": dedent(old_names), "inner.py": _ALIASED},
+        {"__init__.py": dedent(new_names), "inner.py": _ALIASED},
+    )
+
+
+def test_dropping_a_spare_export_name_is_a_removal() -> None:
+    # `f` is still exported as `A`, so it is compared under `A` in both
+    # models. `from pkg import B` stops working all the same.
+    old, new = _alias_versions(
+        'from semold.inner import f as A, f as B\n\n__all__ = ["A", "B"]\n',
+        'from semnew.inner import f as A\n\n__all__ = ["A"]\n',
+    )
+    report = _bump_multi(old, new)
+    assert report.bump is griffe.Bump.MAJOR
+    assert report.removals == ["B"]
+    assert not report.breaking
+
+
+def test_adding_a_spare_export_name_is_an_addition() -> None:
+    old, new = _alias_versions(
+        'from semold.inner import f as A\n\n__all__ = ["A"]\n',
+        'from semnew.inner import f as A, f as B\n\n__all__ = ["A", "B"]\n',
+    )
+    report = _bump_multi(old, new)
+    assert report.bump is griffe.Bump.MINOR
+    assert report.additions == ["B"]
+
+
+def test_dropping_the_compared_name_leaves_one_entry() -> None:
+    # `A` was the compared path and is gone; `B` was already exported, so it
+    # is not an addition just because the comparison moved onto it.
+    old, new = _alias_versions(
+        'from semold.inner import f as A, f as B\n\n__all__ = ["A", "B"]\n',
+        'from semnew.inner import f as B\n\n__all__ = ["B"]\n',
+    )
+    report = _bump_multi(old, new)
+    assert report.bump is griffe.Bump.MAJOR
+    assert [change.path for change in report.changes] == ["A"]
+
+
+def test_an_ignored_spare_name_can_disappear_freely() -> None:
+    old, new = _alias_versions(
+        'from semold.inner import f as A, f as B\n\n__all__ = ["A", "B"]\n',
+        'from semnew.inner import f as A\n\n__all__ = ["A"]\n',
+    )
+    with (
+        temporary_visited_package("semold", old) as old_module,
+        temporary_visited_package("semnew", new) as new_module,
+    ):
+        report = griffe.recommend_bump(old_module, new_module, ignore=("B",))
+    assert report.bump is griffe.Bump.PATCH
+    assert not report.changes
+
+
+def test_a_member_added_to_a_twice_exported_class_is_reported_once() -> None:
+    # The extra spellings of the class must not turn one new method into
+    # several additions.
+    old = {
+        "__init__.py": 'from semold.inner import Widget as A, Widget as B\n\n__all__ = ["A", "B"]\n',
+        "inner.py": 'class Widget:\n    """D."""\n',
+    }
+    new = {
+        "__init__.py": 'from semnew.inner import Widget as A, Widget as B\n\n__all__ = ["A", "B"]\n',
+        "inner.py": 'class Widget:\n    """D."""\n\n    def y(self):\n        """D."""\n',
+    }
+    report = _bump_multi(old, new)
+    assert report.bump is griffe.Bump.MINOR
+    assert report.additions == ["A.y"]
