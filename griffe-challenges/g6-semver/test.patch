+def test_multiple_breakings_on_one_path_sort_together() -> None:
+    old = 'def tool(a, b, c):\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    new = (
+        'def tool(a):\n    """Doc."""\n\n'
+        'def helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n'
+    )
+    report = _bump(old, new)
+    tool_breaks = [
+        c for c in report.changes_of_kind(griffe.ChangeKind.BREAKING) if c.path == "tool"
+    ]
+    assert len(tool_breaks) >= 2
+    keys = [(change.path, change.kind.value) for change in report.changes]
+    assert keys == sorted(keys)
