+def test_changelog_groups_by_top_level_name() -> None:
+    old = (
+        'class Tool:\n    """Doc."""\n\n    def run(self):\n        """Doc."""\n\n'
+        'def helper(a, b):\n    """Doc."""\n\n__all__ = ["Tool", "helper"]\n'
+    )
+    new = (
+        'class Tool:\n    """Doc."""\n\n    def run(self):\n        """Doc."""\n\n'
+        '    def stop(self):\n        """Doc."""\n\n'
+        'def helper(a):\n    """Doc."""\n\n__all__ = ["Tool", "helper"]\n'
+    )
+    report = _bump(old, new)
+    grouped = report.changelog()
+    assert set(grouped) == {"Tool", "helper"}
+    assert [c.path for c in grouped["Tool"]] == ["Tool.stop"]
+    assert all(c.path.split(".", 1)[0] == "helper" for c in grouped["helper"])
