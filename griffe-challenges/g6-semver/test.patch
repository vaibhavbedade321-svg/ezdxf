+def test_report_as_dict_is_json_serializable() -> None:
+    report = _bump(
+        'def tool(a, b):\n    """Doc."""\n\n__all__ = ["tool"]\n',
+        'def tool(a):\n    """Doc."""\n\ndef helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n',
+    )
+    payload = json.loads(json.dumps(report.as_dict(), cls=griffe.JSONEncoder))
+    assert payload["bump"] == "major"
+    assert payload["additions"] == ["helper"]
+    assert payload["breaking"]
+    assert payload["removals"] == []
+    assert payload["expansions"] == []
+    assert payload["deprecations"] == []
+    assert set(payload["counts"]) == {"added", "breaking"}
+    kinds = {change["kind"] for change in payload["changes"]}
+    assert {"added", "breaking"} <= kinds
+
