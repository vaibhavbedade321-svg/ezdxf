+def test_bump_between_loads_and_compares(tmp_path) -> None:
+    old_path = _write_version(
+        tmp_path, "old", 'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    )
+    new_path = _write_version(
+        tmp_path,
+        "new",
+        'def tool():\n    """Doc."""\n\ndef helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n',
+    )
+    report = griffe.bump_between("semverpkg", old_path, new_path)
+    assert report.bump is griffe.Bump.MINOR
+    assert report.additions == ["helper"]
+
+
+def test_bump_between_forwards_load_options(tmp_path, monkeypatch) -> None:
+    from griffe._internal import loader
+
+    calls: list[dict] = []
+    real_load = loader.load
+
+    def spy(*args, **kwargs):
+        calls.append(kwargs)
+        return real_load(*args, **kwargs)
+
+    monkeypatch.setattr(loader, "load", spy)
+
+    code = 'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    old_path = _write_version(tmp_path, "old", code)
+    new_path = _write_version(tmp_path, "new", code)
+    report = griffe.bump_between(
+        "semverpkg", old_path, new_path, allow_inspection=False
+    )
+    assert report.bump is griffe.Bump.PATCH
+    assert len(calls) == 2
+    assert all(call.get("allow_inspection") is False for call in calls)
+    search_paths = {tuple(call.get("search_paths") or ()) for call in calls}
+    assert search_paths == {(old_path,), (new_path,)}
+
