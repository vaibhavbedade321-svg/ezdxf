+    assert out.strip() == "1.3.0"
+    # The recommendation is MINOR, so --fail-on minor must still gate the exit code.
+    exit_code, out = _run_semver(tmp_path, old, new, "--bump", "1.2.3", "--fail-on", "minor")
+    assert exit_code != 0
+    assert out.strip() == "1.3.0"
+
+
+def test_cli_ignore_still_applies_when_bump_is_requested(tmp_path) -> None:
+    old = 'def t(a):\n    """D."""\n\n__all__ = ["t"]\n'
+    new = 'def t(a):\n    """D."""\n\ndef extra():\n    """D."""\n\n__all__ = ["t", "extra"]\n'
+    exit_code, out = _run_semver(tmp_path, old, new, "--bump", "1.2.3", "--ignore", "extra")
+    assert exit_code == 0
+    assert out.strip() == "1.2.4"
