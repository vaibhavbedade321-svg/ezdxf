+def test_required_parameter_added_is_major() -> None:
+    old = 'def tool(a):\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    new = 'def tool(a, b):\n    """Doc."""\n\n__all__ = ["tool"]\n'
