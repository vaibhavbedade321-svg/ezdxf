+        'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n',
+        'def tool():\n    """Doc."""\n\ndef helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n',
+    )
+    assert report.bump_version("2.3.4") == "2.4.0"
+
+
+def test_bump_version_patch() -> None:
+    code = 'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    assert _bump(code, code).bump_version("2.3.4") == "2.3.5"
+
+
+def test_bump_version_drops_suffix() -> None:
+    code = 'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    assert _bump(code, code).bump_version("2.3.4-rc1") == "2.3.5"
+
+
+def test_bump_version_rejects_invalid() -> None:
+    code = 'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    with pytest.raises(ValueError):
+        _bump(code, code).bump_version("v2")
+
+
+def test_report_as_dict_is_json_serializable() -> None:
+    report = _bump(
+        'def tool(a, b):\n    """Doc."""\n\n__all__ = ["tool"]\n',
+        'def tool(a):\n    """Doc."""\n\ndef helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n',
+    )
+    payload = json.loads(json.dumps(report.as_dict(), cls=griffe.JSONEncoder))
+    assert payload["bump"] == "major"
+    assert payload["additions"] == ["helper"]
+    assert payload["breaking"]
+    assert payload["removals"] == []
+    assert payload["expansions"] == []
+    assert payload["deprecations"] == []
+    assert set(payload["counts"]) == {"added", "breaking"}
+    kinds = {change["kind"] for change in payload["changes"]}
+    assert {"added", "breaking"} <= kinds
+
+
+def test_explain_is_one_line_naming_bump() -> None:
+    report = _bump(
+        'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n',
+        'def tool():\n    """Doc."""\n\ndef helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n',
+    )
+    text = report.explain()
+    assert "\n" not in text
+    assert griffe.Bump.MINOR.value in text.lower()
+    assert str(report) == text
+
