+def test_all_breaking_report_counts_and_serialization() -> None:
+    old = 'def tool(a, b, c):\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    new = 'def tool(a):\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    report = _bump(old, new)
+    assert report.bump is griffe.Bump.MAJOR
+    assert set(report.counts) == {"breaking"}
+    assert report.counts["breaking"] >= 2
+    assert report.changes_of_kind(griffe.ChangeKind.ADDED) == []
+    assert report.changes_of_kind(griffe.ChangeKind.REMOVED) == []
+    payload = report.as_dict()
+    breaking_entries = [c for c in payload["changes"] if c["kind"] == "breaking"]
+    assert len(breaking_entries) == report.counts["breaking"]
+    assert all(entry["path"] == "tool" for entry in breaking_entries)
