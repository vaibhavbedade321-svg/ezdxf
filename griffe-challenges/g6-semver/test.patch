+def test_report_as_dict_is_json_serializable() -> None:
+    report = _bump(
+        'def tool(a, b):\n    """Doc."""\n\n__all__ = ["tool"]\n',
+        'def tool(a):\n    """Doc."""\n\ndef helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n',
+    )
+    # Plain json.dumps, with no custom encoder: the mapping is required to be
+    # JSON-serializable on its own.
+    payload = json.loads(json.dumps(report.as_dict()))
+    assert payload["bump"] == "major"
+    assert list(payload["additions"]) == ["helper"]
+    assert payload["breaking"]
+    for entry in payload["breaking"]:
+        assert {"kind", "path", "detail"} <= set(entry)
+    assert not payload["removals"]
+    assert not payload["expansions"]
+    assert not payload["deprecations"]
+    assert set(payload["counts"]) == {"added", "breaking"}
+    kinds = {change["kind"] for change in payload["changes"]}
+    assert {"added", "breaking"} <= kinds
+
