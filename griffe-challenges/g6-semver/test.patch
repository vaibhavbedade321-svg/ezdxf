+def test_gated_by_thresholds() -> None:
+    minor = _bump(
+        'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n',
+        'def tool():\n    """Doc."""\n\ndef helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n',
+    )
+    assert minor.gated_by(griffe.Bump.MINOR)
+    assert not minor.gated_by(griffe.Bump.MAJOR)
