+"""Tests for the semantic version bump recommendation."""
+
+from __future__ import annotations
+
+import json
+from textwrap import dedent
+
+import pytest
+
+import griffe
+from griffe import temporary_visited_package
+
+
+def _bump(old: str, new: str):
+    with (
+        temporary_visited_package("semold", {"__init__.py": old}) as old_module,
+        temporary_visited_package("semnew", {"__init__.py": new}) as new_module,
+    ):
+        return griffe.recommend_bump(old_module, new_module)
+
+
+def _bump_multi(old: dict, new: dict):
+    with (
+        temporary_visited_package("semold", old) as old_module,
+        temporary_visited_package("semnew", new) as new_module,
+    ):
+        return griffe.recommend_bump(old_module, new_module)
+
+
+def test_identical_package_is_patch() -> None:
+    code = '"""Doc."""\n\ndef tool():\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    report = _bump(code, code)
+    assert report.bump is griffe.Bump.PATCH
+    assert not report.additions
+    assert not report.removals
+    assert not report.breaking
+
+
+def test_docstring_only_change_is_patch() -> None:
+    old = 'def tool():\n    """Old."""\n\n__all__ = ["tool"]\n'
+    new = 'def tool():\n    """New."""\n\n__all__ = ["tool"]\n'
+    assert _bump(old, new).bump is griffe.Bump.PATCH
+
+
+def test_added_public_object_is_minor() -> None:
+    old = 'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    new = (
+        'def tool():\n    """Doc."""\n\n'
+        'def helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n'
+    )
+    report = _bump(old, new)
+    assert report.bump is griffe.Bump.MINOR
+    assert list(report.additions) == ["helper"]
+    assert not report.removals
+
+
+def test_added_private_object_is_patch() -> None:
+    old = 'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    new = (
+        'def tool():\n    """Doc."""\n\n'
+        'def _helper():\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    )
+    report = _bump(old, new)
+    assert report.bump is griffe.Bump.PATCH
+    assert not report.additions
+
+
+def test_removed_public_object_is_major() -> None:
+    old = (
+        'def tool():\n    """Doc."""\n\n'
+        'def helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n'
+    )
+    new = 'def tool():\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    report = _bump(old, new)
+    assert report.bump is griffe.Bump.MAJOR
+    assert any(change.path == "helper" for change in report.changes)
+
+
+def test_removed_parameter_is_major() -> None:
+    old = 'def tool(a, b):\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    new = 'def tool(a):\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    report = _bump(old, new)
+    assert report.bump is griffe.Bump.MAJOR
+    assert report.breaking
+
+
+def test_addition_and_breakage_is_major() -> None:
+    old = 'def tool(a, b):\n    """Doc."""\n\n__all__ = ["tool"]\n'
+    new = (
+        'def tool(a):\n    """Doc."""\n\n'
+        'def helper():\n    """Doc."""\n\n__all__ = ["tool", "helper"]\n'
+    )
+    report = _bump(old, new)
+    assert report.bump is griffe.Bump.MAJOR
+    assert list(report.additions) == ["helper"]
+    assert report.breaking
