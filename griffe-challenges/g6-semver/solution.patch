diff --git a/packages/griffelib/src/griffe/_internal/semver.py b/packages/griffelib/src/griffe/_internal/semver.py
new file mode 100644
index 00000000..4626e790
--- /dev/null
+++ b/packages/griffelib/src/griffe/_internal/semver.py
@@ -0,0 +1,668 @@
+from __future__ import annotations
+
+import re
+from typing import TYPE_CHECKING, Any
+
+from griffe._internal.diff import find_breaking_changes
+from griffe._internal.enumerations import Bump, ChangeKind, ParameterKind
+from griffe._internal.exceptions import AliasResolutionError, CyclicAliasError
+
+if TYPE_CHECKING:
+    from collections.abc import Iterable, Iterator
+
+    from griffe._internal.diff import Breakage
+    from griffe._internal.models import Class, Function, Module, Object
+
+_VERSION = re.compile(
+    r"^(?P<major>0|[1-9]\d*)\.(?P<minor>0|[1-9]\d*)\.(?P<patch>0|[1-9]\d*)"
+    r"(?P<suffix>[-+].*)?$",
+)
+
+_VARIADIC_KINDS = frozenset(
+    {ParameterKind.var_positional, ParameterKind.var_keyword},
+)
+
+_SEVERITY = {Bump.PATCH: 0, Bump.MINOR: 1, Bump.MAJOR: 2}
+
+_KIND_SEVERITY = {
+    ChangeKind.BREAKING: Bump.MAJOR,
+    ChangeKind.REMOVED: Bump.MAJOR,
+    ChangeKind.ADDED: Bump.MINOR,
+    ChangeKind.EXPANDED: Bump.MINOR,
+    ChangeKind.DEPRECATED: Bump.MINOR,
+}
+
+_DEPRECATION_DECORATORS = frozenset(
+    {
+        "warnings.deprecated",
+        "typing.deprecated",
+        "typing_extensions.deprecated",
+        "deprecated.deprecated",
+        "deprecated",
+    },
+)
+
+
+class _Change:
+    """A single public API change between two versions of a package."""
+
+    def __init__(self, kind: ChangeKind, path: str, detail: str) -> None:
+        """Initialize the change.
+
+        Parameters:
+            kind: The change category.
+            path: The path of the changed object.
+            detail: A short human-readable detail.
+        """
+        self.kind = kind
+        """The change category."""
+        self.path = path
+        """The path of the changed object."""
+        self.detail = detail
+        """A short human-readable detail."""
+
+    def __str__(self) -> str:
+        return f"{self.kind.value}: {self.path} ({self.detail})"
+
+    def __repr__(self) -> str:
+        return f"_Change(kind={self.kind.value!r}, path={self.path!r}, detail={self.detail!r})"
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, _Change):
+            return NotImplemented
+        return (self.kind, self.path, self.detail) == (other.kind, other.path, other.detail)
+
+    def __hash__(self) -> int:
+        return hash((self.kind, self.path, self.detail))
+
+    @property
+    def severity(self) -> Bump:
+        """The bump level this change alone would force."""
+        return _KIND_SEVERITY.get(self.kind, Bump.PATCH)
+
+    def as_dict(self, **kwargs: Any) -> dict[str, str]:  # noqa: ARG002
+        """Return this change as a dictionary.
+
+        Parameters:
+            **kwargs: Additional serialization options.
+
+        Returns:
+            A dictionary.
+        """
+        return {"kind": self.kind.value, "path": self.path, "detail": self.detail}
+
+
+class BumpReport:
+    """The recommended version bump between two versions of a package."""
+
+    def __init__(self, bump: Bump, breaking: list[Breakage], changes: list[_Change]) -> None:
+        """Initialize the report.
+
+        Parameters:
+            bump: The recommended bump level.
+            breaking: The breaking changes found.
+            changes: Every public API change, sorted by path then kind.
+        """
+        self.bump = bump
+        """The recommended bump level."""
+        self.breaking = breaking
+        """The breaking changes found."""
+        self.changes = changes
+        """Every public API change, sorted by path then kind."""
+
+    def __str__(self) -> str:
+        return self.explain()
+
+    def __repr__(self) -> str:
+        return f"BumpReport(bump={self.bump.value!r}, changes={len(self.changes)})"
+
+    def _paths_of(self, kind: ChangeKind) -> list[str]:
+        return [change.path for change in self.changes if change.kind is kind]
+
+    @property
+    def additions(self) -> list[str]:
+        """Paths of public objects added in the new version."""
+        return self._paths_of(ChangeKind.ADDED)
+
+    @property
+    def removals(self) -> list[str]:
+        """Paths of public objects removed in the new version."""
+        return self._paths_of(ChangeKind.REMOVED)
+
+    @property
+    def expansions(self) -> list[str]:
+        """Paths of objects that gained a backward-compatible capability."""
+        return self._paths_of(ChangeKind.EXPANDED)
+
+    @property
+    def deprecations(self) -> list[str]:
+        """Paths of public objects newly marked as deprecated."""
+        return self._paths_of(ChangeKind.DEPRECATED)
+
+    @property
+    def counts(self) -> dict[str, int]:
+        """Number of changes per kind, keyed by kind value, omitting empty kinds."""
+        result: dict[str, int] = {}
+        for change in self.changes:
+            result[change.kind.value] = result.get(change.kind.value, 0) + 1
+        return result
+
+    def changes_of_kind(self, kind: ChangeKind) -> list[_Change]:
+        """Return the changes of one kind, in report order.
+
+        Parameters:
+            kind: The change kind to filter by.
+
+        Returns:
+            The matching changes.
+        """
+        return [change for change in self.changes if change.kind is kind]
+
+    def changelog(self) -> dict[str, list[_Change]]:
+        """Group the changes by the top-level name they belong to.
+
+        Returns:
+            A mapping from each top-level public name to its changes, in the
+            same order the changes appear in the report.
+        """
+        grouped: dict[str, list[_Change]] = {}
+        for change in self.changes:
+            top = change.path.split(".", 1)[0]
+            grouped.setdefault(top, []).append(change)
+        return grouped
+
+    def explain(self) -> str:
+        """Explain the recommendation with a one-line human-readable message.
+
+        Returns:
+            A message naming the bump level and the change counts.
+        """
+        return (
+            f"{self.bump.value}: {len(self.breaking)} breaking, "
+            f"{len(self.additions)} added, {len(self.removals)} removed, "
+            f"{len(self.expansions)} expanded, {len(self.deprecations)} deprecated"
+        )
+
+    def render_text(self) -> str:
+        """Render the report as plain text.
+
+        The first line states the recommended bump, followed by one line per
+        change. A report with no changes renders a single line.
+        """
+        header = f"Recommended bump: {self.bump.value}"
+        if not self.changes:
+            return f"{header} (no public API changes)"
+        lines = [header]
+        lines.extend(f"  {change}" for change in self.changes)
+        return "\n".join(lines)
+
+    def render_markdown(self) -> str:
+        """Render the report as Markdown.
+
+        The bump is a heading and changes are grouped under one subheading per
+        category, each with a bullet per change.
+        """
+        lines = [f"# Recommended bump: {self.bump.value}"]
+        if not self.changes:
+            lines.append("")
+            lines.append("No public API changes.")
+            return "\n".join(lines)
+        by_kind: dict[ChangeKind, list[_Change]] = {}
+        for change in self.changes:
+            by_kind.setdefault(change.kind, []).append(change)
+        for kind in ChangeKind:
+            group = by_kind.get(kind)
+            if not group:
+                continue
+            lines.append("")
+            lines.append(f"## {kind.value} ({len(group)})")
+            lines.extend(f"- `{change.path}`: {change.detail}" for change in group)
+        return "\n".join(lines)
+
+    def gated_by(self, level: Bump | str) -> bool:
+        """Return whether the recommended bump is at least as severe as `level`.
+
+        Parameters:
+            level: The threshold level, as a `Bump` member or its string value.
+
+        Returns:
+            Whether the recommendation meets or exceeds the threshold.
+        """
+        if isinstance(level, str):
+            level = Bump(level)
+        return _SEVERITY[self.bump] >= _SEVERITY[level]
+
+    def bump_version(self, version: str) -> str:
+        """Return `version` bumped by the recommended level.
+
+        Parameters:
+            version: A `major.minor.patch` version string, optionally with a
+                pre-release or build suffix.
+
+        Returns:
+            The bumped version, with any suffix dropped.
+
+        Raises:
+            ValueError: If `version` is not a valid `major.minor.patch` string.
+        """
+        match = _VERSION.fullmatch(version)
+        if match is None:
+            raise ValueError(f"invalid version: {version!r}")
+        major = int(match.group("major"))
+        minor = int(match.group("minor"))
+        patch = int(match.group("patch"))
+        if self.bump is Bump.MAJOR:
+            return f"{major + 1}.0.0"
+        if self.bump is Bump.MINOR:
+            return f"{major}.{minor + 1}.0"
+        return f"{major}.{minor}.{patch + 1}"
+
+    def as_dict(self, **kwargs: Any) -> dict[str, Any]:  # noqa: ARG002
+        """Return this report's data as a dictionary.
+
+        Parameters:
+            **kwargs: Additional serialization options.
+
+        Returns:
+            A JSON-serializable dictionary.
+        """
+        return {
+            "bump": self.bump.value,
+            "breaking": [change.as_dict() for change in self.changes_of_kind(ChangeKind.BREAKING)],
+            "additions": self.additions,
+            "removals": self.removals,
+            "expansions": self.expansions,
+            "deprecations": self.deprecations,
+            "counts": self.counts,
+            "changes": [change.as_dict() for change in self.changes],
+        }
+
+
+def _iter_public(
+    obj: Object,
+    path: str,
+    seen: frozenset[str] = frozenset(),
+) -> Iterator[tuple[str, Object]]:
+    """Yield `(path, object)` for every public path that reaches an object.
+
+    Aliases are followed to their targets; unresolved aliases are skipped so a
+    broken re-export never aborts the whole walk. A re-exported class or module
+    is descended into under its exported path, so nested members behind a
+    re-export are reachable under the name a caller actually sees. Every export
+    of an object is yielded, not just the first one found: picking which of them
+    to compare under is `_public_index`'s job, and it must not depend on the
+    order the imports happen to appear in. `seen` holds the canonical targets
+    already entered on the current branch, which stops an alias cycle without
+    hiding a second, equally public export.
+    """
+    for name, member in obj.members.items():
+        if not member.is_public:
+            continue
+        member_path = f"{path}.{name}"
+        if member.is_alias:
+            try:
+                target = member.final_target  # ty:ignore[unresolved-attribute]
+            except (AliasResolutionError, CyclicAliasError):
+                continue
+        else:
+            target = member
+        yield member_path, target  # ty:ignore[invalid-yield]
+        if (target.is_module or target.is_class) and target.path not in seen:
+            yield from _iter_public(target, member_path, seen | {target.path})
+
+
+def _relative(path: str) -> str:
+    """Drop the leading package component so two versions compare by identity.
+
+    Only the first dotted segment is dropped: every object path begins with the
+    name the package was loaded under, so this makes the comparison independent
+    of that name, whether the path comes from the old model, the new model or a
+    breakage record.
+    """
+    _, _, rest = path.partition(".")
+    return rest or path
+
+
+def _index_key(path: str) -> tuple[int, str]:
+    """Rank an exported path: fewest segments first, then alphabetically."""
+    return (path.count(".") + 1, path)
+
+
+def _public_index(module: Module, ignore: frozenset[str]) -> dict[str, Object]:
+    """Map every public object's exported, package-relative path to the object.
+
+    Keys are the paths under which the objects are exposed, relative to the
+    package name, so the comparison follows the public surface users import. A
+    re-exported object is tracked under the exported name rather than the
+    canonical definition path its target carries.
+
+    An object can be exported under several names. Only one of them is compared,
+    chosen from the surviving paths by fewest segments and then alphabetically,
+    so the choice is the same in both models however the imports happen to be
+    ordered, and so a shorter re-export always wins over the definition site.
+    Names in `ignore` are dropped before that choice is made, which keeps an
+    ignored alias from deciding the path of an object still exported elsewhere.
+    """
+    candidates: dict[str, list[str]] = {}
+    targets: dict[str, Object] = {}
+    for public_path, target in _iter_public(module, module.name):
+        relative = _relative(public_path)
+        if relative.split(".", 1)[0] in ignore:
+            continue
+        candidates.setdefault(target.path, []).append(relative)
+        targets[target.path] = target
+    result: dict[str, Object] = {}
+    for canonical, paths in candidates.items():
+        result[min(paths, key=_index_key)] = targets[canonical]
+    return result
+
+
+def _is_optional(parameter: Any) -> bool:
+    """Return whether a parameter can be omitted by a caller."""
+    return parameter.kind in _VARIADIC_KINDS or parameter.default is not None
+
+
+def _signature_expanded(old: Function, new: Function) -> str | None:
+    """Return a detail string when `new`'s signature compatibly expands `old`.
+
+    A compatible expansion keeps every old parameter callable the same way and
+    either adds only optional parameters, newly accepts arbitrary extra
+    arguments through a variadic the old signature lacked, or relaxes an
+    already-present required parameter to optional by giving it a default. Any
+    change that could break an existing call is left to the breaking-change
+    detector instead.
+    """
+    old_params = {parameter.name: parameter for parameter in old.parameters}
+    new_params = {parameter.name: parameter for parameter in new.parameters}
+
+    for name, parameter in old_params.items():
+        if name not in new_params:
+            return None
+        if new_params[name].kind is not parameter.kind:
+            return None
+
+    added = {
+        name: parameter
+        for name, parameter in new_params.items()
+        if name not in old_params
+    }
+    if any(not _is_optional(parameter) for parameter in added.values()):
+        return None
+
+    optionals = sorted(
+        name
+        for name, parameter in added.items()
+        if parameter.kind not in _VARIADIC_KINDS
+    )
+    variadics = sorted(
+        parameter.kind.value
+        for parameter in added.values()
+        if parameter.kind in _VARIADIC_KINDS
+    )
+    relaxed = sorted(
+        name
+        for name, parameter in new_params.items()
+        if name in old_params
+        and _is_optional(parameter)
+        and not _is_optional(old_params[name])
+    )
+    if not optionals and not variadics and not relaxed:
+        return None
+
+    parts = []
+    if optionals:
+        parts.append("optional parameters " + ", ".join(optionals))
+    if variadics:
+        parts.append("variadic " + ", ".join(variadics))
+    if relaxed:
+        parts.append("relaxed parameters " + ", ".join(relaxed))
+    return "added " + " and ".join(parts)
+
+
+def _base_names(cls: Class) -> list[str]:
+    """Return the string names of a class's declared bases."""
+    return [str(base) for base in cls.bases]
+
+
+def _bases_expanded(old: Class, new: Class) -> str | None:
+    """Return a detail string when `new` only adds bases to `old`, else None.
+
+    Adding a base class widens what a class provides without breaking existing
+    use, so it is a compatible expansion. Removing or reordering bases is left
+    to the breaking-change detector.
+    """
+    old_bases = _base_names(old)
+    new_bases = _base_names(new)
+    if old_bases == new_bases:
+        return None
+    kept = [base for base in new_bases if base in old_bases]
+    if kept != old_bases:
+        # A base disappeared, or the surviving ones were reordered. Base order
+        # drives the method resolution order, so neither is a class that only
+        # added bases.
+        return None
+    gained = [base for base in new_bases if base not in old_bases]
+    if not gained:
+        return None
+    return "added bases " + ", ".join(gained)
+
+
+def _annotation_added(old: Object, new: Object) -> str | None:
+    """Return a detail string when `new` declares an annotation `old` lacked.
+
+    A function gaining a return annotation, or an attribute gaining a type
+    annotation, adds type information for callers without changing behavior, so
+    it is treated as a compatible expansion.
+    """
+    for attribute, label in (("returns", "return annotation"), ("annotation", "type annotation")):
+        old_value = getattr(old, attribute, None)
+        new_value = getattr(new, attribute, None)
+        if old_value is None and new_value is not None:
+            return f"declared {label}"
+    return None
+
+
+def _compatible_expansion(old: Object, new: Object) -> str | None:
+    """Return a detail string when `new` compatibly expands `old`, else None.
+
+    Dispatches on the object kind: function signatures, class bases and newly
+    declared annotations each contribute a compatible expansion.
+    """
+    if old.is_function and new.is_function:
+        detail = _signature_expanded(old, new)  # ty:ignore[invalid-argument-type]
+        if detail is not None:
+            return detail
+    if old.is_class and new.is_class:
+        detail = _bases_expanded(old, new)  # ty:ignore[invalid-argument-type]
+        if detail is not None:
+            return detail
+    return _annotation_added(old, new)
+
+
+def _is_deprecated(obj: Object) -> bool:
+    """Return whether an object carries a recognized deprecation decorator."""
+    decorators = getattr(obj, "decorators", None) or ()
+    for decorator in decorators:
+        path = decorator.callable_path
+        if path in _DEPRECATION_DECORATORS:
+            return True
+        if path is not None and path.rsplit(".", 1)[-1] == "deprecated":
+            return True
+    return False
+
+
+def _deprecation_added(old: Object, new: Object) -> str | None:
+    """Return a detail string when `new` is deprecated and `old` was not."""
+    if _is_deprecated(new) and not _is_deprecated(old):
+        return "marked as deprecated"
+    return None
+
+
+def _kind_label(obj: Object) -> str:
+    """Return a kind label for change details, refined by object labels."""
+    if obj.is_module:
+        return "module"
+    if obj.is_class:
+        return "class"
+    if obj.is_function:
+        labels = getattr(obj, "labels", None) or set()
+        for refined in ("property", "classmethod", "staticmethod"):
+            if refined in labels:
+                return refined
+        return "function"
+    if getattr(obj, "is_type_alias", False):
+        return "type alias"
+    return "attribute"
+
+
+def _breakage_detail(breakage: Breakage) -> str:
+    """Return a detail string for a breakage, naming the parameter involved.
+
+    Parameter-level breakages carry the affected parameter in their old or new
+    value; naming it keeps two breakages of the same kind on the same function
+    distinguishable in the change list.
+    """
+    for value in (breakage.old_value, breakage.new_value):
+        name = getattr(value, "name", None)
+        if name:
+            return f"{breakage.kind.value}: {name}"
+    return breakage.kind.value
+
+
+def _dedupe(changes: list[_Change]) -> list[_Change]:
+    """Drop changes that are identical in kind, path and detail, keeping order."""
+    seen: set[_Change] = set()
+    unique: list[_Change] = []
+    for change in changes:
+        if change in seen:
+            continue
+        seen.add(change)
+        unique.append(change)
+    return unique
+
+
+def bump_between(
+    package: str,
+    old_path: str,
+    new_path: str,
+    *,
+    ignore: Iterable[str] = (),
+    search_paths: Iterable[str] = (),
+    **load_options: Any,
+) -> BumpReport:
+    """Load two versions of a package and recommend a bump between them.
+
+    Each version is located by its own path, and any extra search paths are
+    added to both loads so shared dependencies resolve the same way for each.
+
+    Parameters:
+        package: The package name to load from each path.
+        old_path: Search path for the old version.
+        new_path: Search path for the new version.
+        ignore: Top-level public names to exclude from the comparison.
+        search_paths: Extra search paths added to both loads.
+        **load_options: Extra options forwarded to the loader.
+
+    Returns:
+        The bump report.
+    """
+    from griffe._internal.loader import load  # noqa: PLC0415
+
+    shared = list(search_paths)
+    old = load(package, search_paths=[old_path, *shared], **load_options)
+    new = load(package, search_paths=[new_path, *shared], **load_options)
+    return recommend_bump(old, new, ignore=ignore)  # ty:ignore[invalid-argument-type]
+
+
+def recommend_bump(
+    old: Module,
+    new: Module,
+    *,
+    ignore: Iterable[str] = (),
+) -> BumpReport:
+    """Recommend a semantic version bump between two versions of a package.
+
+    A breaking change or a removed public object recommends `Bump.MAJOR`. A
+    public object added, or a public object that gained a backward-compatible
+    capability without breaking callers, recommends `Bump.MINOR`. Anything else,
+    including private additions and docstring-only edits, recommends
+    `Bump.PATCH`. Objects are compared by their exported path relative to the
+    package name, and nested members of classes and submodules are compared too.
+    A change already reported as breaking is not counted again.
+
+    Parameters:
+        old: The older version of the package.
+        new: The newer version of the package.
+        ignore: Top-level public names to exclude from the comparison.
+
+    Returns:
+        The bump report.
+    """
+    ignored = frozenset(ignore)
+    breaking = list(find_breaking_changes(old, new))
+
+    old_index = _public_index(old, ignored)
+    new_index = _public_index(new, ignored)
+
+    to_surface = {_relative(obj.path): path for path, obj in old_index.items()}
+    to_surface.update({_relative(obj.path): path for path, obj in new_index.items()})
+
+    def _surface(obj: Object) -> str:
+        relative = _relative(obj.path)
+        return to_surface.get(relative, relative)
+
+    breaking = [
+        breakage
+        for breakage in breaking
+        if _surface(breakage.obj).split(".", 1)[0] not in ignored
+    ]
+    breaking_paths = {_surface(breakage.obj) for breakage in breaking}
+
+    changes: list[_Change] = [
+        _Change(ChangeKind.BREAKING, _surface(breakage.obj), _breakage_detail(breakage))
+        for breakage in breaking
+    ]
+    def _under_breakage(path: str) -> bool:
+        """Whether a breaking change to an ancestor already covers this path.
+
+        Deleting a class, or changing its kind, takes its members with it. The
+        breakage is reported once against the container, so a member that only
+        disappeared because of it is neither a removal of its own nor an
+        addition somewhere else.
+        """
+        return any(path.startswith(f"{prefix}.") for prefix in breaking_paths)
+
+    for path, old_obj in old_index.items():
+        if path not in new_index and path not in breaking_paths and not _under_breakage(path):
+            changes.append(
+                _Change(ChangeKind.REMOVED, path, f"public {_kind_label(old_obj)} removed"),
+            )
+    for path, obj in new_index.items():
+        if _under_breakage(path):
+            continue
+        if path not in old_index:
+            changes.append(
+                _Change(ChangeKind.ADDED, path, f"public {_kind_label(obj)} added"),
+            )
+            continue
+        if path in breaking_paths:
+            continue
+        old_obj = old_index[path]
+        detail = _compatible_expansion(old_obj, obj)
+        if detail is not None:
+            changes.append(_Change(ChangeKind.EXPANDED, path, detail))
+        deprecation = _deprecation_added(old_obj, obj)
+        if deprecation is not None:
+            changes.append(_Change(ChangeKind.DEPRECATED, path, deprecation))
+
+    changes = _dedupe(changes)
+    changes.sort(key=lambda change: (change.path, change.kind.value))
+
+    bump = Bump.PATCH
+    for change in changes:
+        if _SEVERITY[change.severity] > _SEVERITY[bump]:
+            bump = change.severity
+    if breaking:
+        bump = Bump.MAJOR
+
+    return BumpReport(bump, breaking, changes)
