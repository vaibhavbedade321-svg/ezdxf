index 0000000..c96ac43
--- /dev/null
+++ b/packages/griffelib/src/griffe/_internal/overrides.py
@@ -0,0 +1,437 @@
+# This module checks method overrides for signature compatibility.
+# A subclass method that cannot be substituted for the method it overrides
+# breaks callers that hold the parent type.
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from griffe._internal.enumerations import OverrideIssueKind, ParameterKind
+from griffe._internal.exceptions import AliasResolutionError, CyclicAliasError
+
+if TYPE_CHECKING:
+    from collections.abc import Iterator
+
+    from griffe._internal.models import Class, Function, Module, Object
+
+
+_KEYWORD_KINDS = frozenset(
+    {
+        ParameterKind.positional_or_keyword,
+        ParameterKind.keyword_only,
+    },
+)
+_POSITIONAL_KINDS = frozenset(
+    {
+        ParameterKind.positional_only,
+        ParameterKind.positional_or_keyword,
+    },
+)
+_IMPLICIT_STATICMETHODS = frozenset({"__new__"})
+_IMPLICIT_CLASSMETHODS = frozenset({"__init_subclass__", "__class_getitem__"})
+_FLAVOR_LABELS = frozenset({"staticmethod", "classmethod"})
+
+
+class OverrideIssue:
+    """An incompatibility between a method and the method it overrides."""
+
+    def __init__(
+        self,
+        kind: OverrideIssueKind,
+        method_path: str,
+        base_path: str,
+        details: str = "",
+    ) -> None:
+        """Initialize the issue.
+
+        Parameters:
+            kind: The kind of incompatibility.
+            method_path: The path of the overriding method.
+            base_path: The path of the overridden method.
+            details: Additional details about the incompatibility.
+        """
+        self.kind = kind
+        """The kind of incompatibility."""
+        self.method_path = method_path
+        """The path of the overriding method."""
+        self.base_path = base_path
+        """The path of the overridden method."""
+        self.details = details
+        """Additional details about the incompatibility."""
+
+    def __str__(self) -> str:
+        return self.explain()
+
+    def explain(self) -> str:
+        """Explain the incompatibility with a one-line human-readable message.
+
+        Returns:
+            A message naming both paths and the incompatibility.
+        """
+        text = f"{self.method_path}: {self.kind.value} (overrides {self.base_path})"
+        if self.details:
+            text += f": {self.details}"
+        return text
+
+    def __repr__(self) -> str:
+        return f"OverrideIssue(kind={self.kind.name}, method_path={self.method_path!r})"
+
+    def as_dict(self, **kwargs: Any) -> dict[str, Any]:  # noqa: ARG002
+        """Return this issue's data as a dictionary.
+
+        Parameters:
+            **kwargs: Additional serialization options.
+
+        Returns:
+            A dictionary.
+        """
+        return {
+            "kind": self.kind,
+            "method_path": self.method_path,
+            "base_path": self.base_path,
+        }
+
+
+def _has_var_positional(func: Function) -> bool:
+    return any(parameter.kind is ParameterKind.var_positional for parameter in func.parameters)
+
+
+def _has_var_keyword(func: Function) -> bool:
+    return any(parameter.kind is ParameterKind.var_keyword for parameter in func.parameters)
+
+
+def _positional_names(func: Function) -> list[str]:
+    return [parameter.name for parameter in func.parameters if parameter.kind in _POSITIONAL_KINDS]
+
+
+def _positional_parameters(func: Function) -> list:
+    return [parameter for parameter in func.parameters if parameter.kind in _POSITIONAL_KINDS]
+
+
+def _positional_pairs(child: Function, parent: Function) -> dict[str, Any]:
+    """Pair the parent's positional-only parameters with the child's by position.
+
+    A positional-only parameter cannot be named by a caller, so only its
+    position matters and renaming it is compatible. Every other parameter is
+    matched by name.
+
+    Parameters:
+        child: The overriding function.
+        parent: The overridden function.
+
+    Returns:
+        A mapping from parent parameter name to the child parameter at the
+        same positional index, for positional-only parent parameters only.
+    """
+    child_positional = _positional_parameters(child)
+    pairs = {}
+    for index, parameter in enumerate(_positional_parameters(parent)):
+        if parameter.kind is ParameterKind.positional_only and index < len(child_positional):
+            pairs[parameter.name] = child_positional[index]
+    return pairs
+
+
+def _compare_signatures(
+    child: Function,
+    parent: Function,
+) -> Iterator[tuple[OverrideIssueKind, str]]:
+    child_names = {parameter.name for parameter in child.parameters}
+    child_var_positional = _has_var_positional(child)
+    child_var_keyword = _has_var_keyword(child)
+    positional_pairs = _positional_pairs(child, parent)
+    paired_child_names = {parameter.name for parameter in positional_pairs.values()}
+
+    for parameter in parent.parameters:
+        if parameter.kind is ParameterKind.var_positional:
+            if not child_var_positional:
+                yield (
+                    OverrideIssueKind.VARIADIC_REMOVED,
+                    f"*{parameter.name} is not accepted anymore",
+                )
+            continue
+        if parameter.kind is ParameterKind.var_keyword:
+            if not child_var_keyword:
+                yield (
+                    OverrideIssueKind.VARIADIC_REMOVED,
+                    f"**{parameter.name} is not accepted anymore",
+                )
+            continue
+
+        counterpart = positional_pairs.get(parameter.name)
+        if counterpart is None and parameter.name in child_names:
+            counterpart = child.parameters[parameter.name]
+        if counterpart is None:
+            if parameter.kind is ParameterKind.positional_only:
+                absorbed = child_var_positional
+            elif parameter.kind is ParameterKind.keyword_only:
+                absorbed = child_var_keyword
+            else:
+                absorbed = child_var_positional and child_var_keyword
+            if not absorbed:
+                yield (
+                    OverrideIssueKind.PARAMETER_REMOVED,
+                    f"parameter {parameter.name} is not accepted anymore",
+                )
+            continue
+
+        child_parameter = counterpart
+        if parameter.kind in _KEYWORD_KINDS and child_parameter.kind is ParameterKind.positional_only:
+            yield (
+                OverrideIssueKind.PARAMETER_CHANGED_KIND,
+                f"parameter {parameter.name} cannot be passed by keyword anymore",
+            )
+        elif parameter.kind in _POSITIONAL_KINDS and child_parameter.kind is ParameterKind.keyword_only:
+            yield (
+                OverrideIssueKind.PARAMETER_CHANGED_KIND,
+                f"parameter {parameter.name} cannot be passed positionally anymore",
+            )
+
+        if parameter.default is not None and child_parameter.default is None:
+            yield (
+                OverrideIssueKind.PARAMETER_NOW_REQUIRED,
+                f"parameter {parameter.name} lost its default value",
+            )
+
+    parent_names = {parameter.name for parameter in parent.parameters}
+    for parameter in child.parameters:
+        if parameter.kind in (ParameterKind.var_positional, ParameterKind.var_keyword):
+            continue
+        if parameter.name in parent_names or parameter.name in paired_child_names:
+            continue
+        if parameter.default is None:
+            yield (
+                OverrideIssueKind.PARAMETER_ADDED_REQUIRED,
+                f"new parameter {parameter.name} has no default value",
+            )
+
+    parent_positional = _positional_names(parent)
+    child_positional = _positional_names(child)
+    common = [name for name in parent_positional if name in child_positional]
+    reordered = [name for name in child_positional if name in common]
+    if common != reordered:
+        yield (
+            OverrideIssueKind.PARAMETER_MOVED,
+            "positional parameters were reordered: " + ", ".join(common) + " became " + ", ".join(reordered),
+        )
+
+
+def _iter_override_pairs(cls: Class) -> Iterator[tuple[Object, Object]]:
+    try:
+        ancestors = cls.mro()
+    except (AliasResolutionError, CyclicAliasError):
+        return
+    for name, member in cls.members.items():
+        if member.is_alias or not (member.is_function or member.is_attribute):
+            continue
+        for ancestor in ancestors:
+            base_member = ancestor.members.get(name)
+            if base_member is None or base_member.is_alias:
+                continue
+            if base_member.is_function or base_member.is_attribute:
+                yield member, base_member  # ty:ignore[invalid-yield]
+            break
+
+
+def _iter_classes(obj: Module | Object) -> Iterator[Class]:
+    for member in obj.members.values():
+        if member.is_alias:
+            continue
+        if member.is_class:
+            yield member  # ty:ignore[invalid-yield]
+            yield from _iter_classes(member)
+        elif member.is_module:
+            yield from _iter_classes(member)
+
+
+def _bases_resolvable(cls: Class) -> bool:
+    """Whether every declared base of the class resolves to a known object.
+
+    `Class.resolved_bases` silently drops bases it cannot resolve, so a class
+    with a mix of resolved and unresolved bases would otherwise be analyzed
+    against an incomplete method resolution order. Such a class is skipped.
+    """
+    try:
+        return len(cls.resolved_bases) == len(cls.bases)
+    except (AliasResolutionError, CyclicAliasError):
+        return False
+
+
+def _iter_inherited_conflicts(cls: Class) -> Iterator[tuple[Object, Object]]:
+    """Yield the pairs a class inherits from two ancestors without redefining.
+
+    When a class inherits the same name from several ancestors, the method
+    resolution order picks one definition and shadows the others. Callers
+    holding a shadowed ancestor's type still expect that ancestor's signature,
+    so the winner must be able to substitute for each definition it shadows.
+
+    Parameters:
+        cls: The class to inspect.
+
+    Yields:
+        Pairs of shadowing and shadowed members.
+    """
+    try:
+        ancestors = cls.mro()
+    except (AliasResolutionError, CyclicAliasError):
+        return
+    definitions: dict[str, list[Object]] = {}
+    for ancestor in ancestors:
+        for name, member in ancestor.members.items():
+            if name in cls.members or member.is_alias:
+                continue
+            if not (member.is_function or member.is_attribute):
+                continue
+            definitions.setdefault(name, []).append(member)  # ty:ignore[invalid-argument-type]
+    for members in definitions.values():
+        winner = members[0]
+        for shadowed in members[1:]:
+            yield winner, shadowed
+
+
+def _check_pair(child: Object, parent: Object) -> Iterator[OverrideIssue]:
+    """Compare one overriding member against the member it overrides.
+
+    Parameters:
+        child: The overriding member.
+        parent: The overridden member.
+
+    Yields:
+        The incompatibilities between the two members.
+    """
+    if child.name.startswith("__") and not child.name.endswith("__"):
+        return
+    if child.is_function is not parent.is_function:
+        yield OverrideIssue(
+            OverrideIssueKind.KIND_CHANGED,
+            child.path,
+            parent.path,
+            details=f"{_member_kind(parent)} became {_member_kind(child)}",
+        )
+        return
+    if not child.is_function:
+        if (
+            "property" in parent.labels
+            and "property" in child.labels
+            and "writable" in parent.labels
+            and "writable" not in child.labels
+        ):
+            yield OverrideIssue(
+                OverrideIssueKind.SETTER_REMOVED,
+                child.path,
+                parent.path,
+                details=f"property {child.name} is read-only now",
+            )
+        return
+    child_flavors = _flavors(child)
+    parent_flavors = _flavors(parent)
+    if child_flavors != parent_flavors:
+        yield OverrideIssue(
+            OverrideIssueKind.FLAVOR_CHANGED,
+            child.path,
+            parent.path,
+            details=(
+                f"{', '.join(sorted(parent_flavors)) or 'regular method'}"
+                f" became {', '.join(sorted(child_flavors)) or 'regular method'}"
+            ),
+        )
+        return
+    implicit = child.name in _IMPLICIT_STATICMETHODS or child.name in _IMPLICIT_CLASSMETHODS
+    skip_first = implicit or not child_flavors or "classmethod" in child_flavors
+    child_view = _without_first_parameter(child) if skip_first else child
+    parent_view = _without_first_parameter(parent) if skip_first else parent
+    for kind, details in _compare_signatures(child_view, parent_view):
+        yield OverrideIssue(kind, child.path, parent.path, details=details)
+
+
+def check_overrides(package: Module) -> list[OverrideIssue]:
+    """Check every method override of a package for signature compatibility.
+
+    For each class, every method that overrides a method of an ancestor
+    (following the method resolution order) is compared against the nearest
+    overridden definition, and every name inherited from several ancestors
+    without being redefined is compared against the definitions it shadows.
+    An override is incompatible when it cannot be called with the arguments
+    its ancestor accepts: a parameter disappeared without being absorbed by a
+    variadic, a parameter can no longer be passed by keyword or positionally,
+    a parameter lost its default value, a new parameter without default was
+    added, positional parameters were reordered, or a variadic disappeared.
+    Methods whose names start with a double underscore, except dunders, are
+    excluded, as are staticmethods and classmethods compared against a
+    different flavor.
+
+    Parameters:
+        package: The loaded package to check.
+
+    Returns:
+        The incompatibilities found, sorted by method path then kind.
+    """
+    issues: list[OverrideIssue] = []
+    seen: set[tuple] = set()
+    for cls in _iter_classes(package):
+        if not _bases_resolvable(cls):
+            continue
+        pairs = list(_iter_override_pairs(cls)) + list(_iter_inherited_conflicts(cls))
+        for child, parent in pairs:
+            for issue in _check_pair(child, parent):
+                key = (issue.kind, issue.method_path, issue.base_path, issue.details)
+                if key in seen:
+                    continue
+                seen.add(key)
+                issues.append(issue)
+    issues.sort(key=lambda issue: (issue.method_path, issue.kind.name))
+    return issues
+
+
+def _flavors(func: Object) -> set[str]:
+    """Return the flavor labels of a method, including the implicit ones.
+
+    Python makes `__new__` a staticmethod and `__init_subclass__` and
+    `__class_getitem__` classmethods whether or not they carry the decorator,
+    so the decorator alone must not be read as a flavor change.
+
+    Parameters:
+        func: The method to inspect.
+
+    Returns:
+        The flavor labels, at most one of which is present.
+    """
+    if func.name in _IMPLICIT_STATICMETHODS:
+        return {"staticmethod"}
+    if func.name in _IMPLICIT_CLASSMETHODS:
+        return {"classmethod"}
+    return set(_FLAVOR_LABELS & func.labels)
+
+
+def _member_kind(obj: Object) -> str:
+    if obj.is_function:
+        return "a method"
+    if "property" in obj.labels:
+        return "a property"
+    return "an attribute"
+
+
+class _FunctionView:
+    """A lightweight view of a function with its first parameter removed."""
+
+    def __init__(self, func: Function) -> None:
+        self.name = func.name
+        self.path = func.path
+        self.parameters = _ParametersView(list(func.parameters)[1:])
+
+
+class _ParametersView:
+    def __init__(self, parameters: list) -> None:
+        self._parameters = parameters
+        self._by_name = {parameter.name: parameter for parameter in parameters}
+
+    def __iter__(self):
+        return iter(self._parameters)
+
+    def __getitem__(self, name: str):
+        return self._by_name[name]
+
+
+def _without_first_parameter(func: Function) -> Function:
+    if not list(func.parameters):
+        return func
+    return _FunctionView(func)  # ty:ignore[invalid-return-type]
