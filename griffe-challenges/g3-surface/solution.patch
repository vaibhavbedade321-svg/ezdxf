index 0000000..9fdf581
--- /dev/null
+++ b/packages/griffelib/src/griffe/_internal/surface.py
@@ -0,0 +1,478 @@
+# This module computes the public API surface of a package and audits it.
+# Re-export chains are resolved to their final targets so the audit sees
+# the objects a user actually reaches through public paths.
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from griffe._internal.enumerations import SurfaceIssueKind
+from griffe._internal.exceptions import AliasResolutionError, CyclicAliasError, NameResolutionError
+from griffe._internal.expressions import Expr, ExprDict, ExprList, ExprName, ExprSet
+
+if TYPE_CHECKING:
+    from collections.abc import Iterator
+
+    from griffe._internal.models import Alias, Module, Object
+
+
+class SurfaceIssue:
+    """An issue found while auditing the public surface of a package."""
+
+    def __init__(
+        self,
+        kind: SurfaceIssueKind,
+        public_path: str,
+        details: str = "",
+    ) -> None:
+        """Initialize the issue.
+
+        Parameters:
+            kind: The kind of issue.
+            public_path: The public path at which the issue appears.
+            details: Additional details about the issue.
+        """
+        self.kind = kind
+        """The kind of issue."""
+        self.public_path = public_path
+        """The public path at which the issue appears."""
+        self.details = details
+        """Additional details about the issue."""
+
+    def __str__(self) -> str:
+        text = f"{self.public_path}: {self.kind.value}"
+        if self.details:
+            text += f": {self.details}"
+        return text
+
+    def __repr__(self) -> str:
+        return f"SurfaceIssue(kind={self.kind.name}, public_path={self.public_path!r})"
+
+    def as_dict(self, **kwargs: Any) -> dict[str, Any]:  # noqa: ARG002
+        """Return this issue's data as a dictionary.
+
+        Parameters:
+            **kwargs: Additional serialization options.
+
+        Returns:
+            A dictionary.
+        """
+        data: dict[str, Any] = {
+            "kind": self.kind,
+            "public_path": self.public_path,
+        }
+        if self.details:
+            data["details"] = self.details
+        return data
+
+
+class SurfaceReport:
+    """The result of auditing a package's public surface."""
+
+    def __init__(
+        self,
+        package: str,
+        issues: list[SurfaceIssue],
+        canonical_paths: dict[str, str],
+    ) -> None:
+        """Initialize the report.
+
+        Parameters:
+            package: The name of the audited package.
+            issues: The issues found.
+            canonical_paths: A mapping from object canonical paths to their
+                chosen canonical public path.
+        """
+        self.package = package
+        """The name of the audited package."""
+        self.issues = issues
+        """The issues found."""
+        self.canonical_paths = canonical_paths
+        """The chosen canonical public path per reachable object."""
+
+    def issues_of_kind(self, kind: SurfaceIssueKind) -> list[SurfaceIssue]:
+        """Return the issues of the given kind.
+
+        Parameters:
+            kind: The kind to filter on.
+
+        Returns:
+            The matching issues.
+        """
+        return [issue for issue in self.issues if issue.kind is kind]
+
+    def filter(self, *kinds: SurfaceIssueKind) -> SurfaceReport:
+        """Return a report keeping only the issues of the given kinds.
+
+        Parameters:
+            *kinds: The kinds to keep.
+
+        Returns:
+            A new report over the matching issues.
+        """
+        keep = set(kinds)
+        kept = [issue for issue in self.issues if issue.kind in keep]
+        return SurfaceReport(self.package, kept, self.canonical_paths)
+
+    @property
+    def affected_paths(self) -> list[str]:
+        """The distinct public paths carrying at least one issue, sorted."""
+        return sorted({issue.public_path for issue in self.issues})
+
+    def summary(self) -> str:
+        """Return a one-line summary naming the package and issue count.
+
+        Returns:
+            A single-line message; a clean surface says so.
+        """
+        total = len(self.issues)
+        if not total:
+            return f"{self.package}: clean"
+        return f"{self.package}: {total} issues in {len(self.counts)} categories"
+
+    @property
+    def counts(self) -> dict[str, int]:
+        """The number of issues per category, for categories that have issues."""
+        result: dict[str, int] = {}
+        for issue in self.issues:
+            result[issue.kind.name] = result.get(issue.kind.name, 0) + 1
+        return result
+
+    def render_text(self) -> str:
+        """Render the report as grouped, human-readable text.
+
+        Issues are grouped by category, each group preceded by the category
+        description and its count, and an empty report renders as a single
+        line saying the surface is clean.
+
+        Returns:
+            The rendered report.
+        """
+        if not self.issues:
+            return f"{self.package}: public API surface is clean"
+        lines = []
+        for kind in SurfaceIssueKind:
+            group = self.issues_of_kind(kind)
+            if not group:
+                continue
+            if lines:
+                lines.append("")
+            lines.append(f"{kind.value} ({len(group)})")
+            for issue in group:
+                line = f"  {issue.public_path}"
+                if issue.details:
+                    line += f": {issue.details}"
+                lines.append(line)
+        return "\n".join(lines)
+
+    def render_markdown(self) -> str:
+        """Render the report as Markdown.
+
+        Issues are grouped under one heading per category with the issue
+        count, one bullet per issue. A clean surface renders as a single
+        paragraph saying the surface is clean.
+
+        Returns:
+            The Markdown report.
+        """
+        if not self.issues:
+            return f"**{self.package}**: public API surface is clean"
+        lines: list[str] = [f"# API surface report: {self.package}", ""]
+        current: SurfaceIssueKind | None = None
+        for issue in self.issues:
+            if issue.kind is not current:
+                current = issue.kind
+                lines.append(f"## {current.value} ({self.counts[current.name]})")
+                lines.append("")
+            entry = f"- `{issue.public_path}`"
+            if issue.details:
+                entry += f": {issue.details}"
+            lines.append(entry)
+        return "\n".join(lines)
+
+    def as_dict(self, **kwargs: Any) -> dict[str, Any]:
+        """Return this report's data as a dictionary.
+
+        Parameters:
+            **kwargs: Additional serialization options.
+
+        Returns:
+            A dictionary.
+        """
+        return {
+            "package": self.package,
+            "issues": [issue.as_dict(**kwargs) for issue in self.issues],
+            "counts": self.counts,
+            "canonical_paths": self.canonical_paths,
+        }
+
+
+def _module_is_private(module_path: str, package: str) -> bool:
+    parts = module_path.split(".")
+    if parts and parts[0] == package:
+        parts = parts[1:]
+    return any(part.startswith("_") for part in parts)
+
+
+def _public_members(obj: Module | Object) -> Iterator[tuple[str, Object | Alias]]:
+    for name, member in obj.members.items():
+        if member.is_public:
+            yield name, member
+
+
+def _walk_public(
+    obj: Object | Alias,
+    public_path: str,
+    seen: frozenset[str] = frozenset(),
+) -> Iterator[tuple[str, Object | Alias]]:
+    yield public_path, obj
+    if obj.is_alias:
+        try:
+            target = obj.final_target  # ty:ignore[unresolved-attribute]
+        except (AliasResolutionError, CyclicAliasError):
+            return
+    else:
+        target = obj
+    if not (target.is_module or target.is_class):
+        return
+    # A re-exported class or module is traversed through its target so that
+    # its public members are audited under the public (alias) path. The seen
+    # set guards against cycles in self-referential re-export chains.
+    if target.canonical_path in seen:
+        return
+    seen = seen | {target.canonical_path}
+    for name, member in _public_members(target):
+        yield from _walk_public(member, f"{public_path}.{name}", seen)
+
+
+_MUTABLE_DEFAULT_CALLS = frozenset({"list()", "dict()", "set()"})
+_DELIMITER_PAIR = 2
+
+
+def _is_mutable_default(default: object) -> bool:
+    """Whether a parameter default is a shared mutable value.
+
+    Static analysis yields `ExprList`/`ExprDict`/`ExprSet` nodes, while dynamic
+    inspection stores defaults as their `repr(...)` strings; both forms are
+    recognized. List, dict and set literals (and their constructor calls) are
+    mutable and shared across calls; tuples and scalars are immutable.
+    """
+    if isinstance(default, (ExprList, ExprDict, ExprSet)):
+        return True
+    if isinstance(default, str):
+        text = default.strip()
+        if text in _MUTABLE_DEFAULT_CALLS:
+            return True
+        # `[...]` list, `{...}` dict or set literal (empty `{}` is a dict).
+        if len(text) >= _DELIMITER_PAIR and text[0] in "[{" and text[-1] in "]}":
+            return True
+    return False
+
+
+def _mutable_default_params(func: Object) -> list[str]:
+    """Return the names of parameters whose default is a mutable literal.
+
+    List, dict and set literals are shared across every call, so a mutable
+    default is a public-surface defect; tuple and scalar defaults are immutable
+    and ignored.
+    """
+    return [
+        parameter.name
+        for parameter in func.parameters
+        if _is_mutable_default(parameter.default)
+    ]
+
+
+def audit_surface(package: Module) -> SurfaceReport:
+    """Audit the public API surface of a package.
+
+    The audit resolves re-export chains to their final targets and reports:
+    exported names defined in private modules, `__all__` entries that
+    resolve to nothing, public objects without a docstring, objects
+    reachable through several public paths, public definitions missing
+    from their module's `__all__`, and mutable default arguments. When an
+    object is reachable through several public paths, the canonical path
+    is the shortest one, with ties broken alphabetically.
+
+    Parameters:
+        package: The loaded package to audit.
+
+    Returns:
+        The audit report.
+    """
+    issues: list[SurfaceIssue] = []
+    reachable: dict[str, list[str]] = {}
+    private_origins: list[tuple[str, str]] = []
+    private_origin_paths: set[str] = set()
+    signature_refs: list[tuple[str, Expr]] = []
+
+    for public_path, obj in _walk_public(package, package.name):
+        if obj.is_alias:
+            try:
+                target = obj.final_target  # ty:ignore[unresolved-attribute]
+            except CyclicAliasError:
+                continue
+            except AliasResolutionError:
+                issues.append(
+                    SurfaceIssue(
+                        SurfaceIssueKind.DANGLING_EXPORT,
+                        public_path,
+                        details=f"cannot resolve {obj.target_path}",  # ty:ignore[unresolved-attribute]
+                    ),
+                )
+                continue
+        else:
+            target = obj
+
+        reachable.setdefault(target.canonical_path, []).append(public_path)
+
+        target_module = target.module.path if not target.is_module else target.path
+        if _module_is_private(target_module, package.name) and not _module_is_private(
+            public_path,
+            package.name,
+        ):
+            # Report the re-export entry point only; nested members reached
+            # through an already-flagged private re-export are not repeated.
+            parent_path = public_path.rsplit(".", 1)[0]
+            if parent_path not in private_origin_paths:
+                private_origins.append((public_path, target.canonical_path))
+            private_origin_paths.add(public_path)
+
+        signature_refs.extend((public_path, expr) for expr in _signature_expressions(target))
+
+        if not target.docstring and (target.is_class or target.is_function or target.is_module):
+            issues.append(
+                SurfaceIssue(
+                    SurfaceIssueKind.UNDOCUMENTED,
+                    public_path,
+                    details=target.canonical_path,
+                ),
+            )
+
+        if target.is_function:
+            mutable = _mutable_default_params(target)  # ty:ignore[invalid-argument-type]
+            if mutable:
+                issues.append(
+                    SurfaceIssue(
+                        SurfaceIssueKind.MUTABLE_DEFAULT,
+                        public_path,
+                        details="mutable default(s): " + ", ".join(mutable),
+                    ),
+                )
+
+    for module_path, module in _iter_modules(package):
+        exports = module.exports
+        if exports is None:
+            continue
+        # Everything under a private module is hidden, including a broken
+        # `__all__`, so the whole module is skipped before anything is emitted.
+        if _module_is_private(module_path, package.name):
+            continue
+        export_names = {str(export) for export in exports}
+        issues.extend(
+            SurfaceIssue(
+                SurfaceIssueKind.DANGLING_EXPORT,
+                f"{module_path}.{name}",
+                details=f"listed in {module_path}.__all__ but not found",
+            )
+            for name in export_names
+            if name not in module.all_members
+        )
+        for name, member in module.members.items():
+            if name.startswith("_"):
+                continue
+            # Imported names follow griffe's publicness rule: leaving them out
+            # of `__all__` is what makes them private, so they are not flagged.
+            if member.is_alias or member.is_module:
+                continue
+            if name not in export_names:
+                issues.append(
+                    SurfaceIssue(
+                        SurfaceIssueKind.INCONSISTENT_ALL,
+                        f"{module_path}.{name}",
+                        details=f"defined in {module_path} but missing from its __all__",
+                    ),
+                )
+
+    canonical_paths: dict[str, str] = {}
+    for canonical, paths in reachable.items():
+        # Fewest path segments wins; ties are broken alphabetically.
+        chosen = min(paths, key=lambda path: (path.count("."), path))
+        canonical_paths[canonical] = chosen
+        if len(paths) > 1:
+            others = sorted(set(paths) - {chosen})
+            issues.append(
+                SurfaceIssue(
+                    SurfaceIssueKind.DUPLICATE_EXPOSURE,
+                    chosen,
+                    details="also reachable as " + ", ".join(others),
+                ),
+            )
+
+    for public_path, canonical in private_origins:
+        details = f"defined in {canonical}"
+        chosen = canonical_paths.get(canonical)
+        if chosen and chosen != public_path:
+            details += f", canonical public path is {chosen}"
+        issues.append(
+            SurfaceIssue(SurfaceIssueKind.PRIVATE_ORIGIN, public_path, details=details),
+        )
+
+
+    seen_leaks: set[tuple[str, str]] = set()
+    for public_path, expr in signature_refs:
+        for canonical in _private_references(expr, package.name):
+            if canonical in reachable or (public_path, canonical) in seen_leaks:
+                continue
+            seen_leaks.add((public_path, canonical))
+            issues.append(
+                SurfaceIssue(
+                    SurfaceIssueKind.PRIVATE_LEAK,
+                    public_path,
+                    details=f"references {canonical}",
+                ),
+            )
+
+    issues.sort(key=lambda issue: (issue.kind.name, issue.public_path))
+    return SurfaceReport(package.name, issues, canonical_paths)
+
+
+def _iter_modules(module: Module) -> Iterator[tuple[str, Module]]:
+    yield module.path, module
+    for member in module.members.values():
+        if member.is_alias:
+            continue
+        if member.is_module:
+            yield from _iter_modules(member)  # ty:ignore[invalid-argument-type]
+
+def _signature_expressions(obj: Object) -> Iterator[Expr]:
+    """Yield the annotation and base expressions of an object's public signature."""
+    if obj.is_function:
+        for parameter in obj.parameters:  # ty:ignore[unresolved-attribute]
+            if isinstance(parameter.annotation, Expr):
+                yield parameter.annotation
+        if isinstance(obj.returns, Expr):  # ty:ignore[unresolved-attribute]
+            yield obj.returns  # ty:ignore[unresolved-attribute]
+    elif obj.is_attribute:
+        if isinstance(obj.annotation, Expr):  # ty:ignore[unresolved-attribute]
+            yield obj.annotation  # ty:ignore[unresolved-attribute]
+    elif obj.is_class:
+        for base in obj.bases:  # ty:ignore[unresolved-attribute]
+            if isinstance(base, Expr):
+                yield base
+
+def _private_references(expr: Expr, package: str) -> Iterator[str]:
+    """Yield canonical paths of private-module objects referenced by an expression."""
+    nodes: list[str | Expr] = [expr] if isinstance(expr, ExprName) else list(expr.iterate(flat=True))
+    for node in nodes:
+        if not isinstance(node, ExprName):
+            continue
+        try:
+            canonical = node.canonical_path
+        except NameResolutionError:
+            continue
+        if not canonical.startswith(f"{package}."):
+            continue
+        module_path = canonical.rsplit(".", 1)[0]
+        if _module_is_private(module_path, package):
+            yield canonical
