+def test_render_text_groups_by_category_with_counts() -> None:
+    report = _audit(
+        {
+            "__init__.py": (
+                '"""Doc."""\n\ndef nodoc(): ...\n\ndef alsobad(): ...\n\n'
+                '__all__ = ["nodoc", "alsobad", "ghost"]\n'
+            ),
+        },
+    )
+    text = report.render_text()
+    assert griffe.SurfaceIssueKind.DANGLING_EXPORT.value in text
+    assert griffe.SurfaceIssueKind.UNDOCUMENTED.value in text
+    # render_text() names each category's issue count; UNDOCUMENTED has two.
+    assert "2" in text
+    assert "audpkg.ghost" in text
+    assert "audpkg.nodoc" in text
+    assert "audpkg.alsobad" in text
