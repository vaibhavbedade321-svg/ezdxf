+def test_report_as_dict_is_json_serializable() -> None:
+    report = _audit(
+        {
+            "__init__.py": '"""Doc."""\n\ndef nodoc(): ...\n',
+        },
+    )
+    payload = json.dumps(report.as_dict())
+    decoded = json.loads(payload)
+    assert decoded["package"] == "audpkg"
+    assert decoded["issues"]
+    assert "canonical_paths" in decoded
+    assert "counts" in decoded
+
