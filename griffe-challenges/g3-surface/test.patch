+def test_issues_sort_by_category_then_path() -> None:
+    report = _audit(
+        {
+            "__init__.py": (
+                '"""Doc."""\n\ndef zeta(): ...\n\ndef alpha(): ...\n\n'
+                '__all__ = ["zeta", "alpha", "ghost"]\n'
+            ),
+        },
+    )
+    keys = [(issue.kind.name, issue.public_path) for issue in report.issues]
