+def test_issues_of_kind_filters() -> None:
+    report = _audit(
+        {
+            "__init__.py": '"""Doc."""\n\ndef nodoc(): ...\n\n__all__ = ["nodoc", "ghost"]\n',
+        },
+    )
+    dangling = report.issues_of_kind(griffe.SurfaceIssueKind.DANGLING_EXPORT)
+    undocumented = report.issues_of_kind(griffe.SurfaceIssueKind.UNDOCUMENTED)
+    assert {issue.public_path for issue in dangling} == {"audpkg.ghost"}
+    assert {issue.public_path for issue in undocumented} == {"audpkg.nodoc"}
+    all_keys = sorted((issue.kind, issue.public_path) for issue in report.issues)
+    sub_keys = sorted((issue.kind, issue.public_path) for issue in [*dangling, *undocumented])
+    assert all_keys == sub_keys
+
