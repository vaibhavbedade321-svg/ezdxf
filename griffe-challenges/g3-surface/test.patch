+def test_as_dict_issue_schema_and_mappings() -> None:
+    report = _audit({"__init__.py": '"""Doc."""\n\ndef nodoc(): ...\n'})
+    payload = json.loads(json.dumps(report.as_dict()))
+    assert {"package", "issues", "counts", "canonical_paths"} <= set(payload)
+    assert payload["package"] == "audpkg"
+    for entry in payload["issues"]:
+        assert {"kind", "public_path", "details"} <= set(entry)
+    assert payload["counts"] == {"UNDOCUMENTED": 1}
+    assert all(
+        isinstance(key, str) and isinstance(value, str)
+        for key, value in payload["canonical_paths"].items()
+    )
