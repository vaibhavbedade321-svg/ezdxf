+#!/usr/bin/env bash
+set -uo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base|new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "unknown argument: $1" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [[ -z "$OUTPUT_PATH" || -z "$MODE" ]]; then
+    echo "usage: test.sh --output_path <path> {base|new}" >&2
+    exit 2
+fi
+
+cd "$(dirname "$0")/packages/griffelib"
+
+NEW_TESTS="tests/test_exposure_audit.py"
+
+case "$MODE" in
+    base)
+        API_IGNORE="--ignore=tests/test_api.py"
+        if python3 -c "import mkdocstrings, unpack_typeddict" 2>/dev/null; then
+            API_IGNORE=""
+        else
+            echo "NOTE: test_api.py skipped; mkdocstrings/unpack_typeddict unavailable" >&2
+        fi
+        python3 -m pytest tests/ -o addopts= -v \
+            --ignore=tests/test_stdlib.py \
+            $API_IGNORE \
+            --ignore="$NEW_TESTS" \
+            --junitxml="$OUTPUT_PATH"
+        ;;
+    new)
+        python3 -m pytest "$NEW_TESTS" -o addopts= -v \
+            --junitxml="$OUTPUT_PATH"
+        ;;
+esac
