+def test_reexported_class_members_are_audited_under_public_path() -> None:
+    report = _audit(
+        {
+            "__init__.py": '"""Doc."""\nfrom audpkg._impl import Widget\n\n__all__ = ["Widget"]\n',
+            "_impl.py": (
+                'class Widget:\n'
+                '    """Doc."""\n\n'
+                '    def undocumented_method(self): ...\n\n'
+                '    def bad_default(self, items=[]):\n'
+                '        """Doc."""\n'
+            ),
+        },
+    )
+    undocumented = {issue.public_path for issue in report.issues_of_kind(griffe.SurfaceIssueKind.UNDOCUMENTED)}
+    mutable = {issue.public_path for issue in report.issues_of_kind(griffe.SurfaceIssueKind.MUTABLE_DEFAULT)}
+    # Members of a re-exported class are audited under the public (alias) path.
+    assert "audpkg.Widget.undocumented_method" in undocumented
+    assert "audpkg.Widget.bad_default" in mutable
+    # The private origin is reported once, at the re-export entry point.
+    origins = {issue.public_path for issue in report.issues_of_kind(griffe.SurfaceIssueKind.PRIVATE_ORIGIN)}
+    assert origins == {"audpkg.Widget"}
+
