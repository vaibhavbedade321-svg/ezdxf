+def test_unexported_import_is_not_reported_as_inconsistent() -> None:
+    report = _audit(
+        {
+            "__init__.py": '"""Doc."""\nfrom audpkg.core import tool\n\n__all__ = []\n',
+            "core.py": '"""Doc."""\n\ndef tool():\n    """Doc."""\n\n__all__ = ["tool"]\n',
+        },
+    )
+    # Leaving an imported name out of `__all__` is what makes it private, so it
+    # is not an inconsistency; only names the module itself defines are.
+    inconsistent = {i.public_path for i in report.issues_of_kind(griffe.SurfaceIssueKind.INCONSISTENT_ALL)}
+    assert "audpkg.tool" not in inconsistent
