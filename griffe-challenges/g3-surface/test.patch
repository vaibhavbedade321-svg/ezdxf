+def test_canonical_path_prefers_shortest_then_alphabetical() -> None:
+    report = _audit(
+        {
+            "__init__.py": (
+                '"""Doc."""\n'
+                "from audpkg.beta import tool\n"
+                "from audpkg.alpha import tool as tool2\n\n"
+                '__all__ = ["tool"]\n'
+            ),
+            "alpha.py": '"""Doc."""\nfrom audpkg.beta import tool\n\n__all__ = ["tool"]\n',
+            "beta.py": '"""Doc."""\n\ndef tool():\n    """Doc."""\n\n__all__ = ["tool"]\n',
+        },
+    )
+    canonical = report.canonical_paths["audpkg.beta.tool"]
+    assert canonical == "audpkg.tool"
+
