+def test_cli_convert_rejects_auto_target_style(tmp_path) -> None:
+    # A concrete target style runs normally, which anchors the command's
+    # existence so the rejection below cannot pass for the wrong reason.
+    exit_code, _ = _run_convert(tmp_path, CLI_CODE, "-t", "numpy", "--check")
+    assert exit_code != 0
+    # `auto` is not a composable target, so the command must fail rather than
+    # silently pick a dialect. Either rejection mechanism is acceptable: an
+    # argument parser that refuses it, or a nonzero exit from the run itself.
+    try:
+        exit_code, _ = _run_convert(tmp_path, CLI_CODE, "-t", "auto")
+    except SystemExit as exc:
+        assert exc.code != 0
+    else:
+        assert exit_code != 0
+
