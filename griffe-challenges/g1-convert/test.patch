+
+def test_google_alias_titles_are_preserved_when_model_carries_them() -> None:
+    from griffe import DocstringSectionParameters
+
+    section = DocstringSectionParameters([], title="Args")
+    composed = griffe.compose([section], "google")
+    assert composed.startswith("Args:")
+
+
+def test_rewrite_source_keeps_raw_docstring_with_embedded_delimiters_valid() -> None:
+    code = (
+        dedent(
+            '''
+def f(x):
+    rQQQDoc.
+
+    Args:
+        x (int): has TTT inside and ends with "quote"
+    QQQ
+'''
+        )
+        .replace("QQQ", '"' * 3)
+        .replace("TTT", "'" * 3)
+    )
+    with temporary_visited_module(code) as module:
+        result = griffe.rewrite_source(code, module, "google", source_style="google")
+    compile(result, "<rewritten>", "exec")
+    assert "ends with" in result
+
+
+def test_rewrite_source_keeps_raw_docstring_with_trailing_backslash_valid() -> None:
+    code = (
+        dedent(
+            '''
+def f(x):
+    rQQQDoc.
+
+    Args:
+        x (int): trailing slash BSL
+    QQQ
+'''
+        )
+        .replace("QQQ", '"' * 3)
+        .replace("BSL", chr(92))
+    )
+    with temporary_visited_module(code) as module:
+        result = griffe.rewrite_source(code, module, "google", source_style="google")
+    compile(result, "<rewritten>", "exec")
+    assert "trailing slash" in result
+
+
+def test_rewrite_source_is_stable_when_already_converted() -> None:
+    code = dedent(REWRITE_CODE)
+    with temporary_visited_module(code) as module:
+        converted = griffe.rewrite_source(code, module, "numpy", source_style="google")
+    with temporary_visited_module(converted) as module:
+        converted_again = griffe.rewrite_source(converted, module, "numpy", source_style="numpy")
+    assert converted == converted_again
+
+
+def _run_convert(tmp_path, code: str, *args: str) -> tuple[int, str]:
+    import io
+    from contextlib import redirect_stdout
+
+    from griffecli import main
+
+    package = tmp_path / "cvtpkg"
+    package.mkdir()
+    (package / "__init__.py").write_text(dedent(code), encoding="utf8")
+    buffer = io.StringIO()
+    with redirect_stdout(buffer):
+        exit_code = main(["convert", "cvtpkg", "-s", str(tmp_path), *args])
+    return exit_code, buffer.getvalue()
+
+
+CLI_CODE = '''
+"""Package doc.
+
+Parameters:
+    cfg (str): Config path.
+"""
+'''
+
+
+def test_cli_convert_check_reports_pending_changes(tmp_path) -> None:
+    exit_code, output = _run_convert(tmp_path, CLI_CODE, "-t", "numpy", "--check")
+    assert exit_code == 1
+    assert output == ""
+    content = (tmp_path / "cvtpkg" / "__init__.py").read_text(encoding="utf8")
+    assert content == dedent(CLI_CODE)
+
+
+def test_cli_convert_check_passes_when_nothing_to_change(tmp_path) -> None:
+    code = '''
+"""Package doc.
+
+Parameters
+----------
+cfg : str
+    Config path.
+"""
+'''
+    exit_code, _ = _run_convert(tmp_path, code, "-t", "numpy", "--check", "-d", "numpy")
+    assert exit_code == 0
+
+
+def test_cli_convert_diff_prints_unified_diff(tmp_path) -> None:
+    exit_code, output = _run_convert(tmp_path, CLI_CODE, "-t", "numpy", "--diff")
+    assert exit_code == 0
+    assert "---" in output
+    assert "+++" in output
+    assert "+Parameters" in output
+    content = (tmp_path / "cvtpkg" / "__init__.py").read_text(encoding="utf8")
+    assert content == dedent(CLI_CODE)
+
+
+def test_cli_convert_docstyle_override_drives_parsing(tmp_path) -> None:
+    sphinx_code = """
+\"\"\"Package doc.
+
+:param cfg: Config path.
+:type cfg: str
+\"\"\"
+"""
+    exit_code, _ = _run_convert(
+        tmp_path, sphinx_code, "-t", "numpy", "-d", "sphinx", "--in-place"
+    )
+    assert exit_code == 0
+    content = (tmp_path / "cvtpkg" / "__init__.py").read_text(encoding="utf8")
+    assert re.search(r"^Parameters\n-+$", content, flags=re.MULTILINE)
+    assert "cfg : str" in content
+
+
+def test_cli_convert_in_place_rewrites_files(tmp_path) -> None:
+    exit_code, _ = _run_convert(tmp_path, CLI_CODE, "-t", "numpy", "--in-place")
+    assert exit_code == 0
+    content = (tmp_path / "cvtpkg" / "__init__.py").read_text(encoding="utf8")
+    assert re.search(r"^Parameters\n-+$", content, flags=re.MULTILINE)
+    assert "Parameters:" not in content
