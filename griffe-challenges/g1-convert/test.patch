+def test_cli_convert_check_is_silent_on_both_streams(tmp_path) -> None:
+    package = _write_multi(tmp_path)
+    exit_code, out, err = _run_multi(tmp_path, "-t", "numpy", "--check")
+    assert exit_code != 0
+    assert out == ""
+    assert err == ""
+    for name, text in MULTI_MODULES.items():
+        assert (package / name).read_text(encoding="utf8") == text
+
