+
+def _lines_outside_docstrings(source: str) -> list[str]:
+    """Return every source line that is not part of a docstring literal."""
+    import ast
+
+    holders = (ast.Module, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)
+    spans = []
+    for node in ast.walk(ast.parse(source)):
+        if not isinstance(node, holders) or not node.body:
+            continue
+        first = node.body[0]
+        if (
+            isinstance(first, ast.Expr)
+            and isinstance(first.value, ast.Constant)
+            and isinstance(first.value.value, str)
+        ):
+            spans.append((first.value.lineno, first.value.end_lineno))
+    return [
+        line
+        for number, line in enumerate(source.splitlines(keepends=True), 1)
+        if not any(start <= number <= end for start, end in spans)
+    ]
+
+
+def test_rewrite_source_preserves_non_docstring_bytes() -> None:
+    code = dedent(REWRITE_CODE)
+    with temporary_visited_module(code) as module:
+        result = griffe.rewrite_source(code, module, "numpy", source_style="google")
+    assert "def run(x, y=1):" in result
+    assert "class Thing:" in result
+    assert "def method(self):" in result
+    # Every byte outside the docstring literals is byte-for-byte identical.
+    assert _lines_outside_docstrings(result) == _lines_outside_docstrings(code)
+
