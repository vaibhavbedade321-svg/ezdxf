+def _write_multi(tmp_path):
+    package = tmp_path / "multicvt"
+    (package / "sub").mkdir(parents=True)
+    for name, text in MULTI_MODULES.items():
+        (package / name).write_text(text, encoding="utf8")
+    return package
+
+
+def _run_multi(tmp_path, *args: str) -> tuple[int, str, str]:
+    import io
+    from contextlib import redirect_stderr, redirect_stdout
+
+    from griffecli import main
+
+    out, err = io.StringIO(), io.StringIO()
+    with redirect_stdout(out), redirect_stderr(err):
+        exit_code = main(["convert", "multicvt", "-s", str(tmp_path), *args])
+    return exit_code, out.getvalue(), err.getvalue()
+
+
+def test_cli_convert_diff_covers_every_changed_module(tmp_path) -> None:
+    package = _write_multi(tmp_path)
+    exit_code, out, _ = _run_multi(tmp_path, "-t", "numpy", "--diff")
+    assert exit_code == 0
+    # One diff per changed module, not just the first one found.
+    assert len([line for line in out.splitlines() if line.startswith("---")]) == len(MULTI_MODULES)
+    # --diff never writes.
+    for name, text in MULTI_MODULES.items():
+        assert (package / name).read_text(encoding="utf8") == text
+
