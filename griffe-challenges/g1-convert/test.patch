+        """,
+    )
+    parsed = Docstring(source, parser=Parser.google).parsed
+    examples = next(section for section in parsed if section.kind.value == "examples")
+    assert len(examples.value) == 4
+
+    composed = griffe.compose(parsed, "google")
+    recomposed = Docstring(composed, parser=Parser.google).parsed
+    again = next(section for section in recomposed if section.kind.value == "examples")
+    # Sub-blocks stay separate; without blank lines the trailing text block is
+    # swallowed by the preceding console block.
+    assert len(again.value) == len(examples.value)
+    assert _model(parsed) == _model(recomposed)
+    assert composed == griffe.compose(recomposed, "google")
