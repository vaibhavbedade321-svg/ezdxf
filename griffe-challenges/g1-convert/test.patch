+def _run_convert(tmp_path, code: str, *args: str) -> tuple[int, str]:
+    import io
+    from contextlib import redirect_stdout
+
+    from griffecli import main
+
+    package = tmp_path / "cvtpkg"
+    package.mkdir(exist_ok=True)
+    (package / "__init__.py").write_text(dedent(code), encoding="utf8")
+    buffer = io.StringIO()
+    with redirect_stdout(buffer):
+        exit_code = main(["convert", "cvtpkg", "-s", str(tmp_path), *args])
+    return exit_code, buffer.getvalue()
+
