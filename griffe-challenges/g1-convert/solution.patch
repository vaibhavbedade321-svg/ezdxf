+# This module defines the composer producing Sphinx-style docstring text.
+# Sections that Sphinx field lists cannot express are preserved as plain text.
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from griffe._internal.docstrings.composers._shared import annotation_text
+from griffe._internal.docstrings.composers.google import compose_google
+from griffe._internal.enumerations import DocstringSectionKind
+
+if TYPE_CHECKING:
+    from collections.abc import Sequence
+
+    from griffe._internal.docstrings.models import DocstringSection
+
+
+def _field_lines(head: str, description: str) -> list[str]:
+    """Render a field with its description, keeping line breaks as continuations."""
+    first, _, rest = description.strip("\n").partition("\n")
+    lines = [f"{head} {first}".rstrip()]
+    lines.extend(
+        f"    {line.strip()}" if line.strip() else ""
+        for line in (rest.split("\n") if rest else ())
+    )
+    return lines
+
+
+def compose_sphinx(sections: Sequence[DocstringSection], **options: Any) -> str:  # noqa: ARG001
+    """Compose sections into Sphinx-style docstring text.
+
+    Parameters and attributes become field lists with separate type fields,
+    single unnamed returns become `:returns:` and `:rtype:` fields, and
+    raises become `:raises:` fields. Multi-item or named return sections,
+    and any other section kind without a Sphinx field-list representation,
+    are preserved as text in their Google-style rendering.
+
+    Parameters:
+        sections: The docstring sections to compose.
+        **options: Composer options (ignored).
+
+    Returns:
+        The composed docstring text.
+    """
+    blocks: list[str] = []
+    for section in sections:
+        kind = section.kind
+        if kind is DocstringSectionKind.text:
+            blocks.append(section.value.strip("\n"))
+        elif kind is DocstringSectionKind.parameters:
+            lines: list[str] = []
+            for element in section.value:
+                lines.extend(_field_lines(f":param {element.name}:", element.description))
+                annotation = annotation_text(element.annotation)
+                if annotation:
+                    lines.append(f":type {element.name}: {annotation}")
+            blocks.append("\n".join(lines))
+        elif kind is DocstringSectionKind.attributes:
+            lines = []
+            for element in section.value:
+                lines.extend(_field_lines(f":var {element.name}:", element.description))
+                annotation = annotation_text(element.annotation)
+                if annotation:
+                    lines.append(f":vartype {element.name}: {annotation}")
+            blocks.append("\n".join(lines))
+        elif kind is DocstringSectionKind.returns and _is_single_unnamed(section.value):
+            element = section.value[0]
+            lines = _field_lines(":returns:", element.description)
+            annotation = annotation_text(element.annotation)
+            if annotation:
+                lines.append(f":rtype: {annotation}")
+            blocks.append("\n".join(lines))
+        elif kind is DocstringSectionKind.raises:
+            lines = []
+            for element in section.value:
+                annotation = annotation_text(element.annotation) or ""
+                lines.extend(_field_lines(f":raises {annotation}:", element.description))
+            blocks.append("\n".join(lines))
+        elif kind is DocstringSectionKind.admonition:
+            directive = str(section.value.kind)
+            lines = [f".. {directive}::"]
+            for line in section.value.contents.split("\n"):
+                lines.append(f"    {line}" if line.strip() else "")
+            blocks.append("\n".join(lines))
+        else:
+            text = compose_google([section])
+            if text:
+                blocks.append(text)
+    return "\n\n".join(blocks)
+
+
+def _is_single_unnamed(elements: Sequence[Any]) -> bool:
+    """Return whether a returns section holds exactly one unnamed element."""
+    return len(elements) == 1 and not getattr(elements[0], "name", "")
