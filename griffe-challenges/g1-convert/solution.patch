+# This module rewrites docstrings inside Python source files.
+# Positions come from the Docstring model; everything outside the
+# docstring literals is left byte-for-byte untouched.
+
+from __future__ import annotations
+
+import re
+from typing import TYPE_CHECKING
+
+from griffe._internal.docstrings.compose import compose
+from griffe._internal.docstrings.parsers import parse
+from griffe._internal.enumerations import Parser
+
+if TYPE_CHECKING:
+    from griffe._internal.docstrings.parsers import DocstringStyle
+    from griffe._internal.models import Docstring, Module, Object
+
+
+_PREFIX_QUOTE = re.compile(r'''(?P<prefix>[rRuUbBfF]{0,2})(?P<quote>"""|\'\'\'|"|')''')
+
+
+def _collect_docstrings(obj: Object) -> list[Docstring]:
+    docstrings = []
+    if obj.docstring is not None:
+        docstrings.append(obj.docstring)
+    for member in obj.members.values():
+        if member.is_alias:
+            continue
+        if member.module is not obj.module:
+            continue
+        docstrings.extend(_collect_docstrings(member))  # ty:ignore[invalid-argument-type]
+    return docstrings
+
+
+def rewrite_source(
+    source: str,
+    module: Module,
+    style: DocstringStyle | Parser,
+    *,
+    source_style: DocstringStyle | Parser | None = None,
+) -> str:
+    """Rewrite every docstring of a module's source in the given style.
+
+    Each docstring is parsed with `source_style` (or automatic inference when
+    not given), composed back in the target style, and substituted in place.
+    Indentation, string prefixes and quote style of each docstring literal
+    are preserved, and every byte outside the docstring literals is left
+    untouched.
+
+    Parameters:
+        source: The module source code.
+        module: The module model whose docstrings carry source positions.
+        style: The target docstring style.
+        source_style: The style to parse existing docstrings with.
+            By default the style is inferred per docstring.
+
+    Returns:
+        The rewritten source code.
+    """
+    lines = source.splitlines(keepends=True)
+    docstrings = [
+        docstring
+        for docstring in _collect_docstrings(module)
+        if docstring.lineno is not None and docstring.endlineno is not None
+    ]
+    docstrings.sort(key=lambda docstring: docstring.lineno, reverse=True)
+
+    for docstring in docstrings:
+        start = docstring.lineno - 1
+        end = docstring.endlineno
+        first_line = lines[start]
+        stripped = first_line.lstrip()
+        indent = first_line[: len(first_line) - len(stripped)]
+        match = _PREFIX_QUOTE.match(stripped)
+        if not match:
+            continue
+        prefix = match.group("prefix")
+        quote = match.group("quote")
+
+        if source_style is None:
+            parse_style = docstring.parser or _infer_style(docstring)
+        else:
+            parse_style = source_style if isinstance(source_style, Parser) else Parser(source_style)
+        sections = parse(docstring, parse_style)
+        new_text = compose(sections, style)
+
+        newline = "\n"
+        if first_line.endswith("\r\n"):
+            newline = "\r\n"
+
+        # Preserve any bytes that follow the closing delimiter on the last
+        # line, such as a trailing comment.
+        closing = quote if len(quote) > 1 else quote * 3
+        last_line = lines[end - 1]
+        if closing not in last_line and quote in last_line:
+            closing = quote
+        suffix = ""
+        if closing in last_line:
+            suffix = last_line[last_line.rindex(closing) + len(closing) :]
+
+        content_lines = new_text.split("\n")
+        if len(quote) == 1 and (len(content_lines) > 1 or end != start + 1):
+            # A one-quote literal cannot hold newlines: widen to triple quotes
+            # of the same character.
+            quote = quote * 3
+
+        safe_quote, new_text = _safe_delimiter(quote, new_text, prefix)
+        if safe_quote is None:
+            continue
+        quote = safe_quote
+        content_lines = new_text.split("\n")
+
+        if len(content_lines) == 1 and end == start + 1:
+            replacement = [f"{indent}{prefix}{quote}{content_lines[0]}{quote}{suffix}"]
+        else:
+            replacement = [f"{indent}{prefix}{quote}{content_lines[0]}{newline}"]
+            for content_line in content_lines[1:]:
+                if content_line:
+                    replacement.append(f"{indent}{content_line}{newline}")
+                else:
+                    replacement.append(newline)
+            replacement.append(f"{indent}{quote}{suffix}")
+
+        if not suffix.endswith(("\n", "\r\n")) and end < len(lines):
+            replacement[-1] += newline
+
+        lines[start:end] = replacement
+
+    return "".join(lines)
+
+
+def _safe_delimiter(quote: str, text: str, prefix: str) -> tuple[str | None, str]:
+    """Return a delimiter that can hold `text`, adapting or escaping if needed.
+
+    Falls back to the other triple-quote character when the composed text
+    contains the current delimiter, escapes embedded delimiters when neither
+    character works, and gives up (returning `None`) for raw strings that
+    cannot represent the text at all.
+    """
+    trailing_backslashes = len(text) - len(text.rstrip("\\"))
+    if trailing_backslashes % 2:
+        # A literal cannot end with an unescaped backslash. Raw strings
+        # cannot escape it at all; regular strings double it.
+        if "r" in prefix.lower():
+            return None, text
+        text += "\\"
+    conflict = quote in text if len(quote) == 1 else quote in text or text.endswith(quote[0])
+    if not conflict:
+        return quote, text
+    other = "'''" if quote[0] == '"' else '"""'
+    if other not in text and not text.endswith(other[0]):
+        return other, text
+    if "r" in prefix.lower():
+        return None, text
+    escaped = "\\" + quote[0]
+    text = text.replace(quote[0] * 3, escaped * 3) if len(quote) > 1 else text.replace(quote, escaped)
+    if text.endswith(quote[0]):
+        text = text[:-1] + escaped
+    return quote, text
+
+
+def _infer_style(docstring: Docstring) -> Parser:
+    from griffe._internal.docstrings.auto import infer_docstring_style  # noqa: PLC0415
+
+    inferred, _ = infer_docstring_style(docstring)
+    return inferred or Parser.google
