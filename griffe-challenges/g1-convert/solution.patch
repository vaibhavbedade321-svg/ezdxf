+# This module imports all the defined composers
+# and provides a generic function to compose docstrings back into text.
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from griffe._internal.docstrings.composers.google import compose_google
+from griffe._internal.docstrings.composers.numpy import compose_numpy
+from griffe._internal.docstrings.composers.sphinx import compose_sphinx
+from griffe._internal.enumerations import Parser
+
+if TYPE_CHECKING:
+    from collections.abc import Callable, Sequence
+
+    from griffe._internal.docstrings.models import DocstringSection
+    from griffe._internal.docstrings.parsers import DocstringStyle
+
+
+composers: dict[Parser, Callable[..., str]] = {
+    Parser.google: compose_google,
+    Parser.sphinx: compose_sphinx,
+    Parser.numpy: compose_numpy,
+}
+
+
+def compose(
+    sections: Sequence[DocstringSection],
+    composer: DocstringStyle | Parser,
+    **options: Any,
+) -> str:
+    """Compose docstring sections back into text in the given style.
+
+    Parameters:
+        sections: The docstring sections to compose.
+        composer: The docstring style to compose into.
+        **options: The options accepted by the composer.
+
+    Returns:
+        The composed docstring text.
+    """
+    if not isinstance(composer, Parser):
+        composer = Parser(composer)
+    if composer is Parser.auto:
+        raise ValueError("Cannot compose docstrings with the 'auto' style.")
+    return composers[composer](sections, **options)
