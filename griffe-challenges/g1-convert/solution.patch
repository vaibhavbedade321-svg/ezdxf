@@ -0,0 +1,31 @@
+# Helpers shared by the per-style docstring composers.
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from griffe._internal.docstrings.models import DocstringElement, DocstringNamedElement
+    from griffe._internal.expressions import Expr
+
+
+def annotation_text(annotation: str | Expr | None) -> str | None:
+    """Render an annotation as text, or None when there is none."""
+    if annotation is None:
+        return None
+    return str(annotation)
+
+
+def indent_block(text: str, indent: str) -> list[str]:
+    """Indent every non-empty line of a block of text."""
+    return [indent + line if line.strip() else "" for line in text.split("\n")]
+
+
+def named_item_head(element: DocstringNamedElement) -> str:
+    """Render the name of a named element."""
+    return element.name
+
+
+def element_description(element: DocstringElement) -> str:
+    """Return a stripped description for an element."""
+    return element.description.strip("\n")
diff --git a/packages/griffelib/src/griffe/_internal/docstrings/composers/google.py b/packages/griffelib/src/griffe/_internal/docstrings/composers/google.py
new file mode 100644
index 0000000..24fe6fb
--- /dev/null
+++ b/packages/griffelib/src/griffe/_internal/docstrings/composers/google.py
@@ -0,0 +1,147 @@
+# This module defines the composer producing Google-style docstring text.
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from griffe._internal.docstrings.composers._shared import (
+    annotation_text,
+    element_description,
+    indent_block,
+    named_item_head,
+)
+from griffe._internal.enumerations import DocstringSectionKind
+
+if TYPE_CHECKING:
+    from collections.abc import Sequence
+
+    from griffe._internal.docstrings.models import DocstringElement, DocstringNamedElement, DocstringSection
+
+
+_INDENT = "    "
+
+_section_titles = {
+    DocstringSectionKind.parameters: "Parameters",
+    DocstringSectionKind.other_parameters: "Other Parameters",
+    DocstringSectionKind.type_parameters: "Type Parameters",
+    DocstringSectionKind.raises: "Raises",
+    DocstringSectionKind.warns: "Warns",
+    DocstringSectionKind.returns: "Returns",
+    DocstringSectionKind.yields: "Yields",
+    DocstringSectionKind.receives: "Receives",
+    DocstringSectionKind.examples: "Examples",
+    DocstringSectionKind.attributes: "Attributes",
+    DocstringSectionKind.functions: "Functions",
+    DocstringSectionKind.classes: "Classes",
+    DocstringSectionKind.type_aliases: "Type Aliases",
+    DocstringSectionKind.modules: "Modules",
+}
+
+
+def _compose_named_items(elements: Sequence[DocstringNamedElement]) -> list[str]:
+    lines = []
+    for element in elements:
+        head = named_item_head(element)
+        annotation = annotation_text(element.annotation)
+        if annotation:
+            head += f" ({annotation})"
+        description = element_description(element)
+        first, _, rest = description.partition("\n")
+        lines.append(f"{_INDENT}{head}: {first}".rstrip())
+        if rest:
+            lines.extend(indent_block(rest, _INDENT * 2))
+    return lines
+
+
+def _compose_annotated_items(elements: Sequence[DocstringElement]) -> list[str]:
+    lines = []
+    for element in elements:
+        annotation = annotation_text(element.annotation)
+        name = getattr(element, "name", "") or ""
+        if name and annotation:
+            head = f"{name} ({annotation})"
+        elif annotation:
+            head = annotation
+        else:
+            head = name
+        description = element_description(element)
+        first, _, rest = description.partition("\n")
+        if head:
+            lines.append(f"{_INDENT}{head}: {first}".rstrip())
+        else:
+            lines.append(f"{_INDENT}{first}".rstrip())
+        if rest:
+            lines.extend(indent_block(rest, _INDENT * 2))
+    return lines
+
+
+def compose_google(sections: Sequence[DocstringSection], **options: Any) -> str:  # noqa: ARG001
+    """Compose sections into Google-style docstring text.
+
+    Parameters:
+        sections: The docstring sections to compose.
+        **options: Composer options (ignored).
+
+    Returns:
+        The composed docstring text.
+    """
+    blocks: list[str] = []
+    for section in sections:
+        kind = section.kind
+        if kind is DocstringSectionKind.text:
+            blocks.append(section.value.strip("\n"))
+        elif kind in (
+            DocstringSectionKind.parameters,
+            DocstringSectionKind.other_parameters,
+            DocstringSectionKind.type_parameters,
+            DocstringSectionKind.attributes,
+            DocstringSectionKind.functions,
+            DocstringSectionKind.classes,
+            DocstringSectionKind.type_aliases,
+            DocstringSectionKind.modules,
+        ):
+            lines = [f"{section.title or _section_titles[kind]}:"]
+            lines.extend(_compose_named_items(section.value))
+            blocks.append("\n".join(lines))
+        elif kind in (
+            DocstringSectionKind.returns,
+            DocstringSectionKind.yields,
+            DocstringSectionKind.receives,
+        ):
+            lines = [f"{section.title or _section_titles[kind]}:"]
+            lines.extend(_compose_annotated_items(section.value))
+            blocks.append("\n".join(lines))
+        elif kind in (DocstringSectionKind.raises, DocstringSectionKind.warns):
+            lines = [f"{section.title or _section_titles[kind]}:"]
+            for element in section.value:
+                annotation = annotation_text(element.annotation) or ""
+                description = element_description(element)
+                first, _, rest = description.partition("\n")
+                lines.append(f"{_INDENT}{annotation}: {first}".rstrip())
+                if rest:
+                    lines.extend(indent_block(rest, _INDENT * 2))
+            blocks.append("\n".join(lines))
+        elif kind is DocstringSectionKind.examples:
+            lines = [f"{section.title or _section_titles[kind]}:"]
+            for index, (_, sub_value) in enumerate(section.value):
+                # Blank-separate the sub-blocks, otherwise a text block that
+                # follows a console block is reparsed as part of that block.
+                if index:
+                    lines.append("")
+                lines.extend(indent_block(sub_value, _INDENT))
+            blocks.append("\n".join(lines))
+        elif kind is DocstringSectionKind.deprecated:
+            lines = [f"{section.title or 'Deprecated'}:"]
+            version = section.value.version
+            description = element_description(section.value)
+            if version:
+                lines.append(f"{_INDENT}{version}: {description}")
+            else:
+                lines.extend(indent_block(description, _INDENT))
+            blocks.append("\n".join(lines))
+        elif kind is DocstringSectionKind.admonition:
+            title = section.title or str(section.value.kind).replace("-", " ").title()
+            lines = [f"{title}:"]
+            lines.extend(indent_block(section.value.contents, _INDENT))
+            blocks.append("\n".join(lines))
+    return "\n\n".join(blocks)
diff --git a/packages/griffelib/src/griffe/_internal/docstrings/composers/numpy.py b/packages/griffelib/src/griffe/_internal/docstrings/composers/numpy.py
