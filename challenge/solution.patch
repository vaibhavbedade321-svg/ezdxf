+def offset_closed_polygon_2d(
+    vertices: Iterable[UVec], offset: float
+) -> list[Vec2]:
+    """Return the parallel offset of a closed simple polygon as a single
+    list of :class:`Vec2` vertices.
+
+    Convenience wrapper around :func:`ezdxf.math.buffer.offset_polygon_2d`
+    using the round join style. Returns an empty list when the polygon is
+    fully consumed by a deflation.
+
+    Args:
+        vertices: closed polygon as an iterable of vertices. The Z
+            component is ignored.
+        offset: signed offset distance. Positive inflates, negative
+            deflates, ``0`` returns the input.
+
+    """
+    from ezdxf.math.buffer import offset_polygon_2d, JoinStyle
+
+    polygons = offset_polygon_2d(vertices, offset, join_style=JoinStyle.ROUND)
+    return polygons[0] if polygons else []
 
 
