+    def test_offset_closed_polygon_2d_zero_distance(self):
+        out = offset_closed_polygon_2d(SQUARE, 0.0)
+        assert len(out) == 4
+        assert abs(_signed_area(out) - 16.0) < 1e-9
+
+    def test_offset_closed_polygon_2d_consumed_returns_empty(self):
+        out = offset_closed_polygon_2d([(0, 0), (2, 0), (2, 2), (0, 2)], -2.0)
+        assert out == []
+
+    def test_offset_closed_polygon_2d_matches_round_first_polygon(self):
+        # The wrapper is specified to return the first polygon produced by
+        # offset_polygon_2d using the round join style; for an input that
+        # yields a single polygon the wrapper output must equal that
+        # polygon vertex-for-vertex.
+        wrapper_out = offset_closed_polygon_2d(SQUARE, 0.7)
+        full_out = offset_polygon_2d(SQUARE, 0.7, join_style=JoinStyle.ROUND)
+        assert len(full_out) == 1
+        expected = full_out[0]
+        assert len(wrapper_out) == len(expected)
+        for a, b in zip(wrapper_out, expected):
+            assert abs(a.x - b.x) < 1e-12
+            assert abs(a.y - b.y) < 1e-12
