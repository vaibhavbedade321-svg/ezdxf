+    def test_offset_closed_polygon_2d_inflate(self):
+        # The wrapper returns a single list of Vec2 (not a list of polygons)
+        # and uses the round join style by default.
+        out = offset_closed_polygon_2d(SQUARE, 1.0)
+        assert isinstance(out, list)
+        assert len(out) > 4  # round join adds vertices on each corner
+        for v in out:
