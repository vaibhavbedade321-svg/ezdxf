+# ---------------------------------------------------------------------------
+# Inflate (positive distance) on convex polygons
+# ---------------------------------------------------------------------------
+
+
+class TestInflateConvex:
+    def test_square_miter(self):
+        result = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.MITER, miter_limit=10.0
+        )
+        assert len(result) == 1
+        poly = result[0]
+        # Inflated square is 6x6 -> area 36
+        assert abs(_signed_area(poly) - 36.0) < 1e-9
+        assert _is_ccw(poly)
+        assert _is_simple_polygon(poly)
+
+    def test_square_bevel(self):
+        result = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.BEVEL
+        )
+        assert len(result) == 1
+        poly = result[0]
+        # Each corner replaced by a chord of length sqrt(2). Area:
+        # original square 16 + 4 strips of 4*1=16 + 4 corner triangles 0.5*1*1
+        # = 16 + 16 + 2 = 34
+        assert abs(_signed_area(poly) - 34.0) < 1e-9
+        assert _is_ccw(poly)
+        assert _is_simple_polygon(poly)
+
+    def test_square_round_area_converges(self):
+        # Outer area of an inflated convex polygon with full round joins is
+        # exactly: original_area + perimeter * d + pi * d^2.
+        # Check that the area converges to this analytical value as the
+        # arc_segment_angle is reduced.
+        d = 1.0
+        coarse = offset_polygon_2d(
+            SQUARE, d, join_style=JoinStyle.ROUND, arc_segment_angle=math.pi / 8
+        )
+        fine = offset_polygon_2d(
+            SQUARE, d, join_style=JoinStyle.ROUND, arc_segment_angle=math.pi / 64
+        )
+        analytical = 16.0 + 16.0 * d + math.pi * d * d
+        coarse_err = abs(_signed_area(coarse[0]) - analytical)
+        fine_err = abs(_signed_area(fine[0]) - analytical)
+        # Fine must be strictly closer than coarse and within 0.5%.
+        assert fine_err < coarse_err
+        assert fine_err / analytical < 0.005
+
+    def test_round_join_emits_more_vertices_than_bevel(self):
+        bevel = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.BEVEL
+        )[0]
+        round_ = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.ROUND, arc_segment_angle=math.pi / 16
+        )[0]
+        miter = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.MITER, miter_limit=10
+        )[0]
+        assert len(round_) > len(bevel)
+        # Miter on a square reduces to the original 4 vertices.
+        assert len(miter) == 4
+
+    def test_inflate_contains_original(self):
+        # Every input vertex must lie inside or on the inflated polygon
+        # boundary, at distance no greater than d from it.
+        d = 0.7
+        result = offset_polygon_2d(
+            SQUARE, d, join_style=JoinStyle.ROUND
+        )[0]
+        for v in [Vec2(p) for p in SQUARE]:
+            dist = _min_distance_to_polygon(v, result)
+            assert dist <= d + 1e-6
+            assert dist >= d - 0.05  # close to d but allow for round chord
+
+    def test_double_inflate_square_miter(self):
+        # Inflating twice by 1 with MITER should equal inflating once by 2.
+        once = offset_polygon_2d(
+            SQUARE, 2.0, join_style=JoinStyle.MITER, miter_limit=10
+        )[0]
+        twice = offset_polygon_2d(
+            offset_polygon_2d(
+                SQUARE, 1.0, join_style=JoinStyle.MITER, miter_limit=10
+            )[0],
+            1.0,
+            join_style=JoinStyle.MITER,
+            miter_limit=10,
+        )[0]
+        assert abs(_signed_area(once) - _signed_area(twice)) < 1e-6
+        assert abs(_signed_area(once) - 64.0) < 1e-6
+
+    def test_triangle_miter(self):
+        # Equilateral triangle, side length s -> area = s^2 * sqrt(3) / 4
+        # Inflating with MITER preserves the corner topology, so the result
+        # is a similar triangle with offset corners.
+        s = 2.0
+        h = s * math.sqrt(3.0) / 2.0
+        triangle = [(0.0, 0.0), (s, 0.0), (s / 2.0, h)]
+        d = 0.5
+        result = offset_polygon_2d(
+            triangle, d, join_style=JoinStyle.MITER, miter_limit=10
+        )
+        assert len(result) == 1
+        poly = result[0]
+        assert len(poly) == 3
+        # Analytical inflated area: A + p*d + pi*d^2 (for round joins). With
+        # miter the corner region is the *complement* of the round arc
+        # within the angle bisector cone, so it is larger. Compute it
+        # explicitly for the equilateral triangle: each miter triangle has
+        # area (d^2 / tan(theta/2)) where theta is the interior angle = 60
+        # degrees, so area per corner = d^2 / tan(30) = d^2 * sqrt(3).
+        a_orig = (s * s) * math.sqrt(3.0) / 4.0
+        perim = 3.0 * s
+        miter_per_corner = d * d * math.sqrt(3.0)
+        expected = a_orig + perim * d + 3.0 * miter_per_corner
+        assert abs(_signed_area(poly) - expected) < 1e-6
+
+
+# ---------------------------------------------------------------------------
+# Inflate on concave polygons
+# ---------------------------------------------------------------------------
+
+
+class TestInflateConcave:
+    L_SHAPE = [
+        (0.0, 0.0), (4.0, 0.0), (4.0, 2.0),
+        (2.0, 2.0), (2.0, 4.0), (0.0, 4.0),
+    ]
+
+    def test_l_shape_inflate_miter(self):
+        result = offset_polygon_2d(
+            self.L_SHAPE, 0.5, join_style=JoinStyle.MITER, miter_limit=10
+        )
+        assert len(result) == 1
+        poly = result[0]
+        # Original L area = 12. Each side moves out by 0.5.
+        # Convex corners: 5 of them, 90 deg => each adds d^2 to area (miter
+        # square). Concave corner: 1 of them, removes d^2 (intersection
+        # cuts in).
+        # Perimeter: 4+2+2+2+2+4 = 16. Area = 12 + 16*0.5 + 5*0.25 - 1*0.25
+        # = 12 + 8 + 1.25 - 0.25 = 21.0
+        assert abs(_signed_area(poly) - 21.0) < 1e-9
+        assert _is_ccw(poly)
+        assert _is_simple_polygon(poly)
+
+    def test_l_shape_inflate_round(self):
+        result = offset_polygon_2d(
+            self.L_SHAPE, 0.3, join_style=JoinStyle.ROUND,
+            arc_segment_angle=math.pi / 32,
+        )
+        assert len(result) == 1
+        poly = result[0]
+        # Round joins on convex corners contribute pi * d^2 across all
+        # convex corners (5 of them, totaling 5*90 = 450 deg = 2.5 pi).
+        # The concave corner removes a square area of d^2.
+        d = 0.3
+        a_orig = 12.0
+        perim = 4 + 2 + 2 + 2 + 2 + 4
+        # 5 convex 90-deg corners contribute 5/4 of full circle = 5*pi*d^2/4
+        convex_area = 5 * math.pi * d * d / 4
+        concave_area = -d * d  # square cut out at concave corner
+        expected = a_orig + perim * d + convex_area + concave_area
+        assert abs(_signed_area(poly) - expected) < 0.01
+        assert _is_simple_polygon(poly)
+
+    def test_concave_inflate_preserves_inside(self):
+        # Every input vertex must lie strictly inside the inflated polygon.
+        result = offset_polygon_2d(
+            self.L_SHAPE, 0.3, join_style=JoinStyle.MITER, miter_limit=10
+        )
+        poly = result[0]
+        for v in [Vec2(p) for p in self.L_SHAPE]:
+            assert _min_distance_to_polygon(v, poly) >= 0.3 - 1e-6
+
