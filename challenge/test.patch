+"""Tests for ezdxf.math.buffer.offset_polygon_2d."""
+from __future__ import annotations
+import math
+
+import pytest
+
+from ezdxf.math import Vec2, is_point_in_polygon_2d
+from ezdxf.math.buffer import JoinStyle, offset_polygon_2d
+from ezdxf.math import (
+    offset_polygon_2d as _offset_polygon_2d_from_pkg,
+    JoinStyle as _JoinStyle_from_pkg,
+)
+from ezdxf.math.offset2d import offset_closed_polygon_2d
+
+
+def _signed_area(polygon) -> float:
+    n = len(polygon)
+    s = 0.0
+    for i in range(n):
+        a = polygon[i]
+        b = polygon[(i + 1) % n]
+        s += a.x * b.y - b.x * a.y
+    return 0.5 * s
+
+
+def _is_ccw(polygon) -> bool:
+    return _signed_area(polygon) > 0
+
+
+def _min_distance_to_polygon(point: Vec2, polygon) -> float:
+    n = len(polygon)
+    best = math.inf
+    for i in range(n):
+        a = polygon[i]
+        b = polygon[(i + 1) % n]
+        abx = b.x - a.x
+        aby = b.y - a.y
+        apx = point.x - a.x
+        apy = point.y - a.y
+        seg_len_sq = abx * abx + aby * aby
+        if seg_len_sq < 1e-30:
+            d = math.hypot(apx, apy)
+        else:
+            t = max(0.0, min(1.0, (apx * abx + apy * aby) / seg_len_sq))
+            cx = a.x + abx * t
+            cy = a.y + aby * t
+            d = math.hypot(point.x - cx, point.y - cy)
+        if d < best:
+            best = d
+    return best
+
+
+def _is_simple_polygon(polygon) -> bool:
+    n = len(polygon)
+    if n < 3:
+        return False
+    for i in range(n):
+        a1 = polygon[i]
+        a2 = polygon[(i + 1) % n]
+        for j in range(i + 1, n):
+            if j == i + 1:
+                continue
+            if i == 0 and j == n - 1:
+                continue
+            b1 = polygon[j]
+            b2 = polygon[(j + 1) % n]
+            if _segments_cross(a1, a2, b1, b2):
+                return False
+    return True
+
+
+def _segments_cross(a1, a2, b1, b2) -> bool:
+    eps = 1e-9
+    dx1 = a2.x - a1.x
+    dy1 = a2.y - a1.y
+    dx2 = b2.x - b1.x
+    dy2 = b2.y - b1.y
+    det = dx1 * dy2 - dy1 * dx2
+    if abs(det) < eps:
+        return False
+    rx = b1.x - a1.x
+    ry = b1.y - a1.y
+    t = (rx * dy2 - ry * dx2) / det
+    u = (rx * dy1 - ry * dx1) / det
+    return eps < t < 1.0 - eps and eps < u < 1.0 - eps
+
+
+SQUARE = [(0.0, 0.0), (4.0, 0.0), (4.0, 4.0), (0.0, 4.0)]
+
+
+class TestApiBasics:
+    def test_returns_list_of_lists_of_vec2(self):
+        result = offset_polygon_2d(SQUARE, 1.0, join_style=JoinStyle.MITER, miter_limit=10)
+        assert isinstance(result, list)
+        assert isinstance(result[0], list)
+        for v in result[0]:
+            assert isinstance(v, Vec2)
+
+    def test_zero_distance_returns_input_unchanged(self):
+        result = offset_polygon_2d(SQUARE, 0.0)
+        assert len(result) == 1
+        poly = result[0]
+        assert len(poly) == 4
+        assert abs(_signed_area(poly) - 16.0) < 1e-9
+
+    def test_zero_distance_on_cw_input_returns_ccw(self):
+        cw = list(reversed(SQUARE))
+        result = offset_polygon_2d(cw, 0.0)
+        assert len(result) == 1
+        assert _is_ccw(result[0])
+
+    def test_invalid_miter_limit_raises(self):
+        with pytest.raises(ValueError):
+            offset_polygon_2d(SQUARE, 1.0, miter_limit=0.5)
+
+    def test_invalid_arc_segment_angle_raises(self):
+        with pytest.raises(ValueError):
+            offset_polygon_2d(SQUARE, 1.0, arc_segment_angle=0.0)
+
+    def test_empty_input_returns_empty(self):
+        assert offset_polygon_2d([], 1.0) == []
+
+    def test_single_vertex_returns_empty(self):
+        assert offset_polygon_2d([(0, 0)], 1.0) == []
+
+    def test_two_vertex_input_returns_empty(self):
+        assert offset_polygon_2d([(0, 0), (1, 1)], 1.0) == []
+
+    def test_closed_input_with_duplicate_first_last(self):
+        closed = list(SQUARE) + [SQUARE[0]]
+        result = offset_polygon_2d(closed, 1.0, join_style=JoinStyle.MITER, miter_limit=10)
+        assert len(result) == 1
+        assert abs(_signed_area(result[0]) - 36.0) < 1e-9
+
+    def test_consecutive_duplicates_filtered(self):
+        polygon = [(0, 0), (0, 0), (4, 0), (4, 0), (4, 4), (0, 4)]
+        result = offset_polygon_2d(polygon, 1.0, join_style=JoinStyle.MITER, miter_limit=10)
+        assert len(result) == 1
+        assert abs(_signed_area(result[0]) - 36.0) < 1e-9
+
+    def test_z_component_is_ignored(self):
+        flat = [(0, 0), (4, 0), (4, 4), (0, 4)]
+        with_z = [(0, 0, 5), (4, 0, -3), (4, 4, 17), (0, 4, 0)]
+        flat_result = offset_polygon_2d(
+            flat, 1.0, join_style=JoinStyle.MITER, miter_limit=10
+        )[0]
+        z_result = offset_polygon_2d(
+            with_z, 1.0, join_style=JoinStyle.MITER, miter_limit=10
+        )[0]
+        assert len(flat_result) == len(z_result)
+        for a, b in zip(
+            sorted((v.x, v.y) for v in flat_result),
+            sorted((v.x, v.y) for v in z_result),
+        ):
+            assert abs(a[0] - b[0]) < 1e-9
+            assert abs(a[1] - b[1]) < 1e-9
+
+    def test_returned_vertices_are_distinct(self):
+        for join in (JoinStyle.MITER, JoinStyle.BEVEL, JoinStyle.ROUND):
+            kw = {"miter_limit": 10} if join is JoinStyle.MITER else {}
+            poly = offset_polygon_2d(SQUARE, 1.0, join_style=join, **kw)[0]
+            for i in range(len(poly)):
+                for j in range(i + 1, len(poly)):
+                    a = poly[i]
+                    b = poly[j]
+                    assert not (abs(a.x - b.x) < 1e-9 and abs(a.y - b.y) < 1e-9), (
+                        f"duplicate vertex with join={join}: {a} == {b}"
+                    )
