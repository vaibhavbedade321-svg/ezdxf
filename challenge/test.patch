+# Deflate (negative distance)
+# ---------------------------------------------------------------------------
+
+
+class TestDeflate:
+    def test_square_deflate(self):
+        # A 4x4 square deflated by 1 should produce a 2x2 inner square.
+        result = offset_polygon_2d(
+            SQUARE, -1.0, join_style=JoinStyle.MITER, miter_limit=10
+        )
+        assert len(result) == 1
+        poly = result[0]
+        assert len(poly) == 4
+        assert abs(_signed_area(poly) - 4.0) < 1e-9
+        assert _is_ccw(poly)
+        assert _is_simple_polygon(poly)
+        # All vertices should lie inside the original square at distance 1.
+        for v in poly:
+            assert _min_distance_to_polygon(v, [Vec2(p) for p in SQUARE]) >= 1.0 - 1e-6
+
+    def test_square_deflate_below_inradius_returns_empty(self):
+        # The inradius of a 2x2 square is 1.
+        unit = [(0, 0), (2, 0), (2, 2), (0, 2)]
+        assert offset_polygon_2d(unit, -1.0) == []
+        assert offset_polygon_2d(unit, -1.5) == []
+        assert offset_polygon_2d(unit, -2.0) == []
+
+    def test_triangle_deflate_below_inradius_returns_empty(self):
+        # Equilateral triangle with side 2 has inradius = 1/sqrt(3) ~= 0.577.
+        s = 2.0
+        triangle = [(0.0, 0.0), (s, 0.0), (s / 2, s * math.sqrt(3) / 2)]
+        assert offset_polygon_2d(triangle, -0.6) == []
+        assert offset_polygon_2d(triangle, -1.0) == []
+
+    def test_triangle_deflate_within_inradius(self):
+        s = 6.0
+        triangle = [(0.0, 0.0), (s, 0.0), (s / 2, s * math.sqrt(3) / 2)]
+        result = offset_polygon_2d(
+            triangle, -0.5, join_style=JoinStyle.MITER, miter_limit=10
+        )
+        assert len(result) == 1
+        poly = result[0]
+        assert len(poly) == 3
+        assert _is_ccw(poly)
+
+    def test_l_shape_deflate(self):
+        l_shape = [
+            (0.0, 0.0), (4.0, 0.0), (4.0, 2.0),
+            (2.0, 2.0), (2.0, 4.0), (0.0, 4.0),
+        ]
+        result = offset_polygon_2d(
+            l_shape, -0.5, join_style=JoinStyle.MITER, miter_limit=10
+        )
+        assert len(result) == 1
+        poly = result[0]
+        assert len(poly) == 6
+        # Deflated L:
+        # Horizontal arm (3x1) area 3, vertical arm (1x3) area 3, overlap 1.
+        # Total = 5.
+        assert abs(_signed_area(poly) - 5.0) < 1e-9
+        assert _is_ccw(poly)
+        assert _is_simple_polygon(poly)
+
