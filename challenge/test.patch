+class TestInflateConvex:
+    def test_square_miter(self):
+        result = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.MITER, miter_limit=10.0
+        )
+        assert len(result) == 1
+        poly = result[0]
+        # Inflated square is 6x6 -> area 36
+        assert abs(_signed_area(poly) - 36.0) < 1e-9
+        assert _is_ccw(poly)
+        assert _is_simple_polygon(poly)
+
+    def test_square_bevel(self):
+        result = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.BEVEL
+        )
+        assert len(result) == 1
+        poly = result[0]
+        # Each corner replaced by a chord of length sqrt(2). Area:
+        # original square 16 + 4 strips of 4*1=16 + 4 corner triangles 0.5*1*1
+        # = 16 + 16 + 2 = 34
+        assert abs(_signed_area(poly) - 34.0) < 1e-9
+        assert _is_ccw(poly)
+        assert _is_simple_polygon(poly)
+
+    def test_square_round_area_converges(self):
+        d = 1.0
+        coarse = offset_polygon_2d(
+            SQUARE, d, join_style=JoinStyle.ROUND, arc_segment_angle=math.pi / 8
+        )
+        fine = offset_polygon_2d(
+            SQUARE, d, join_style=JoinStyle.ROUND, arc_segment_angle=math.pi / 64
+        )
+        analytical = 16.0 + 16.0 * d + math.pi * d * d
+        coarse_err = abs(_signed_area(coarse[0]) - analytical)
+        fine_err = abs(_signed_area(fine[0]) - analytical)
+        assert fine_err < coarse_err
+        assert fine_err / analytical < 0.005
+
+    def test_round_emits_more_vertices_than_bevel(self):
+        bevel = offset_polygon_2d(SQUARE, 1.0, join_style=JoinStyle.BEVEL)[0]
+        rounded = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.ROUND, arc_segment_angle=math.pi / 16
+        )[0]
+        assert len(rounded) > len(bevel)
+
+    def test_inflate_contains_original(self):
+        d = 0.7
+        result = offset_polygon_2d(SQUARE, d, join_style=JoinStyle.ROUND)[0]
+        for v in [Vec2(p) for p in SQUARE]:
+            assert is_point_in_polygon_2d(v, list(result)) >= 0
+
+    def test_triangle_miter(self):
+        s = 2.0
+        h = s * math.sqrt(3.0) / 2.0
+        triangle = [(0.0, 0.0), (s, 0.0), (s / 2.0, h)]
+        d = 0.5
+        result = offset_polygon_2d(
+            triangle, d, join_style=JoinStyle.MITER, miter_limit=10
+        )
+        assert len(result) == 1
+        poly = result[0]
+        assert len(poly) == 3
+        # Each miter corner adds d^2 / tan(theta/2) of area where theta is
+        # the interior angle (60 deg for an equilateral triangle).
+        a_orig = (s * s) * math.sqrt(3.0) / 4.0
+        perim = 3.0 * s
+        miter_per_corner = d * d * math.sqrt(3.0)
+        expected = a_orig + perim * d + 3.0 * miter_per_corner
+        assert abs(_signed_area(poly) - expected) < 1e-6
+
