+"""Tests for ezdxf.math.buffer.offset_polygon_2d."""
+from __future__ import annotations
+import math
+
+import pytest
+
+from ezdxf.math import Vec2
+from ezdxf.math.buffer import JoinStyle, offset_polygon_2d
+# The challenge also requires that the public symbols are re-exported from
+# ``ezdxf.math`` and that a convenience wrapper is exposed from
+# ``ezdxf.math.offset2d``.
+from ezdxf.math import (
+    offset_polygon_2d as _offset_polygon_2d_from_pkg,
+    JoinStyle as _JoinStyle_from_pkg,
+)
+from ezdxf.math.offset2d import offset_closed_polygon_2d
+
+
+def _signed_area(polygon) -> float:
+    n = len(polygon)
+    s = 0.0
+    for i in range(n):
+        a = polygon[i]
+        b = polygon[(i + 1) % n]
+        s += a.x * b.y - b.x * a.y
+    return 0.5 * s
+
+
+def _is_ccw(polygon) -> bool:
+    return _signed_area(polygon) > 0
+
+
+def _min_distance_to_polygon(point: Vec2, polygon) -> float:
+    n = len(polygon)
+    best = math.inf
+    for i in range(n):
+        a = polygon[i]
+        b = polygon[(i + 1) % n]
+        abx = b.x - a.x
+        aby = b.y - a.y
+        apx = point.x - a.x
+        apy = point.y - a.y
+        seg_len_sq = abx * abx + aby * aby
+        if seg_len_sq < 1e-30:
+            d = math.hypot(apx, apy)
+        else:
+            t = max(0.0, min(1.0, (apx * abx + apy * aby) / seg_len_sq))
+            cx = a.x + abx * t
+            cy = a.y + aby * t
+            d = math.hypot(point.x - cx, point.y - cy)
+        if d < best:
+            best = d
+    return best
+
+
+def _is_simple_polygon(polygon) -> bool:
+    """Return True if the polygon has no self-intersections."""
+    n = len(polygon)
+    if n < 3:
+        return False
+    for i in range(n):
+        a1 = polygon[i]
+        a2 = polygon[(i + 1) % n]
+        for j in range(i + 1, n):
+            if j == i + 1:
+                continue
+            if i == 0 and j == n - 1:
+                continue
+            b1 = polygon[j]
+            b2 = polygon[(j + 1) % n]
+            if _segments_cross(a1, a2, b1, b2):
+                return False
+    return True
+
+
+def _segments_cross(a1, a2, b1, b2) -> bool:
+    eps = 1e-9
+    dx1 = a2.x - a1.x
+    dy1 = a2.y - a1.y
+    dx2 = b2.x - b1.x
+    dy2 = b2.y - b1.y
+    det = dx1 * dy2 - dy1 * dx2
+    if abs(det) < eps:
+        return False
+    rx = b1.x - a1.x
+    ry = b1.y - a1.y
+    t = (rx * dy2 - ry * dx2) / det
+    u = (rx * dy1 - ry * dx1) / det
+    return eps < t < 1.0 - eps and eps < u < 1.0 - eps
+
+
+SQUARE = [(0.0, 0.0), (4.0, 0.0), (4.0, 4.0), (0.0, 4.0)]
+
