+# ---------------------------------------------------------------------------
+# Round join smoothness
+# ---------------------------------------------------------------------------
+
+
+class TestRoundJoin:
+    def test_smaller_arc_segment_angle_more_vertices(self):
+        coarse = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.ROUND,
+            arc_segment_angle=math.pi / 4,
+        )[0]
+        fine = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.ROUND,
+            arc_segment_angle=math.pi / 32,
+        )[0]
+        assert len(fine) > len(coarse)
+
+    def test_round_inflate_vertices_equidistant_from_input(self):
+        # Every output vertex of a round-inflated convex polygon must be at
+        # distance d from the input boundary (within tolerance).
+        d = 0.7
+        result = offset_polygon_2d(
+            SQUARE, d, join_style=JoinStyle.ROUND,
+            arc_segment_angle=math.pi / 24,
+        )[0]
+        for v in result:
+            dist = _min_distance_to_polygon(v, [Vec2(p) for p in SQUARE])
+            assert abs(dist - d) < 1e-6
+
+    def test_round_join_arc_direction_inflate(self):
+        # For a CCW square inflated with ROUND, the corner arcs must be
+        # CCW: vertices on each arc have monotonically increasing angle
+        # around the corresponding input vertex.
+        result = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.ROUND,
+            arc_segment_angle=math.pi / 16,
+        )[0]
+        # Group output vertices by which input vertex is closest within d.
+        # Each input vertex should "see" multiple output vertices on its
+        # circle.
+        for corner in [Vec2(p) for p in SQUARE]:
+            arc_pts = [
+                v for v in result
+                if abs(corner.distance(v) - 1.0) < 1e-6
+            ]
+            assert len(arc_pts) >= 3
+
