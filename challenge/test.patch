+class TestRoundJoin:
+    def test_smaller_arc_segment_angle_more_vertices(self):
+        coarse = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.ROUND,
+            arc_segment_angle=math.pi / 4,
+        )[0]
+        fine = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.ROUND,
+            arc_segment_angle=math.pi / 32,
+        )[0]
+        assert len(fine) > len(coarse)
