+    def test_round_chord_angle_does_not_exceed_limit(self):
+        # For each pair of consecutive arc vertices that share an input
+        # corner as their common centre, the angle they subtend at that
+        # centre must not exceed the configured arc_segment_angle.
+        d = 1.0
+        max_angle = math.pi / 8
+        result = offset_polygon_2d(
+            SQUARE, d, join_style=JoinStyle.ROUND,
+            arc_segment_angle=max_angle,
+        )[0]
+        corners = [Vec2(p) for p in SQUARE]
+        n = len(result)
+        tol = 1e-9
+        for i in range(n):
+            a = result[i]
+            b = result[(i + 1) % n]
+            for c in corners:
+                da = c.distance(a)
+                db = c.distance(b)
+                if abs(da - d) < 1e-6 and abs(db - d) < 1e-6:
+                    va = (a.x - c.x, a.y - c.y)
+                    vb = (b.x - c.x, b.y - c.y)
+                    cos_t = (va[0] * vb[0] + va[1] * vb[1]) / (d * d)
+                    cos_t = max(-1.0, min(1.0, cos_t))
+                    angle = math.acos(cos_t)
+                    assert angle <= max_angle + tol, (
+                        f"chord at corner {c} subtends {angle} > {max_angle}"
+                    )
+                    break
