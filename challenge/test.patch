+# ---------------------------------------------------------------------------
+# Miter limit behaviour
+# ---------------------------------------------------------------------------
+
+
+class TestMiterLimit:
+    def test_acute_corner_falls_back_to_bevel_when_limit_low(self):
+        # A very acute "spike" triangle. Inflating with a low miter limit
+        # should produce a bevel chord at the spike instead of a long
+        # outward miter.
+        spike = [(0.0, 0.0), (10.0, 0.5), (0.0, 1.0)]
+        d = 0.3
+        with_low_limit = offset_polygon_2d(
+            spike, d, join_style=JoinStyle.MITER, miter_limit=1.5
+        )[0]
+        with_high_limit = offset_polygon_2d(
+            spike, d, join_style=JoinStyle.MITER, miter_limit=100
+        )[0]
+        # The high-limit version should have at most as many vertices as
+        # the input (3) - it is a single sharp triangle.
+        assert len(with_high_limit) == 3
+        # The bevel fallback must add a vertex at the spike.
+        assert len(with_low_limit) > 3
+        # And the high-limit area should be strictly larger because the
+        # miter point pokes out further than the bevel chord.
+        assert _signed_area(with_high_limit) > _signed_area(with_low_limit)
+
+    def test_default_miter_limit_falls_back_for_acute_corner(self):
+        # The default miter limit is 2.0. A 30 degree corner has a miter
+        # length > 2 * d and must fall back to a bevel.
+        s = math.tan(math.radians(15))  # 30 deg corner -> half angle 15
+        spike = [(0.0, 0.0), (1.0, s), (0.0, 2 * s)]
+        result = offset_polygon_2d(
+            spike, 0.1, join_style=JoinStyle.MITER, miter_limit=2.0
+        )
+        assert len(result) == 1
+        # The fallback adds a bevel at the spike: more than 3 vertices.
+        assert len(result[0]) > 3
+
