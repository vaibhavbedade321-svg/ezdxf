+class TestApiBasics:
+    def test_returns_list_of_lists_of_vec2(self):
+        result = offset_polygon_2d(SQUARE, 1.0, join_style=JoinStyle.MITER, miter_limit=10)
+        assert isinstance(result, list)
+        assert isinstance(result[0], list)
+        for v in result[0]:
+            assert isinstance(v, Vec2)
+
+    def test_zero_distance_returns_input_unchanged(self):
+        result = offset_polygon_2d(SQUARE, 0.0)
+        assert len(result) == 1
+        poly = result[0]
+        assert len(poly) == 4
+        assert abs(_signed_area(poly) - 16.0) < 1e-9
+
+    def test_zero_distance_on_cw_input_returns_ccw(self):
+        cw = list(reversed(SQUARE))
+        result = offset_polygon_2d(cw, 0.0)
+        assert len(result) == 1
+        assert _is_ccw(result[0])
+
+    def test_invalid_miter_limit_raises(self):
+        with pytest.raises(ValueError):
+            offset_polygon_2d(SQUARE, 1.0, miter_limit=0.5)
+
+    def test_invalid_arc_segment_angle_raises(self):
+        with pytest.raises(ValueError):
+            offset_polygon_2d(SQUARE, 1.0, arc_segment_angle=0.0)
+
+    def test_empty_input_returns_empty(self):
+        assert offset_polygon_2d([], 1.0) == []
+
+    def test_single_vertex_returns_empty(self):
+        assert offset_polygon_2d([(0, 0)], 1.0) == []
+
+    def test_two_vertex_input_returns_empty(self):
+        assert offset_polygon_2d([(0, 0), (1, 1)], 1.0) == []
+
+    def test_closed_input_with_duplicate_first_last(self):
+        closed = list(SQUARE) + [SQUARE[0]]
+        result = offset_polygon_2d(closed, 1.0, join_style=JoinStyle.MITER, miter_limit=10)
+        assert len(result) == 1
+        assert abs(_signed_area(result[0]) - 36.0) < 1e-9
+
+    def test_consecutive_duplicates_filtered(self):
+        polygon = [(0, 0), (0, 0), (4, 0), (4, 0), (4, 4), (0, 4)]
+        result = offset_polygon_2d(polygon, 1.0, join_style=JoinStyle.MITER, miter_limit=10)
+        assert len(result) == 1
+        assert abs(_signed_area(result[0]) - 36.0) < 1e-9
