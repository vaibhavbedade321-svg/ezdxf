+class TestMiterLimit:
+    def test_acute_corner_falls_back_to_bevel_when_limit_low(self):
+        spike = [(0.0, 0.0), (10.0, 0.5), (0.0, 1.0)]
+        d = 0.3
+        with_low_limit = offset_polygon_2d(
+            spike, d, join_style=JoinStyle.MITER, miter_limit=1.5
+        )[0]
+        with_high_limit = offset_polygon_2d(
+            spike, d, join_style=JoinStyle.MITER, miter_limit=100
+        )[0]
+        assert len(with_high_limit) == 3
+        assert len(with_low_limit) > 3
+        assert _signed_area(with_high_limit) > _signed_area(with_low_limit)
+
+    def test_default_miter_limit_falls_back_for_acute_corner(self):
+        # 30 deg corner: miter length ~ 1/sin(15) ~= 3.86 * d > 2 * d.
+        s = math.tan(math.radians(15))
+        spike = [(0.0, 0.0), (1.0, s), (0.0, 2 * s)]
+        result = offset_polygon_2d(
+            spike, 0.1, join_style=JoinStyle.MITER, miter_limit=2.0
+        )
+        assert len(result) == 1
+        assert len(result[0]) > 3
+
+    def test_miter_fallback_matches_bevel_endpoints(self):
+        # A 90 deg corner has miter length sqrt(2) * abs(distance), so a
+        # miter_limit of 1.4 forces every corner of a square to fall back
+        # to bevel. The fallback must emit exactly the same two endpoints
+        # as a plain BEVEL join, so the two outputs are identical.
+        miter_fallback = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.MITER, miter_limit=1.4
+        )[0]
+        bevel = offset_polygon_2d(
+            SQUARE, 1.0, join_style=JoinStyle.BEVEL
+        )[0]
+        assert len(miter_fallback) == len(bevel)
+        for a, b in zip(miter_fallback, bevel):
+            assert abs(a.x - b.x) < 1e-12
+            assert abs(a.y - b.y) < 1e-12
+
