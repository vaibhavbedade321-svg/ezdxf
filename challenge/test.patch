+class TestPublicReExports:
+    """The buffer API must be importable from ezdxf.math and a convenience
+    wrapper must be exposed from ezdxf.math.offset2d."""
+
+    def test_symbols_reexported_from_math_package(self):
+        # Same callable / class objects on both import paths.
