+# ---------------------------------------------------------------------------
+# Numerical stability
+# ---------------------------------------------------------------------------
+
+
+class TestNumericalStability:
+    def test_translation_invariance(self):
+        # Translating the input must produce a translated output.
+        d = 0.5
+        original = offset_polygon_2d(
+            SQUARE, d, join_style=JoinStyle.MITER, miter_limit=10
+        )[0]
+        offset_in = [(p[0] + 1000.0, p[1] + 1000.0) for p in SQUARE]
+        translated = offset_polygon_2d(
