+class TestNumericalStability:
+    def test_translation_invariance(self):
+        d = 0.5
+        original = offset_polygon_2d(
+            SQUARE, d, join_style=JoinStyle.MITER, miter_limit=10
+        )[0]
+        offset_in = [(p[0] + 1000.0, p[1] + 1000.0) for p in SQUARE]
+        translated = offset_polygon_2d(
+            offset_in, d, join_style=JoinStyle.MITER, miter_limit=10
+        )[0]
+        assert len(original) == len(translated)
+        original_shifted = sorted((v.x + 1000.0, v.y + 1000.0) for v in original)
+        translated_pts = sorted((v.x, v.y) for v in translated)
+        for a, b in zip(original_shifted, translated_pts):
+            assert abs(a[0] - b[0]) < 1e-6
+            assert abs(a[1] - b[1]) < 1e-6
+
+    def test_scaling_invariance(self):
+        k = 100.0
+        d = 0.5
+        original = offset_polygon_2d(
+            SQUARE, d, join_style=JoinStyle.MITER, miter_limit=10
+        )[0]
+        scaled_in = [(p[0] * k, p[1] * k) for p in SQUARE]
+        scaled = offset_polygon_2d(
+            scaled_in, d * k, join_style=JoinStyle.MITER, miter_limit=10
+        )[0]
+        assert len(original) == len(scaled)
+        original_scaled = sorted((v.x * k, v.y * k) for v in original)
+        scaled_pts = sorted((v.x, v.y) for v in scaled)
+        for a, b in zip(original_scaled, scaled_pts):
+            assert abs(a[0] - b[0]) < 1e-3
+            assert abs(a[1] - b[1]) < 1e-3
