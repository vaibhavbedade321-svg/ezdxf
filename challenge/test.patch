+    def test_round_inflate_vertices_on_offset_boundary(self):
+        d = 0.7
+        result = offset_polygon_2d(
+            SQUARE, d, join_style=JoinStyle.ROUND,
+            arc_segment_angle=math.pi / 24,
+        )[0]
+        for v in result:
+            dist = _min_distance_to_polygon(v, [Vec2(p) for p in SQUARE])
+            assert abs(dist - d) < 1e-6
